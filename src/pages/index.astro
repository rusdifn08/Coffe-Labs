---
import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TrustBarSection from '../components/sections/TrustBarSection.astro';
import ProblemSolutionSection from '../components/sections/ProblemSolutionSection.astro';
import FeatureBentoSection from '../components/sections/FeatureBentoSection.astro';
import AppTourSection from '../components/sections/AppTourSection.astro';
import GuidedBrewSection from '../components/sections/GuidedBrewSection.astro';
import BrewDoctorSection from '../components/sections/BrewDoctorSection.astro';
import ToolkitSection from '../components/sections/ToolkitSection.astro';
import RecipeLibrarySection from '../components/sections/RecipeLibrarySection.astro';
import CommunitySection from '../components/sections/CommunitySection.astro';
import ComparisonSection from '../components/sections/ComparisonSection.astro';
import PricingSection from '../components/sections/PricingSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import FooterSection from '../components/sections/FooterSection.astro';
import { landingData } from '../data/landingData';

const pageTitle = "Coffee Labs — Specialty Coffee Brewing Labs & Panduan Seduh Presisi";
const pageDesc = "200+ resep seduh dari 100+ barista dunia, Guided Brew timer presisi, koreksi rasa Brew Doctor, cupping SCA & katalog 50 roastery. Multi-platform untuk iOS, Android & Web.";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://coffeelabs.app/" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content="/icon.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDesc} />
    <meta property="twitter:image" content="/icon.png" />

    <!-- Schema.org SoftwareApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Coffee Labs",
      "operatingSystem": "Android, iOS, Web",
      "applicationCategory": "LifestyleApplication",
      "description": pageDesc,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "128"
      }
    })} />
  </head>
  
  <body class="bg-[#F9F6F0] text-[#332B25] antialiased selection:bg-[#ECA400] selection:text-[#1E1612]">
    <!-- 0. Sticky Navbar -->
    <Navbar />

    <main id="main-content">
      <!-- 1. Hero Section with Real Phone Mockup -->
      <HeroSection />

      <!-- 2. Trust Bar & Stats Strip -->
      <TrustBarSection />

      <!-- 3. Problem vs Solution (Compact & Professional) -->
      <ProblemSolutionSection />

      <!-- 4. Feature Bento Grid (Simplified Header & Phone Mockup for Social Coffee) -->
      <FeatureBentoSection />

      <!-- 5. Interactive App Tour (5 tabs with exact 2-column mobile recipe grid) -->
      <AppTourSection />

      <!-- 6. Guided Brew Deep-Dive -->
      <GuidedBrewSection />

      <!-- 7. Brew Doctor & Sensory Evaluation (Dark section) -->
      <BrewDoctorSection />

      <!-- 8. Barista Toolkit — Professional Suite -->
      <ToolkitSection />

      <!-- 9. Recipe Library & Barista Spotlight -->
      <RecipeLibrarySection />

      <!-- 10. Social Coffee & Basecamp -->
      <CommunitySection />

      <!-- 11. Comparison Table -->
      <ComparisonSection />

      <!-- 12. Pricing Section (Dark section) -->
      <PricingSection />

      <!-- 14. Testimonials -->
      <TestimonialsSection />

      <!-- 15. FAQ Accordion -->
      <FaqSection />

      <!-- 16. Final CTA & QR Download -->
      <FinalCtaSection />
    </main>

    <!-- 17. Footer -->
    <FooterSection />
  </body>
</html>
