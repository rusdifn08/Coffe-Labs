---
import '../styles/global.css';
import { landingData } from '../data/landingData';

const apkDownloadUrl = landingData.brand.downloadAndroid;
const pageTitle = 'Live Brewing 2.0 — Coffee Labs Real-Time 1:1 Mirror';
const pageDesc =
  'Pantau proses pemilihan resep, profil biji kopi, progres pesanan POS, dan timer seduh NTP 1:1 secara real-time langsung dari Brew Bar Coffee Labs.';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <style>
      :root {
        --brand-bg: #12100e;
        --brand-surface: #1c1714;
        --brand-accent: #d4a373;
        --brand-text: #f9f5ee;
      }
      @keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.45; transform: scale(1.25); }
      }
      @keyframes floatParticle {
        0% { opacity: 1; transform: translateY(0) scale(0.95); }
        100% { opacity: 0; transform: translateY(-90px) scale(1.3); }
      }
      .live-dot { animation: pulseDot 1.3s ease-in-out infinite; }
      .cheer-particle {
        position: fixed;
        z-index: 60;
        pointer-events: none;
        font-size: 26px;
        animation: floatParticle 1.15s ease-out forwards;
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#12100E] text-[#F9F5EE] antialiased selection:bg-[#D4A373] selection:text-[#12100E]">
    <!-- High-Contrast Obsidian Header -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#12100E]/95 backdrop-blur-lg">
      <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2.5 shrink-0">
          <img id="header-cafe-logo" src="/icon.png" alt="Coffee Labs" class="w-8 h-8 rounded-lg object-contain" />
          <div class="leading-tight">
            <span id="header-brand-title" class="font-extrabold text-sm sm:text-base tracking-tight text-[#F9F5EE]">
              Coffee <span style="color: var(--brand-accent)">Labs</span>
            </span>
            <span id="header-brand-sub" class="block text-[10px] font-bold tracking-[0.16em] uppercase" style="color: var(--brand-accent)">
              LIVE BREWING 2.0 • 1:1 REAL-TIME
            </span>
          </div>
        </a>

        <div class="flex items-center gap-2">
          <span
            id="conn-badge"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-white/5 border border-white/15 text-[#F9F5EE]"
          >
            <span id="conn-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span id="conn-label">SIAP</span>
          </span>
          <a
            id="open-app-header"
            href="coffeelabs://livebrew"
            class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold text-[#12100E] transition hover:opacity-90"
            style="background: var(--brand-accent)"
          >
            Buka di Aplikasi
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-6 sm:py-8 space-y-5">
      <!-- 1. Entry / Lookup Card (Saat URL belum memuat kode atau meja) -->
      <section
        id="lookup-card"
        class="rounded-3xl bg-[#1C1714] border border-[#D4A373]/30 p-6 sm:p-8 shadow-2xl space-y-5"
      >
        <div class="space-y-2">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-[#D4A373]/15 text-[#D4A373]">
            Zero Simulation • 100% Real-Time NTP Mirror
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-[#F9F5EE] tracking-tight">
            Lacak Seduhan Barista Secara Langsung (1:1)
          </h1>
          <p class="text-sm text-[#CBBFB2] leading-relaxed">
            Masukkan kode siaran 13-digit dari barista atau slug meja kafe bisnis Anda (contoh:
            <code class="px-1.5 py-0.5 rounded bg-black/40 text-[#D4A373]">kopi-senja/meja-04</code>)
            untuk menyambung ke sesi seduh nyata secara instan.
          </p>
        </div>

        <form id="jump-form" class="flex flex-col sm:flex-row gap-3">
          <input
            id="target-input"
            type="text"
            autocomplete="off"
            placeholder="Kode 13 digit (7...) atau cafe-slug/meja-04"
            class="flex-1 rounded-2xl bg-[#12100E] border border-[#D4A373]/35 px-4 py-3.5 text-sm text-[#F9F5EE] placeholder-[#9C8F82] focus:outline-none focus:border-[#D4A373]"
          />
          <button
            type="submit"
            class="px-6 py-3.5 rounded-2xl font-extrabold text-sm text-[#12100E] transition hover:opacity-90 cursor-pointer shrink-0"
            style="background: var(--brand-accent)"
          >
            Hubungkan Live Mirror
          </button>
        </form>

        <div id="lookup-error" class="hidden rounded-2xl bg-red-950/50 border border-red-500/40 px-4 py-3 text-xs text-red-200 font-semibold"></div>
      </section>

      <!-- 2. Loading State -->
      <section
        id="loading-card"
        class="hidden rounded-3xl bg-[#1C1714] border border-[#D4A373]/30 p-8 text-center space-y-3"
      >
        <div class="w-10 h-10 mx-auto rounded-full border-4 border-[#D4A373]/30 border-t-[#D4A373] animate-spin"></div>
        <p class="text-sm font-bold text-[#F9F5EE]">
          Menghubungkan ke Studio Barista &amp; Kalibrasi Jam NTP (&lt; 25ms)...
        </p>
      </section>

      <!-- 3. Real-Time Live Mirror Dashboard -->
      <div id="live-shell" class="hidden space-y-5">
        <!-- Custom Cafe Branding & Seat Banner -->
        <section
          id="branding-card"
          class="rounded-3xl bg-[#1C1714] border p-5 sm:p-6 space-y-4 shadow-xl"
          style="border-color: color-mix(in srgb, var(--brand-accent) 40%, transparent)"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 id="cafe-name" class="text-xl sm:text-2xl font-black text-[#F9F5EE] truncate">
                  Coffee Labs Brew Bar
                </h2>
                <span
                  id="seat-pill"
                  class="hidden px-2.5 py-0.5 rounded-full text-[11px] font-extrabold text-[#12100E]"
                  style="background: var(--brand-accent)"
                ></span>
              </div>
              <p id="cafe-welcome" class="text-xs sm:text-sm text-[#CBBFB2] mt-1">
                Selamat menikmati seduhan segar kami! Seluruh proses seduhan tersinkronisasi 1:1 di layar ini.
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                id="change-target-btn"
                type="button"
                class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-xs font-bold text-[#F9F5EE] cursor-pointer"
              >
                Ganti Kode / Meja
              </button>
            </div>
          </div>

          <!-- 1-Tap Copy Wi-Fi Bar (Business Cafe) -->
          <div
            id="wifi-bar"
            class="hidden flex items-center justify-between gap-3 rounded-2xl bg-[#12100E] border border-white/10 px-4 py-2.5"
          >
            <div class="text-xs text-[#F9F5EE] truncate">
              <span class="font-extrabold" style="color: var(--brand-accent)">Wi-Fi Kafe:</span>
              <span id="wifi-text" class="ml-1 font-semibold"></span>
            </div>
            <button
              id="copy-wifi-btn"
              type="button"
              class="px-3 py-1 rounded-lg text-[11px] font-extrabold text-[#12100E] shrink-0 cursor-pointer"
              style="background: var(--brand-accent)"
            >
              Salin Sandi
            </button>
          </div>
        </section>

        <!-- Business POS Order Progress Stepper -->
        <section
          id="pos-order-card"
          class="hidden rounded-3xl bg-[#1C1714] border border-white/10 p-5 space-y-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-widest" style="color: var(--brand-accent)">
                SINKRONISASI KASIR POS BISNIS
              </span>
              <h3 id="pos-order-title" class="text-base font-black text-[#F9F5EE]"></h3>
              <p id="pos-order-items" class="text-xs text-[#CBBFB2]"></p>
            </div>
            <span
              id="pos-queue-pill"
              class="hidden px-3 py-1 rounded-full text-xs font-extrabold bg-[#D4A373]/15 text-[#D4A373]"
            ></span>
          </div>

          <div class="grid grid-cols-4 gap-2 text-center" id="pos-stepper">
            <div data-pos-step="0" class="rounded-xl p-2 bg-[#12100E] border border-white/10 text-[11px] font-bold text-[#9C8F82]">1. Masuk POS</div>
            <div data-pos-step="1" class="rounded-xl p-2 bg-[#12100E] border border-white/10 text-[11px] font-bold text-[#9C8F82]">2. Pilih Resep</div>
            <div data-pos-step="2" class="rounded-xl p-2 bg-[#12100E] border border-white/10 text-[11px] font-bold text-[#9C8F82]">3. Diseduh</div>
            <div data-pos-step="3" class="rounded-xl p-2 bg-[#12100E] border border-white/10 text-[11px] font-bold text-[#9C8F82]">4. Disajikan</div>
          </div>
        </section>

        <!-- Real Branded Idle State (Saat Meja Aktif Tetapi Barista Belum Mulai Seduh) -->
        <section
          id="idle-waiting-card"
          class="hidden rounded-3xl bg-[#1C1714] border border-white/10 p-7 text-center space-y-3"
        >
          <div class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center bg-[#D4A373]/15 border border-[#D4A373]/40 text-2xl">
            ☕
          </div>
          <h3 id="idle-title" class="text-lg font-black text-[#F9F5EE]">
            Meja Terhubung Real-Time — Menunggu Barista
          </h3>
          <p class="text-sm text-[#CBBFB2] max-w-lg mx-auto leading-relaxed">
            Halaman ini mendengarkan server Coffee Labs secara langsung. Begitu barista memilih metode seduh, menimbang biji kopi, dan menyalakan timer, layar ini langsung berubah otomatis 1:1 tanpa perlu refresh.
          </p>
        </section>

        <!-- Active 1:1 Mirror Grid -->
        <div id="active-mirror-grid" class="hidden grid grid-cols-1 md:grid-cols-12 gap-5">
          <!-- Left: 60fps NTP Circular Timer + Telemetry -->
          <section class="md:col-span-5 rounded-3xl bg-[#1C1714] border border-white/10 p-6 flex flex-col items-center justify-between space-y-5">
            <div class="w-full flex items-center justify-between gap-2 text-[11px]">
              <span
                id="phase-pill"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-extrabold bg-[#D4A373]/15 text-[#F9F5EE]"
              >
                <span class="w-2 h-2 rounded-full bg-red-500 live-dot"></span>
                <span id="phase-label">Menyiapkan Seduhan</span>
              </span>
              <span id="ntp-meta" class="font-mono text-[10px] text-[#9C8F82]">v1 • NTP 0ms</span>
            </div>

            <!-- 60fps SVG Circular Brew Timer -->
            <div class="relative w-48 h-48 flex items-center justify-center">
              <svg class="w-48 h-48 -rotate-90" viewBox="0 0 180 180">
                <circle cx="90" cy="90" r="78" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="11" />
                <circle
                  id="timer-arc"
                  cx="90"
                  cy="90"
                  r="78"
                  fill="none"
                  stroke="#D4A373"
                  stroke-width="11"
                  stroke-linecap="round"
                  stroke-dasharray="490.09"
                  stroke-dashoffset="490.09"
                />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <div class="flex items-baseline font-black text-[#F9F5EE] tabular-nums">
                  <span id="timer-mmss" class="text-4xl tracking-tight">00:00</span>
                  <span id="timer-tenth" class="text-lg ml-0.5" style="color: var(--brand-accent)">.0</span>
                </div>
                <span id="timer-target" class="text-[11px] font-bold text-[#9C8F82] mt-1">Target 02:30</span>
              </div>
            </div>

            <!-- Live Scale & Extraction Telemetry -->
            <div class="w-full grid grid-cols-3 gap-2">
              <div class="rounded-2xl bg-[#12100E] p-3 text-center border border-white/5">
                <span class="block text-[10px] font-bold text-[#9C8F82] uppercase">Berat</span>
                <strong id="metric-weight" class="text-base font-black text-[#F9F5EE] tabular-nums">0.0 g</strong>
              </div>
              <div class="rounded-2xl bg-[#12100E] p-3 text-center border border-white/5">
                <span class="block text-[10px] font-bold text-[#9C8F82] uppercase">Aliran</span>
                <strong id="metric-flow" class="text-base font-black text-[#F9F5EE] tabular-nums">0.0 ml/s</strong>
              </div>
              <div class="rounded-2xl bg-[#12100E] p-3 text-center border border-white/5">
                <span class="block text-[10px] font-bold text-[#9C8F82] uppercase">Suhu</span>
                <strong id="metric-temp" class="text-base font-black text-[#F9F5EE] tabular-nums">91°C</strong>
              </div>
            </div>

            <!-- Cheer Bar -->
            <div class="w-full flex items-center justify-between gap-3 pt-2 border-t border-white/10">
              <div class="min-w-0">
                <p id="brewer-name" class="text-xs font-extrabold text-[#F9F5EE] truncate">Barista Coffee Labs</p>
                <p id="viewers-cheers" class="text-[11px] text-[#9C8F82]">1 penonton • 0 apresiasi</p>
              </div>
              <button
                id="cheer-btn"
                type="button"
                class="px-3.5 py-2 rounded-xl text-xs font-black text-[#12100E] shrink-0 cursor-pointer transition active:scale-95"
                style="background: var(--brand-accent)"
              >
                👏 Semangat!
              </button>
            </div>
          </section>

          <!-- Right: Live Recipe Picker Mirror + Live Bean Passport -->
          <div class="md:col-span-7 space-y-5">
            <!-- Recipe Card -->
            <section class="rounded-3xl bg-[#1C1714] border border-white/10 p-5 space-y-3">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-extrabold text-[#F9F5EE]">Resep &amp; Tahapan Barista</h3>
                <span
                  id="method-badge"
                  class="px-2.5 py-0.5 rounded-lg text-[11px] font-extrabold bg-[#D4A373]/15 text-[#D4A373]"
                >
                  Menunggu Resep
                </span>
              </div>
              <p id="recipe-title" class="text-lg font-black text-[#F9F5EE]">
                Barista sedang memilih resep terbaik...
              </p>
              <div id="recipe-specs" class="flex flex-wrap gap-2 text-[11px]"></div>
              <div id="recipe-steps" class="space-y-1.5 pt-1"></div>
            </section>

            <!-- Bean Passport Card -->
            <section id="bean-card" class="rounded-3xl bg-[#1C1714] border border-white/10 p-5 space-y-3">
              <h3 class="text-sm font-extrabold text-[#F9F5EE]">Profil Biji Kopi (Live Bean Passport)</h3>
              <p id="bean-name" class="text-base font-black text-[#F9F5EE]">
                Menunggu barista memilih biji kopi...
              </p>
              <p id="bean-sub" class="text-xs font-bold" style="color: var(--brand-accent)"></p>
              <div id="bean-notes" class="flex flex-wrap gap-1.5"></div>
            </section>
          </div>
        </div>

        <!-- Digital Cup Passport (Muncul saat SERVING_READY_PASSPORT) -->
        <section
          id="passport-card"
          class="hidden rounded-3xl bg-gradient-to-br from-[#1C2A1B] to-[#1C1714] border border-emerald-500/50 p-6 space-y-4"
        >
          <div>
            <span class="text-[11px] font-extrabold tracking-widest uppercase text-emerald-400">
              DIGITAL CUP PASSPORT RESMI
            </span>
            <h2 class="text-2xl font-black text-[#F9F5EE] mt-0.5">
              Kopi Anda Siap Disajikan!
            </h2>
            <p id="passport-summary" class="text-sm text-[#CBBFB2] mt-1"></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              id="passport-deeplink"
              href="coffeelabs://livebrew"
              class="px-5 py-3 rounded-xl bg-emerald-400 text-[#0B160C] font-extrabold text-xs sm:text-sm hover:opacity-90 transition"
            >
              Buka di Aplikasi Coffee Labs
            </a>
            <a
              href={apkDownloadUrl}
              class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/20 text-[#F9F5EE] font-extrabold text-xs sm:text-sm transition"
            >
              Download Aplikasi Coffee Labs (Android)
            </a>
          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      (() => {
        const CIRCUMFERENCE = 2 * Math.PI * 78;
        const params = new URLSearchParams(window.location.search);
        const queryApi = params.get('api');
        if (queryApi) localStorage.setItem('coffeelabs_api_base', queryApi.replace(/\/$/, ''));
        const apiBase =
          queryApi ||
          localStorage.getItem('coffeelabs_api_base') ||
          (window.location.hostname === 'localhost' && params.get('local') === '1'
            ? 'http://127.0.0.1:3000'
            : 'https://coffe-labs-backend.onrender.com');
        const wsBase = apiBase.startsWith('https://')
          ? apiBase.replace(/^https:\/\//, 'wss://')
          : apiBase.replace(/^http:\/\//, 'ws://');

        const $ = (id) => document.getElementById(id);

        let currentTarget = null; // { kind: 'branded', cafe, seat, key } | { kind: 'code', code, key }
        let currentResolution = null;
        let currentSnap = null;
        let clockOffsetMs = 0;
        let bestRttMs = Number.MAX_SAFE_INTEGER;
        let appliedVersion = -1;
        let ws = null;
        let es = null;
        let rafId = null;

        function parseRawInput(raw) {
          const text = (raw || '').trim();
          if (!text) return null;
          try {
            if (/^(https?:|coffeelabs:)/i.test(text)) {
              const u = new URL(text);
              const segs = u.pathname.split('/').filter(Boolean);
              if (u.protocol === 'coffeelabs:' && u.hostname === 'livebrew') {
                if (segs.length >= 2) {
                  return { kind: 'branded', cafe: segs[0].toLowerCase(), seat: segs[1].toLowerCase(), key: `${segs[0].toLowerCase()}__${segs[1].toLowerCase()}` };
                }
                if (segs.length === 1) return { kind: 'code', code: segs[0], key: segs[0] };
              }
              const idx = segs.indexOf('livebrew');
              if (idx >= 0) {
                const rest = segs.slice(idx + 1);
                if (rest.length >= 2) {
                  return { kind: 'branded', cafe: rest[0].toLowerCase(), seat: rest[1].toLowerCase(), key: `${rest[0].toLowerCase()}__${rest[1].toLowerCase()}` };
                }
                if (rest.length === 1) return { kind: 'code', code: rest[0], key: rest[0] };
              }
            }
          } catch (_) {}

          if (text.includes('/')) {
            const parts = text.split('/').map((s) => s.trim()).filter(Boolean);
            if (parts.length >= 2) {
              const cafe = parts[parts.length - 2].toLowerCase();
              const seat = parts[parts.length - 1].toLowerCase();
              return { kind: 'branded', cafe, seat, key: `${cafe}__${seat}` };
            }
          }
          return { kind: 'code', code: text, key: text };
        }

        function parseFromPathname() {
          const segs = window.location.pathname.split('/').filter(Boolean);
          const idx = segs.indexOf('livebrew');
          if (idx >= 0) {
            const rest = segs.slice(idx + 1);
            if (rest.length >= 2) {
              const cafe = decodeURIComponent(rest[0]).toLowerCase();
              const seat = decodeURIComponent(rest[1]).toLowerCase();
              return { kind: 'branded', cafe, seat, key: `${cafe}__${seat}` };
            }
            if (rest.length === 1) {
              const code = decodeURIComponent(rest[0]);
              return { kind: 'code', code, key: code };
            }
          }
          const qCode = params.get('code');
          if (qCode) return parseRawInput(qCode);
          return null;
        }

        function setConnBadge(label, colorClass) {
          $('conn-label').textContent = label;
          $('conn-dot').className = `w-2 h-2 rounded-full ${colorClass}`;
        }

        function formatMmSs(ms) {
          const totalSec = Math.max(0, Math.floor(ms / 1000));
          const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
          const s = String(totalSec % 60).padStart(2, '0');
          return `${m}:${s}`;
        }

        function computeElapsedMs(snap) {
          if (!snap) return 0;
          const acc = Number(snap.timer_accumulated_ms || 0);
          if (String(snap.timer_status || '').toUpperCase() === 'RUNNING' && snap.timer_anchor_server_ms) {
            const serverNow = Date.now() + clockOffsetMs;
            return Math.max(0, acc + Math.max(0, serverNow - Number(snap.timer_anchor_server_ms)));
          }
          return Math.max(0, acc);
        }

        function targetDurationSec(snap) {
          const rec = snap && snap.recipe_snapshot_json ? snap.recipe_snapshot_json : {};
          if (rec.totalTimeSeconds && Number(rec.totalTimeSeconds) > 0) return Number(rec.totalTimeSeconds);
          if (Array.isArray(rec.steps) && rec.steps.length > 0) {
            const sum = rec.steps.reduce((a, s) => a + Number(s.durationSeconds || s.duration || 30), 0);
            if (sum > 0) return sum;
          }
          return 150;
        }

        function tickTimerFrame() {
          if (!currentSnap) return;
          const elapsedMs = computeElapsedMs(currentSnap);
          const targetMs = Math.max(1000, targetDurationSec(currentSnap) * 1000);
          const progress = Math.min(1, Math.max(0, elapsedMs / targetMs));
          $('timer-mmss').textContent = formatMmSs(elapsedMs);
          $('timer-tenth').textContent = `.${Math.floor((elapsedMs % 1000) / 100)}`;
          $('timer-target').textContent = `Target ${formatMmSs(targetMs)}`;
          $('timer-arc').setAttribute('stroke-dashoffset', String(CIRCUMFERENCE * (1 - progress)));
          if (String(currentSnap.timer_status || '').toUpperCase() === 'RUNNING') {
            rafId = requestAnimationFrame(tickTimerFrame);
          } else {
            rafId = null;
          }
        }

        function ensureTimerLoop() {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(tickTimerFrame);
        }

        async function calibrateNtp() {
          bestRttMs = Number.MAX_SAFE_INTEGER;
          for (let i = 0; i < 3; i++) {
            const t1 = Date.now();
            try {
              const res = await fetch(`${apiBase}/api/v1/livebrew/ntp?client_send_ms=${t1}`);
              if (!res.ok) continue;
              const body = await res.json();
              const d = body && body.data ? body.data : null;
              if (!d) continue;
              const t4 = Date.now();
              const t2 = Number(d.server_recv_ms || t1);
              const t3 = Number(d.server_send_ms || t2);
              const rtt = Math.max(0, (t4 - t1) - (t3 - t2));
              if (rtt < bestRttMs) {
                bestRttMs = rtt;
                clockOffsetMs = Math.round(((t2 - t1) + (t3 - t4)) / 2);
              }
            } catch (_) {}
          }
        }

        function applyBranding(branding, seat) {
          const accent = (branding && branding.accent_color_hex) || '#D4A373';
          document.documentElement.style.setProperty('--brand-accent', accent);
          $('timer-arc').setAttribute('stroke', accent);

          if (branding && branding.cafe_display_name) {
            $('cafe-name').textContent = branding.cafe_display_name;
            $('header-brand-title').textContent = branding.cafe_display_name;
          } else if (currentSnap && currentSnap.brewer_display_name) {
            $('cafe-name').textContent = `Studio Seduh ${currentSnap.brewer_display_name}`;
          }

          if (branding && branding.logo_cloudinary_url) {
            $('header-cafe-logo').src = branding.logo_cloudinary_url;
          }
          if (branding && branding.welcome_message) {
            $('cafe-welcome').textContent = branding.welcome_message;
          }

          if (seat && seat.seat_label) {
            $('seat-pill').textContent = `${seat.seat_label} • ${seat.zone_area || 'Main Area'}`;
            $('seat-pill').classList.remove('hidden');
            $('idle-title').textContent = `${seat.seat_label} Terhubung Real-Time — Menunggu Barista`;
          } else {
            $('seat-pill').classList.add('hidden');
          }

          if (branding && branding.wifi_ssid) {
            const pass = branding.wifi_password || '';
            $('wifi-text').textContent = pass ? `${branding.wifi_ssid} • Sandi: ${pass}` : branding.wifi_ssid;
            $('wifi-bar').classList.remove('hidden');
            $('copy-wifi-btn').onclick = () => {
              if (pass && navigator.clipboard) {
                navigator.clipboard.writeText(pass);
                $('copy-wifi-btn').textContent = 'Tersalin!';
                setTimeout(() => ($('copy-wifi-btn').textContent = 'Salin Sandi'), 1800);
              }
            };
          } else {
            $('wifi-bar').classList.add('hidden');
          }
        }

        function renderPosProgress(pos, snap, branding) {
          if (!pos && !(snap && snap.pos_order_number)) {
            $('pos-order-card').classList.add('hidden');
            return;
          }
          $('pos-order-card').classList.remove('hidden');
          const orderNo = (pos && pos.pos_order_number) || (snap && snap.pos_order_number) || '';
          const customer = (pos && pos.customer_name) || (snap && snap.customer_name) || 'Pelanggan';
          $('pos-order-title').textContent = `Pesanan ${orderNo} • ${customer}`;
          $('pos-order-items').textContent = (pos && pos.items_summary) || 'Specialty Handcrafted Coffee';

          if (branding?.show_pos_queue_position !== false && pos && Number(pos.queue_position_ahead || 0) > 0) {
            $('pos-queue-pill').textContent = `Antrean #${pos.queue_position_ahead}`;
            $('pos-queue-pill').classList.remove('hidden');
          } else {
            $('pos-queue-pill').classList.add('hidden');
          }

          const phase = String(snap?.phase || '').toUpperCase();
          const st = String(pos?.pos_order_status || snap?.pos_order_status || 'QUEUED').toUpperCase();
          let activeIdx = 0;
          if (phase === 'SERVING_READY_PASSPORT' || st === 'SERVED' || st === 'READY') activeIdx = 3;
          else if (phase === 'BREWING_ACTIVE' || phase === 'BREWING_PAUSED' || st === 'BREWING') activeIdx = 2;
          else if (phase === 'BREWER_SELECTING_RECIPE' || phase === 'BREWER_SELECTING_BEAN' || phase === 'PRE_BREW_CALIBRATED') activeIdx = 1;

          document.querySelectorAll('#pos-stepper [data-pos-step]').forEach((el) => {
            const idx = Number(el.getAttribute('data-pos-step'));
            if (idx <= activeIdx) {
              el.style.background = 'var(--brand-accent)';
              el.style.color = '#12100E';
            } else {
              el.style.background = '#12100E';
              el.style.color = '#9C8F82';
            }
          });
        }

        function renderSnapshot(snap) {
          if (!snap) {
            $('idle-waiting-card').classList.remove('hidden');
            $('active-mirror-grid').classList.add('hidden');
            $('passport-card').classList.add('hidden');
            return;
          }

          const ver = Number(snap.state_version || 1);
          if (ver < appliedVersion) return;
          appliedVersion = ver;
          currentSnap = snap;

          $('idle-waiting-card').classList.add('hidden');
          $('active-mirror-grid').classList.remove('hidden');

          $('phase-label').textContent = snap.phase_label_id || snap.phase || 'Seduhan Aktif';
          $('ntp-meta').textContent = `v${ver} • NTP ${clockOffsetMs >= 0 ? '+' : ''}${clockOffsetMs}ms`;
          $('metric-weight').textContent = `${Number(snap.current_weight_g || 0).toFixed(1)} g`;
          $('metric-flow').textContent = `${Number(snap.current_flow_rate_ml_s || 0).toFixed(1)} ml/s`;
          $('metric-temp').textContent = `${Math.round(Number(snap.current_temp_c || 91))}°C`;
          $('brewer-name').textContent = snap.brewer_display_name || 'Barista Coffee Labs';
          $('viewers-cheers').textContent = `${Number(snap.active_viewers_count || 1)} penonton • ${Number(snap.cheers_count || 0)} apresiasi`;

          // Recipe Card
          $('method-badge').textContent = snap.selected_method_name || 'Menunggu Metode';
          $('recipe-title').textContent = snap.selected_recipe_title || 'Barista sedang memilih resep terbaik...';
          const rec = snap.recipe_snapshot_json || {};
          const specs = [];
          if (rec.coffeeWeightGrams) specs.push(`Dosis ${rec.coffeeWeightGrams}g`);
          if (rec.totalWaterWeightGrams) specs.push(`Air ${rec.totalWaterWeightGrams}ml`);
          if (snap.current_temp_c) specs.push(`Suhu ${Math.round(snap.current_temp_c)}°C`);
          $('recipe-specs').innerHTML = specs
            .map((s) => `<span class="px-2.5 py-1 rounded-lg bg-[#12100E] border border-white/10 font-bold text-[#F9F5EE]">${s}</span>`)
            .join('');

          const steps = Array.isArray(rec.steps) ? rec.steps : [];
          const curIdx = Number(snap.current_step_index || 0);
          $('recipe-steps').innerHTML = steps
            .map((st, idx) => {
              const isAct = idx === curIdx && String(snap.phase).toUpperCase() === 'BREWING_ACTIVE';
              const isDone = idx < curIdx || String(snap.phase).toUpperCase() === 'SERVING_READY_PASSPORT';
              const title = st.title || st.name || `Tahap ${idx + 1}`;
              const dur = Number(st.durationSeconds || st.duration || 30);
              return `<div class="flex items-center justify-between gap-2 px-3 py-2 rounded-xl text-xs ${
                isAct ? 'bg-[#D4A373]/20 border border-[#D4A373] text-[#F9F5EE] font-extrabold' : 'bg-[#12100E] border border-white/5 text-[#CBBFB2]'
              }">
                <span class="truncate">${isDone ? '✓ ' : isAct ? '▶ ' : '• '}${title}</span>
                <span class="font-mono shrink-0" style="color: var(--brand-accent)">${dur}d</span>
              </div>`;
            })
            .join('');

          // Bean Passport Card
          const bean = snap.bean_snapshot_json || {};
          const beanName = bean.name || bean.bean_name || '';
          $('bean-name').textContent = beanName || 'Menunggu barista memilih biji kopi...';
          $('bean-sub').textContent = [bean.roastery || bean.roaster, bean.origin, bean.process]
            .filter(Boolean)
            .join(' • ');
          const rawNotes = bean.tasting_notes || bean.notes;
          const notes = Array.isArray(rawNotes)
            ? rawNotes
            : typeof rawNotes === 'string' && rawNotes.trim()
            ? rawNotes.split(',').map((s) => s.trim())
            : [];
          $('bean-notes').innerHTML = notes
            .slice(0, 6)
            .map((n) => `<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#D4A373]/15 text-[#F9F5EE]">${n}</span>`)
            .join('');

          // Digital Cup Passport
          if (String(snap.phase).toUpperCase() === 'SERVING_READY_PASSPORT') {
            $('passport-card').classList.remove('hidden');
            $('passport-summary').textContent = `Seduhan selesai dalam ${formatMmSs(Number(snap.timer_accumulated_ms || 0))} dengan berat akhir ${Number(snap.current_weight_g || 0).toFixed(1)} g oleh ${snap.brewer_display_name || 'Barista Coffee Labs'}.`;
          } else {
            $('passport-card').classList.add('hidden');
          }

          renderPosProgress(currentResolution?.pos_order_progress, snap, currentResolution?.branding);
          ensureTimerLoop();
        }

        function closeStreams() {
          if (ws) { try { ws.close(); } catch (_) {} ws = null; }
          if (es) { try { es.close(); } catch (_) {} es = null; }
        }

        function connectRealtimeStream(targetKey) {
          closeStreams();
          try {
            ws = new WebSocket(`${wsBase}/api/v1/livebrew/v2/stream/${encodeURIComponent(targetKey)}/ws`);
            ws.onopen = () => {
              setConnBadge('LIVE WS', 'bg-emerald-400 live-dot');
              ws.send(JSON.stringify({ cmd: 'NTP_PING', client_send_ms: Date.now() }));
            };
            ws.onmessage = (evt) => {
              try {
                const ev = JSON.parse(evt.data);
                if (ev.event === 'ntp_pong') {
                  const t4 = Date.now();
                  const t1 = Number(ev.client_send_ms || t4);
                  const t2 = Number(ev.server_recv_ms || t4);
                  const t3 = Number(ev.server_send_ms || t2);
                  clockOffsetMs = Math.round(((t2 - t1) + (t3 - t4)) / 2);
                } else if (ev.event === 'mirror_snapshot') {
                  renderSnapshot(ev);
                } else if (ev.event === 'cheer_burst' && currentSnap) {
                  currentSnap.cheers_count = Number(ev.total_cheers || currentSnap.cheers_count || 0);
                  $('viewers-cheers').textContent = `${Number(currentSnap.active_viewers_count || 1)} penonton • ${currentSnap.cheers_count} apresiasi`;
                } else if (ev.event === 'pos_order_updated') {
                  if (currentResolution) {
                    currentResolution.pos_order_progress = ev;
                    renderPosProgress(ev, currentSnap, currentResolution.branding);
                  }
                }
              } catch (_) {}
            };
            ws.onerror = () => connectSseFallback(targetKey);
            ws.onclose = () => {
              if (!es) setConnBadge('RECONNECT', 'bg-amber-400');
            };
          } catch (_) {
            connectSseFallback(targetKey);
          }
        }

        function connectSseFallback(targetKey) {
          if (es) return;
          try {
            es = new EventSource(`${apiBase}/api/v1/livebrew/v2/stream/${encodeURIComponent(targetKey)}/sse`);
            es.onopen = () => setConnBadge('LIVE SSE', 'bg-emerald-400 live-dot');
            es.onmessage = (evt) => {
              try {
                const ev = JSON.parse(evt.data);
                if (ev.event === 'mirror_snapshot') renderSnapshot(ev);
              } catch (_) {}
            };
          } catch (_) {}
        }

        async function loadTarget(target, pushUrl = false) {
          currentTarget = target;
          appliedVersion = -1;
          currentSnap = null;
          closeStreams();

          $('lookup-error').classList.add('hidden');
          $('lookup-card').classList.add('hidden');
          $('live-shell').classList.add('hidden');
          $('loading-card').classList.remove('hidden');
          setConnBadge('SYNC...', 'bg-amber-400 live-dot');

          const deepLink = target.kind === 'branded'
            ? `coffeelabs://livebrew/${target.cafe}/${target.seat}`
            : `coffeelabs://livebrew/${target.code}`;
          $('open-app-header').href = deepLink;
          $('passport-deeplink').href = deepLink;

          if (pushUrl) {
            const newPath = target.kind === 'branded'
              ? `/livebrew/${target.cafe}/${target.seat}`
              : `/livebrew/${target.code}`;
            window.history.replaceState({}, '', newPath);
          }

          await calibrateNtp();

          const endpoint = target.kind === 'branded'
            ? `${apiBase}/api/v1/livebrew/resolve/cafe/${encodeURIComponent(target.cafe)}/${encodeURIComponent(target.seat)}`
            : `${apiBase}/api/v1/livebrew/resolve/code/${encodeURIComponent(target.code)}`;

          try {
            const res = await fetch(endpoint);
            if (!res.ok) throw new Error('Sesi atau meja tidak ditemukan');
            const body = await res.json();
            const data = body && body.data ? body.data : null;
            if (!data) throw new Error('Respon server kosong');

            currentResolution = data;
            $('loading-card').classList.add('hidden');
            $('live-shell').classList.remove('hidden');

            applyBranding(data.branding, data.seat);
            renderPosProgress(data.pos_order_progress, data.active_brew_session, data.branding);
            renderSnapshot(data.active_brew_session || null);
            connectRealtimeStream(target.key);
          } catch (err) {
            $('loading-card').classList.add('hidden');
            $('lookup-card').classList.remove('hidden');
            $('lookup-error').textContent =
              'Kode atau meja Live Brew tidak ditemukan di server. Pastikan QR aktif atau barista sudah memulai siaran.';
            $('lookup-error').classList.remove('hidden');
            setConnBadge('OFFLINE', 'bg-red-500');
          }
        }

        $('jump-form').addEventListener('submit', (e) => {
          e.preventDefault();
          const parsed = parseRawInput($('target-input').value);
          if (!parsed) {
            $('lookup-error').textContent = 'Masukkan kode 13 digit atau slug cafe/meja yang valid.';
            $('lookup-error').classList.remove('hidden');
            return;
          }
          loadTarget(parsed, true);
        });

        $('change-target-btn').addEventListener('click', () => {
          closeStreams();
          $('live-shell').classList.add('hidden');
          $('lookup-card').classList.remove('hidden');
        });

        $('cheer-btn').addEventListener('click', async (ev) => {
          if (!currentTarget) return;
          const p = document.createElement('span');
          p.className = 'cheer-particle';
          p.textContent = '☕';
          p.style.left = `${ev.clientX}px`;
          p.style.top = `${ev.clientY}px`;
          document.body.appendChild(p);
          setTimeout(() => p.remove(), 1200);
          try {
            const key = currentSnap?.share_code || currentTarget.key;
            await fetch(`${apiBase}/api/v1/livebrew/v2/${encodeURIComponent(key)}/cheer`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ cheer_kind: 'clap' }),
            });
          } catch (_) {}
        });

        const initial = parseFromPathname();
        if (initial) {
          loadTarget(initial, false);
        }
      })();
    </script>
  </body>
</html>
