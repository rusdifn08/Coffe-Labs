---
import '../styles/global.css';
import { landingData } from '../data/landingData';

const apkDownloadUrl = landingData.brand.downloadAndroid;
const pageTitle = 'Live Brew — Coffee Labs';
const pageDesc = 'Pantau seduhan barista Coffee Labs secara langsung 1:1.';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <style>
      @keyframes liveBreathe {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
          box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.55);
        }
        50% {
          opacity: 0.35;
          transform: scale(0.86);
          box-shadow: 0 0 0 6px rgba(22, 163, 74, 0);
        }
      }
      @keyframes floatReaction {
        0% { opacity: 1; transform: translateY(0) scale(0.9); }
        65% { opacity: 0.95; transform: translateY(-76px) scale(1.25); }
        100% { opacity: 0; transform: translateY(-120px) scale(1.05); }
      }
      .live-breathe {
        animation: liveBreathe 1.55s ease-in-out infinite;
      }
      .reaction-particle {
        position: fixed;
        z-index: 60;
        pointer-events: none;
        font-size: 28px;
        animation: floatReaction 1.15s ease-out forwards;
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#FAF3E8] text-[#2C1810] antialiased selection:bg-[#5D3A1A] selection:text-white">
    <!-- Slim Mobile-Style Header -->
    <header class="sticky top-0 z-40 border-b border-[#E7DDD3] bg-[#FAF3E8]/95 backdrop-blur-md">
      <div class="max-w-md mx-auto px-4 h-13 flex items-center justify-between gap-2.5">
        <a href="/" class="flex items-center gap-2 min-w-0">
          <img id="header-cafe-logo" src="/icon.png" alt="Coffee Labs" class="w-7 h-7 rounded-lg object-contain bg-white p-0.5 border border-[#E7DDD3] shrink-0" />
          <div class="min-w-0 leading-tight">
            <h1 id="header-title" class="font-extrabold text-[14px] text-[#2C1810] truncate">
              Coffee Labs
            </h1>
            <p id="header-sub" class="text-[10px] font-semibold text-[#78665A] truncate">
              Live Brew
            </p>
          </div>
        </a>

        <div class="flex items-center gap-2.5 shrink-0">
          <!-- Small Glowing Green Live Dot ONLY (no wordy pill) -->
          <span
            id="live-dot-wrap"
            title="Status Siaran"
            class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-white border border-[#E7DDD3]"
          >
            <span id="conn-dot" class="w-2.5 h-2.5 rounded-full bg-[#D97706]"></span>
          </span>

          <button
            id="change-target-btn"
            type="button"
            title="Ganti Kode / Meja"
            class="hidden w-7 h-7 rounded-lg bg-white border border-[#E7DDD3] text-[#5D3A1A] hover:bg-[#F3E8D8] flex items-center justify-center cursor-pointer transition text-xs font-bold"
          >
            ⇄
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-md mx-auto px-4 pt-3 pb-24 space-y-3">
      <!-- 1. Compact Lookup Card (Shown only if URL has no code/seat) -->
      <section
        id="lookup-card"
        class="rounded-2xl bg-white border border-[#E7DDD3] p-5 shadow-xs space-y-4 mt-4"
      >
        <div class="space-y-1">
          <h2 class="text-lg font-black text-[#2C1810]">Lacak Live Brew</h2>
          <p class="text-xs text-[#78665A]">
            Masukkan kode 13 digit atau slug meja (mis. <code class="px-1 py-0.5 rounded bg-[#FAF3E8] text-[#5D3A1A] font-semibold">kopi-senja/meja-01</code>).
          </p>
        </div>
        <form id="jump-form" class="space-y-2.5">
          <input
            id="target-input"
            type="text"
            autocomplete="off"
            placeholder="Kode Live Brew atau cafe/meja"
            class="w-full rounded-xl bg-[#FAF3E8] border border-[#E7DDD3] px-3.5 py-2.5 text-sm text-[#2C1810] placeholder-[#9C8B7E] focus:outline-none focus:border-[#5D3A1A] focus:bg-white"
          />
          <button
            type="submit"
            class="w-full py-2.5 rounded-xl font-extrabold text-sm text-white bg-[#5D3A1A] hover:bg-[#4A2E14] transition cursor-pointer"
          >
            Buka Live Brew
          </button>
        </form>
        <div id="lookup-error" class="hidden rounded-xl bg-[#FEF2F2] border border-[#FECACA] px-3 py-2 text-xs text-[#991B1B] font-semibold"></div>
      </section>

      <!-- 2. Compact Loading State -->
      <section
        id="loading-card"
        class="hidden rounded-2xl bg-white border border-[#E7DDD3] p-6 text-center space-y-2.5 mt-4"
      >
        <div class="w-8 h-8 mx-auto rounded-full border-3 border-[#E7DDD3] border-t-[#5D3A1A] animate-spin"></div>
        <p class="text-xs font-bold text-[#78665A]">Menghubungkan ke Barista...</p>
      </section>

      <!-- 3. Active Live Brew Mobile-Mirrored Shell -->
      <div id="live-shell" class="hidden space-y-3">
        <!-- Optional Seat & Wi-Fi Slim Bar (Business Cafe) -->
        <div id="cafe-meta-bar" class="hidden flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-white border border-[#E7DDD3] text-[11px]">
          <span id="seat-pill" class="font-extrabold text-[#5D3A1A] truncate"></span>
          <button id="copy-wifi-btn" type="button" class="hidden px-2.5 py-1 rounded-lg bg-[#FAF3E8] border border-[#E7DDD3] text-[#5D3A1A] font-bold text-[10.5px] shrink-0 cursor-pointer">
            📶 Salin Wi-Fi
          </button>
        </div>

        <!-- Optional Compact POS Order Stepper -->
        <section id="pos-order-card" class="hidden rounded-2xl bg-white border border-[#E7DDD3] px-3.5 py-2.5 space-y-2">
          <div class="flex items-center justify-between gap-2 text-[11px]">
            <span id="pos-order-title" class="font-extrabold text-[#2C1810] truncate"></span>
            <span id="pos-queue-pill" class="hidden px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-[#FEF3C7] text-[#92400E] shrink-0"></span>
          </div>
          <div class="grid grid-cols-4 gap-1.5 text-center" id="pos-stepper">
            <div data-pos-step="0" class="rounded-lg py-1 bg-[#FAF3E8] border border-[#E7DDD3] text-[10px] font-bold text-[#78665A]">POS</div>
            <div data-pos-step="1" class="rounded-lg py-1 bg-[#FAF3E8] border border-[#E7DDD3] text-[10px] font-bold text-[#78665A]">Resep</div>
            <div data-pos-step="2" class="rounded-lg py-1 bg-[#FAF3E8] border border-[#E7DDD3] text-[10px] font-bold text-[#78665A]">Seduh</div>
            <div data-pos-step="3" class="rounded-lg py-1 bg-[#FAF3E8] border border-[#E7DDD3] text-[10px] font-bold text-[#78665A]">Siap</div>
          </div>
        </section>

        <!-- Idle Waiting State -->
        <section
          id="idle-waiting-card"
          class="hidden rounded-2xl bg-white border border-[#E7DDD3] p-6 text-center space-y-2"
        >
          <div class="text-2xl">☕</div>
          <h3 id="idle-title" class="text-sm font-black text-[#2C1810]">Menunggu Barista Memulai Seduhan</h3>
          <p class="text-xs text-[#78665A]">Layar otomatis menampilkan timer & tahapan begitu seduhan dimulai.</p>
        </section>

        <!-- Mobile-Style Brew Spec Header Bar (Exact Mirror of BrewSpecHeaderBar) -->
        <div id="active-brew-body" class="hidden space-y-3">
          <section class="rounded-2xl bg-white border border-[#E7DDD3] px-3 py-2.5 shadow-2xs flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-[#5D3A1A]/10 text-[#5D3A1A] flex items-center justify-center shrink-0 text-sm">
              💧
            </div>
            <div class="min-w-0 flex-1">
              <p id="spec-bean-title" class="text-[13px] font-bold text-[#2C1810] truncate">
                Specialty Coffee
              </p>
              <p id="spec-details" class="text-[11px] font-medium text-[#78665A] truncate">
                15g : 225ml (1:15) · 92°C
              </p>
            </div>
            <span id="method-badge" class="px-2 py-0.5 rounded-lg bg-[#FAF3E8] border border-[#E7DDD3] text-[10.5px] font-extrabold text-[#5D3A1A] shrink-0">
              V60
            </span>
          </section>

          <!-- Centered Mobile-Style Segmented Circular Brew Timer -->
          <section class="py-1 flex flex-col items-center">
            <div class="relative w-[228px] h-[228px] flex items-center justify-center">
              <svg id="timer-svg" class="w-[228px] h-[228px] -rotate-90" viewBox="0 0 220 220">
                <g id="timer-bg-segments"></g>
                <g id="timer-fg-segments"></g>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-5">
                <span id="timer-mmss" class="text-[48px] leading-none font-black text-[#5D3A1A] tracking-tight tabular-nums">
                  00:00
                </span>
                <span id="timer-target" class="text-[12.5px] font-semibold text-[#78665A] mt-1.5">
                  Target 03:00 · 60g Air
                </span>
                <!-- Compact Live Scale Pill (only visible when real scale weight > 0) -->
                <span id="scale-live-pill" class="hidden mt-2 px-2.5 py-0.5 rounded-full bg-[#F0FDF4] border border-[#86EFAC] text-[11px] font-extrabold text-[#15803D] tabular-nums">
                  0.0 g • 0.0 g/s
                </span>
              </div>
            </div>
          </section>

          <!-- Compact Step-by-Step List (Mobile BrewStepTile style — NO instruction description!) -->
          <section id="recipe-steps" class="space-y-2"></section>

          <!-- Compact Finished Banner -->
          <section
            id="passport-card"
            class="hidden rounded-2xl bg-[#F0FDF4] border border-[#86EFAC] p-4 space-y-3"
          >
            <div class="flex items-center gap-2">
              <span class="text-lg">☕</span>
              <div>
                <h3 class="text-sm font-black text-[#14532D]">Kopi Siap Disajikan!</h3>
                <p id="passport-summary" class="text-[11.5px] text-[#166534]"></p>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                id="passport-deeplink"
                href="coffeelabs://livebrew"
                class="flex-1 text-center py-2 rounded-xl bg-[#16A34A] text-white font-extrabold text-xs hover:bg-[#15803D] transition"
              >
                Buka di Aplikasi
              </a>
              <a
                href={apkDownloadUrl}
                class="flex-1 text-center py-2 rounded-xl bg-white border border-[#BBF7D0] text-[#14532D] font-extrabold text-xs"
              >
                Unduh Android
              </a>
            </div>
          </section>
        </div>
      </div>
    </main>

    <!-- Compact Fixed Bottom Reaction Bar -->
    <div id="reaction-dock" class="hidden fixed bottom-0 inset-x-0 z-40 bg-[#FAF3E8]/95 backdrop-blur-md border-t border-[#E7DDD3]">
      <div class="max-w-md mx-auto px-4 py-2.5 flex items-center justify-between gap-2">
        <div class="min-w-0">
          <p id="brewer-name" class="text-xs font-extrabold text-[#2C1810] truncate">Barista</p>
          <p id="viewers-cheers" class="text-[10.5px] text-[#78665A] font-semibold">1 menonton • 0 reaksi</p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button data-react="clap" type="button" class="react-btn w-9 h-9 rounded-full bg-white border border-[#E7DDD3] hover:border-[#5D3A1A] active:scale-90 transition flex items-center justify-center text-base shadow-2xs cursor-pointer" title="Tepuk Tangan">👏</button>
          <button data-react="coffee" type="button" class="react-btn w-9 h-9 rounded-full bg-white border border-[#E7DDD3] hover:border-[#5D3A1A] active:scale-90 transition flex items-center justify-center text-base shadow-2xs cursor-pointer" title="Kopi Mantap">☕</button>
          <button data-react="fire" type="button" class="react-btn w-9 h-9 rounded-full bg-white border border-[#E7DDD3] hover:border-[#5D3A1A] active:scale-90 transition flex items-center justify-center text-base shadow-2xs cursor-pointer" title="Keren!">🔥</button>
          <button data-react="heart" type="button" class="react-btn w-9 h-9 rounded-full bg-white border border-[#E7DDD3] hover:border-[#5D3A1A] active:scale-90 transition flex items-center justify-center text-base shadow-2xs cursor-pointer" title="Suka">❤️</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const STEP_COLORS = ['#6495ED', '#6BAF7B', '#D98C5F', '#9B7EBD', '#E07A8C', '#4FB3B3'];
        const REACTION_EMOJI = { clap: '👏', coffee: '☕', fire: '🔥', heart: '❤️' };
        const RING_R = 92;
        const RING_C = 2 * Math.PI * RING_R;

        const params = new URLSearchParams(window.location.search);
        const queryApi = params.get('api');
        if (queryApi) localStorage.setItem('coffeelabs_api_base', queryApi.replace(/\/$/, ''));
        const cachedApi = localStorage.getItem('coffeelabs_api_base');
        const safeCachedApi =
          cachedApi && !cachedApi.toLowerCase().includes('onrender.com') ? cachedApi : null;
        if (cachedApi && !safeCachedApi) localStorage.removeItem('coffeelabs_api_base');

        const apiBase =
          queryApi ||
          safeCachedApi ||
          (window.location.hostname === 'localhost' && params.get('local') === '1'
            ? 'http://127.0.0.1:3000'
            : 'https://coffe-labs-backend-production.up.railway.app');
        const wsBase = apiBase.startsWith('https://')
          ? apiBase.replace(/^https:\/\//, 'wss://')
          : apiBase.replace(/^http:\/\//, 'ws://');

        const $ = (id) => document.getElementById(id);

        let currentTarget = null;
        let currentResolution = null;
        let currentSnap = null;
        let clockOffsetMs = 0;
        let bestRttMs = Number.MAX_SAFE_INTEGER;
        let appliedVersion = -1;
        let lastStepRenderKey = '';
        let ws = null;
        let es = null;
        let pollTimer = null;
        let reconnectTimer = null;
        let rafId = null;

        function parseRawInput(raw) {
          const text = (raw || '').trim();
          if (!text) return null;
          try {
            if (/^(https?:|coffeelabs:)/i.test(text)) {
              const u = new URL(text);
              const segs = u.pathname.split('/').filter(Boolean);
              if (u.protocol === 'coffeelabs:' && u.hostname === 'livebrew') {
                if (segs.length >= 2) return { kind: 'branded', cafe: segs[0].toLowerCase(), seat: segs[1].toLowerCase(), key: `${segs[0].toLowerCase()}__${segs[1].toLowerCase()}` };
                if (segs.length === 1) return { kind: 'code', code: segs[0], key: segs[0] };
              }
              const idx = segs.indexOf('livebrew');
              if (idx >= 0) {
                const rest = segs.slice(idx + 1);
                if (rest.length >= 2) return { kind: 'branded', cafe: rest[0].toLowerCase(), seat: rest[1].toLowerCase(), key: `${rest[0].toLowerCase()}__${rest[1].toLowerCase()}` };
                if (rest.length === 1) return { kind: 'code', code: rest[0], key: rest[0] };
              }
            }
          } catch (_) {}
          if (text.includes('/')) {
            const parts = text.split('/').map((s) => s.trim()).filter(Boolean);
            if (parts.length >= 2) {
              const cafe = parts[parts.length - 2].toLowerCase();
              const seat = parts[parts.length - 1].toLowerCase();
              return { kind: 'branded', cafe, seat, key: `${cafe}__${seat}` };
            }
          }
          return { kind: 'code', code: text, key: text };
        }

        function parseFromPathname() {
          const segs = window.location.pathname.split('/').filter(Boolean);
          const idx = segs.indexOf('livebrew');
          if (idx >= 0) {
            const rest = segs.slice(idx + 1);
            if (rest.length >= 2) {
              const cafe = decodeURIComponent(rest[0]).toLowerCase();
              const seat = decodeURIComponent(rest[1]).toLowerCase();
              return { kind: 'branded', cafe, seat, key: `${cafe}__${seat}` };
            }
            if (rest.length === 1) {
              const code = decodeURIComponent(rest[0]);
              return { kind: 'code', code, key: code };
            }
          }
          const qCode = params.get('code');
          if (qCode) return parseRawInput(qCode);
          return null;
        }

        function setLiveDotState(isLive) {
          const dot = $('conn-dot');
          if (isLive) {
            dot.className = 'w-2.5 h-2.5 rounded-full bg-[#16A34A] live-breathe';
          } else {
            dot.className = 'w-2.5 h-2.5 rounded-full bg-[#D97706]';
          }
        }

        function formatMmSs(totalSec) {
          const s = Math.max(0, Math.floor(totalSec));
          const m = String(Math.floor(s / 60)).padStart(2, '0');
          const r = String(s % 60).padStart(2, '0');
          return `${m}:${r}`;
        }

        function getNormalizedSteps(snap) {
          const rec = (snap && snap.recipe_snapshot_json) || {};
          const raw = Array.isArray(rec.steps) ? rec.steps : [];
          let runTime = 0;
          let runWater = 0;
          return raw.map((st, idx) => {
            const dur = Math.max(1, Number(st.durationSeconds || st.timeSeconds || st.duration || 30));
            const water = Math.max(0, Number(st.waterAddedGrams || st.waterGrams || 0));
            const startSec = runTime;
            runTime += dur;
            runWater += water;
            return {
              idx,
              title: String(st.title || st.name || `Tahap ${idx + 1}`),
              dur,
              water,
              startSec,
              endSec: runTime,
              cumWater: runWater,
              color: STEP_COLORS[idx % STEP_COLORS.length],
            };
          });
        }

        function getTotalDurationSec(snap, steps) {
          if (steps.length > 0) return steps[steps.length - 1].endSec;
          const rec = (snap && snap.recipe_snapshot_json) || {};
          return Math.max(1, Number(rec.totalTimeSeconds || 180));
        }

        function computeElapsedMs(snap) {
          if (!snap) return 0;
          const acc = Number(snap.timer_accumulated_ms || 0);
          if (String(snap.timer_status || '').toUpperCase() === 'RUNNING' && snap.timer_anchor_server_ms) {
            const serverNow = Date.now() + clockOffsetMs;
            return Math.max(0, acc + Math.max(0, serverNow - Number(snap.timer_anchor_server_ms)));
          }
          return Math.max(0, acc);
        }

        function renderSegmentedRing(steps, totalSec, elapsedSec) {
          const bgGroup = $('timer-bg-segments');
          const fgGroup = $('timer-fg-segments');
          const gap = steps.length > 1 ? 4 : 0;

          if (steps.length === 0) {
            const pct = Math.min(1, Math.max(0, elapsedSec / Math.max(1, totalSec)));
            bgGroup.innerHTML = `<circle cx="110" cy="110" r="${RING_R}" fill="none" stroke="#E7DDD3" stroke-width="14" />`;
            fgGroup.innerHTML = `<circle cx="110" cy="110" r="${RING_R}" fill="none" stroke="#5D3A1A" stroke-width="14" stroke-linecap="round" stroke-dasharray="${RING_C}" stroke-dashoffset="${RING_C * (1 - pct)}" />`;
            return;
          }

          let bgHtml = '';
          let fgHtml = '';
          for (const st of steps) {
            const segLen = Math.max(2, (st.dur / totalSec) * RING_C - gap);
            const startOffset = (st.startSec / totalSec) * RING_C;
            bgHtml += `<circle cx="110" cy="110" r="${RING_R}" fill="none" stroke="${st.color}" stroke-opacity="0.28" stroke-width="14" stroke-dasharray="${segLen} ${RING_C}" stroke-dashoffset="${-startOffset}" />`;

            const activeElapsedInSeg = Math.min(st.dur, Math.max(0, elapsedSec - st.startSec));
            if (activeElapsedInSeg > 0) {
              const fgLen = Math.max(1, (activeElapsedInSeg / st.dur) * segLen);
              fgHtml += `<circle cx="110" cy="110" r="${RING_R}" fill="none" stroke="${st.color}" stroke-width="14" stroke-dasharray="${fgLen} ${RING_C}" stroke-dashoffset="${-startOffset}" />`;
            }
          }
          bgGroup.innerHTML = bgHtml;
          fgGroup.innerHTML = fgHtml;
        }

        function renderStepCards(steps, activeIdx, elapsedSec, totalSec, isFinished) {
          const key = `${steps.length}:${activeIdx}:${isFinished ? 1 : 0}:${elapsedSec > 0 ? 1 : 0}`;
          if (key === lastStepRenderKey) return;
          lastStepRenderKey = key;

          $('recipe-steps').innerHTML = steps
            .map((st) => {
              const isDone = isFinished || (elapsedSec > 0 && st.idx < activeIdx);
              const isAct = !isFinished && st.idx === activeIdx && elapsedSec >= 0;
              const waterLine = st.water > 0
                ? `<p class="text-[11.5px] font-bold text-[#2563EB] mt-0.5">💧 +${st.water}g Air (Target: ${st.cumWater}g)</p>`
                : '';

              return `<div class="rounded-2xl bg-white px-3.5 py-2.5 border transition flex items-center gap-3 ${
                isAct
                  ? 'border-[#5D3A1A] shadow-xs ring-1 ring-[#5D3A1A]/15'
                  : isDone
                  ? 'border-[#BBF7D0] bg-[#F0FDF4]/60'
                  : 'border-[#E7DDD3]'
              }">
                <div class="w-8 h-8 rounded-full flex items-center justify-center font-extrabold text-xs shrink-0" style="background:${isDone ? '#16A34A' : st.color + '26'};color:${isDone ? '#fff' : st.color}">
                  ${isDone ? '✓' : st.idx + 1}
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[13.5px] font-extrabold text-[#2C1810] truncate">${st.title}</p>
                  ${waterLine}
                </div>
                <div class="text-right shrink-0 tabular-nums">
                  <p class="text-[13.5px] font-extrabold text-[#2C1810]">${formatMmSs(st.dur)}</p>
                  <p class="text-[10px] font-semibold text-[#78665A]">${formatMmSs(st.startSec)}–${formatMmSs(st.endSec)}</p>
                </div>
              </div>`;
            })
            .join('');
        }

        function tickTimerFrame() {
          if (!currentSnap) return;
          const steps = getNormalizedSteps(currentSnap);
          const totalSec = getTotalDurationSec(currentSnap, steps);
          const elapsedMs = computeElapsedMs(currentSnap);
          const elapsedSec = Math.min(totalSec, elapsedMs / 1000);
          const isFinished =
            String(currentSnap.phase || '').toUpperCase() === 'SERVING_READY_PASSPORT' ||
            String(currentSnap.timer_status || '').toUpperCase() === 'FINISHED';

          let activeIdx = Number(currentSnap.current_step_index || 0);
          if (steps.length > 0 && elapsedSec > 0) {
            const found = steps.findIndex((s) => elapsedSec < s.endSec);
            activeIdx = found >= 0 ? found : steps.length - 1;
          }
          const activeStep = steps[activeIdx] || steps[0];
          const targetWater = activeStep ? activeStep.cumWater : Number((currentSnap.recipe_snapshot_json || {}).totalWaterWeightGrams || 0);

          $('timer-mmss').textContent = formatMmSs(elapsedSec);
          $('timer-target').textContent =
            targetWater > 0
              ? `Target ${formatMmSs(totalSec)} · ${targetWater}g Air`
              : `Target ${formatMmSs(totalSec)}`;

          renderSegmentedRing(steps, totalSec, elapsedSec);
          renderStepCards(steps, activeIdx, elapsedSec, totalSec, isFinished);

          if (String(currentSnap.timer_status || '').toUpperCase() === 'RUNNING') {
            rafId = requestAnimationFrame(tickTimerFrame);
          } else {
            rafId = null;
          }
        }

        function ensureTimerLoop() {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(tickTimerFrame);
        }

        async function calibrateNtp() {
          bestRttMs = Number.MAX_SAFE_INTEGER;
          for (let i = 0; i < 2; i++) {
            const t1 = Date.now();
            try {
              const res = await fetch(`${apiBase}/api/v1/livebrew/ntp?client_send_ms=${t1}`);
              if (!res.ok) continue;
              const body = await res.json();
              const d = body && body.data ? body.data : null;
              if (!d) continue;
              const t4 = Date.now();
              const t2 = Number(d.server_recv_ms || t1);
              const t3 = Number(d.server_send_ms || t2);
              const rtt = Math.max(0, (t4 - t1) - (t3 - t2));
              if (rtt < bestRttMs) {
                bestRttMs = rtt;
                clockOffsetMs = Math.round(((t2 - t1) + (t3 - t4)) / 2);
              }
            } catch (_) {}
          }
        }

        function applyBranding(branding, seat) {
          const title =
            (currentSnap && currentSnap.selected_recipe_title) ||
            (branding && branding.cafe_display_name) ||
            'Coffee Labs';
          $('header-title').textContent = title;
          $('header-sub').textContent =
            (branding && branding.cafe_display_name) ||
            (currentSnap && currentSnap.brewer_display_name) ||
            'Live Brew';

          if (branding && branding.logo_cloudinary_url) {
            $('header-cafe-logo').src = branding.logo_cloudinary_url;
          }

          const hasSeat = !!(seat && seat.seat_label);
          const hasWifi = !!(branding && branding.wifi_ssid);
          if (hasSeat || hasWifi) {
            $('cafe-meta-bar').classList.remove('hidden');
            $('seat-pill').textContent = hasSeat ? `${seat.seat_label} • ${seat.zone_area || 'Slow Bar'}` : (branding.cafe_display_name || 'Cafe Wi-Fi');
            if (hasWifi) {
              const pass = branding.wifi_password || '';
              $('copy-wifi-btn').classList.remove('hidden');
              $('copy-wifi-btn').onclick = () => {
                if (navigator.clipboard) navigator.clipboard.writeText(pass || branding.wifi_ssid);
                $('copy-wifi-btn').textContent = '✓ Tersalin';
                setTimeout(() => ($('copy-wifi-btn').textContent = '📶 Salin Wi-Fi'), 1800);
              };
            } else {
              $('copy-wifi-btn').classList.add('hidden');
            }
          } else {
            $('cafe-meta-bar').classList.add('hidden');
          }
        }

        function renderPosProgress(pos, snap, branding) {
          if (!pos && !(snap && snap.pos_order_number)) {
            $('pos-order-card').classList.add('hidden');
            return;
          }
          $('pos-order-card').classList.remove('hidden');
          const orderNo = (pos && pos.pos_order_number) || (snap && snap.pos_order_number) || '';
          const customer = (pos && pos.customer_name) || (snap && snap.customer_name) || 'Pelanggan';
          $('pos-order-title').textContent = `Pesanan ${orderNo} • ${customer}`;

          if (branding?.show_pos_queue_position !== false && pos && Number(pos.queue_position_ahead || 0) > 0) {
            $('pos-queue-pill').textContent = `#${pos.queue_position_ahead}`;
            $('pos-queue-pill').classList.remove('hidden');
          } else {
            $('pos-queue-pill').classList.add('hidden');
          }

          const phase = String(snap?.phase || '').toUpperCase();
          const st = String(pos?.pos_order_status || snap?.pos_order_status || 'QUEUED').toUpperCase();
          let activeIdx = 0;
          if (phase === 'SERVING_READY_PASSPORT' || st === 'SERVED' || st === 'READY') activeIdx = 3;
          else if (phase === 'BREWING_ACTIVE' || phase === 'BREWING_PAUSED' || st === 'BREWING') activeIdx = 2;
          else if (phase === 'BREWER_SELECTING_RECIPE' || phase === 'BREWER_SELECTING_BEAN' || phase === 'PRE_BREW_CALIBRATED') activeIdx = 1;

          document.querySelectorAll('#pos-stepper [data-pos-step]').forEach((el) => {
            const idx = Number(el.getAttribute('data-pos-step'));
            if (idx <= activeIdx) {
              el.style.background = '#5D3A1A';
              el.style.color = '#FFFFFF';
              el.style.borderColor = '#5D3A1A';
            } else {
              el.style.background = '#FAF3E8';
              el.style.color = '#78665A';
              el.style.borderColor = '#E7DDD3';
            }
          });
        }

        function renderSnapshot(snap, forceReset = false) {
          if (!snap || String(snap.phase || '').toUpperCase() === 'ARCHIVED') {
            currentSnap = null;
            appliedVersion = -1;
            lastStepRenderKey = '';
            $('idle-waiting-card').classList.remove('hidden');
            $('active-brew-body').classList.add('hidden');
            $('reaction-dock').classList.add('hidden');
            return;
          }

          const isNewSession = currentSnap && currentSnap.session_id !== snap.session_id;
          const ver = Number(snap.state_version || 1);
          if (!forceReset && !isNewSession && ver < appliedVersion) return;
          appliedVersion = ver;
          currentSnap = snap;
          lastStepRenderKey = '';

          $('idle-waiting-card').classList.add('hidden');
          $('active-brew-body').classList.remove('hidden');
          $('reaction-dock').classList.remove('hidden');

          applyBranding(currentResolution?.branding, currentResolution?.seat);

          const rec = snap.recipe_snapshot_json || {};
          const bean = snap.bean_snapshot_json || {};
          const beanTitle =
            bean.name || bean.bean_name || rec.beanName || snap.selected_recipe_title || 'Manual Brew';
          const dose = Number(rec.coffeeWeightGrams || 15);
          const water = Number(rec.totalWaterWeightGrams || 225);
          const ratio = dose > 0 ? Math.round((water / dose) * 10) / 10 : 15;
          const temp = Math.round(Number(snap.current_temp_c || rec.waterTempCelsius || 92));
          const grind = rec.grindSize ? ` · ${rec.grindSize}` : '';

          $('spec-bean-title').textContent = beanTitle;
          $('spec-details').textContent = `${dose}g : ${water}ml (1:${ratio}) · ${temp}°C${grind}`;
          $('method-badge').textContent = snap.selected_method_name || rec.method || 'Manual Brew';

          const weight = Number(snap.current_weight_g || 0);
          const flow = Number(snap.current_flow_rate_ml_s || 0);
          if (weight > 0 || flow > 0) {
            $('scale-live-pill').textContent = `${weight.toFixed(1)} g • ${flow.toFixed(1)} g/s`;
            $('scale-live-pill').classList.remove('hidden');
          } else {
            $('scale-live-pill').classList.add('hidden');
          }

          $('brewer-name').textContent = snap.brewer_display_name || 'Barista Coffee Labs';
          $('viewers-cheers').textContent = `${Math.max(1, Number(snap.active_viewers_count || 1))} menonton • ${Number(snap.cheers_count || 0)} reaksi`;

          const isFinished = String(snap.phase || '').toUpperCase() === 'SERVING_READY_PASSPORT';
          if (isFinished) {
            $('passport-card').classList.remove('hidden');
            $('passport-summary').textContent = `Selesai ${formatMmSs(Number(snap.timer_accumulated_ms || 0) / 1000)} oleh ${snap.brewer_display_name || 'Barista'}.`;
          } else {
            $('passport-card').classList.add('hidden');
          }

          renderPosProgress(currentResolution?.pos_order_progress, snap, currentResolution?.branding);
          ensureTimerLoop();
        }

        function spawnReactionParticle(kind) {
          const el = document.createElement('div');
          el.className = 'reaction-particle';
          el.textContent = REACTION_EMOJI[kind] || '👏';
          el.style.left = `${38 + Math.random() * 44}%`;
          el.style.bottom = '72px';
          document.body.appendChild(el);
          setTimeout(() => el.remove(), 1200);
        }

        function closeStreams() {
          if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          if (ws) { try { ws.close(); } catch (_) {} ws = null; }
          if (es) { try { es.close(); } catch (_) {} es = null; }
        }

        function handleStreamEvent(ev) {
          if (!ev || !ev.event) return;
          if (ev.event === 'ntp_pong') {
            const t4 = Date.now();
            const t1 = Number(ev.client_send_ms || t4);
            const t2 = Number(ev.server_recv_ms || t4);
            const t3 = Number(ev.server_send_ms || t2);
            clockOffsetMs = Math.round(((t2 - t1) + (t3 - t4)) / 2);
          } else if (ev.event === 'mirror_snapshot') {
            renderSnapshot(ev);
          } else if (ev.event === 'seat_pos_update') {
            currentResolution = ev;
            applyBranding(ev.branding, ev.seat);
            renderPosProgress(ev.pos_order_progress, ev.active_brew_session, ev.branding);
            renderSnapshot(ev.active_brew_session, true);
          } else if (ev.event === 'cheer_burst' && currentSnap) {
            currentSnap.cheers_count = Number(ev.total_cheers || currentSnap.cheers_count || 0);
            $('viewers-cheers').textContent = `${Math.max(1, Number(currentSnap.active_viewers_count || 1))} menonton • ${currentSnap.cheers_count} reaksi`;
          } else if (ev.event === 'viewer_count_updated' && currentSnap) {
            currentSnap.active_viewers_count = Number(ev.active_viewers || 1);
            $('viewers-cheers').textContent = `${Math.max(1, currentSnap.active_viewers_count)} menonton • ${Number(currentSnap.cheers_count || 0)} reaksi`;
          }
        }

        function startResyncSafetyPoll(target) {
          if (pollTimer) clearInterval(pollTimer);
          const endpoint = target.kind === 'branded'
            ? `${apiBase}/api/v1/livebrew/resolve/cafe/${encodeURIComponent(target.cafe)}/${encodeURIComponent(target.seat)}`
            : `${apiBase}/api/v1/livebrew/resolve/code/${encodeURIComponent(target.code)}`;
          pollTimer = setInterval(async () => {
            if (ws && ws.readyState === WebSocket.OPEN) return;
            try {
              const res = await fetch(endpoint);
              if (!res.ok) return;
              const body = await res.json();
              const data = body && body.data ? body.data : null;
              if (!data) return;
              currentResolution = data;
              renderSnapshot(data.active_brew_session);
            } catch (_) {}
          }, 4000);
        }

        function connectRealtimeStream(target) {
          closeStreams();
          const targetKey = target.key;
          startResyncSafetyPoll(target);
          try {
            ws = new WebSocket(`${wsBase}/api/v1/livebrew/v2/stream/${encodeURIComponent(targetKey)}/ws`);
            ws.onopen = () => {
              setLiveDotState(true);
              ws.send(JSON.stringify({ cmd: 'NTP_PING', client_send_ms: Date.now() }));
            };
            ws.onmessage = (evt) => {
              try { handleStreamEvent(JSON.parse(evt.data)); } catch (_) {}
            };
            ws.onerror = () => connectSseFallback(targetKey);
            ws.onclose = () => {
              if (!es) {
                setLiveDotState(false);
                reconnectTimer = setTimeout(() => {
                  if (currentTarget && currentTarget.key === targetKey) connectRealtimeStream(currentTarget);
                }, 4000);
              }
            };
          } catch (_) {
            connectSseFallback(targetKey);
          }
        }

        function connectSseFallback(targetKey) {
          if (es) return;
          try {
            es = new EventSource(`${apiBase}/api/v1/livebrew/v2/stream/${encodeURIComponent(targetKey)}/sse`);
            es.onopen = () => setLiveDotState(true);
            es.onmessage = (evt) => {
              try { handleStreamEvent(JSON.parse(evt.data)); } catch (_) {}
            };
          } catch (_) {}
        }

        async function loadTarget(target, pushUrl = false) {
          currentTarget = target;
          appliedVersion = -1;
          currentSnap = null;
          lastStepRenderKey = '';
          closeStreams();

          $('lookup-error').classList.add('hidden');
          $('lookup-card').classList.add('hidden');
          $('live-shell').classList.add('hidden');
          $('reaction-dock').classList.add('hidden');
          $('loading-card').classList.remove('hidden');
          $('change-target-btn').classList.remove('hidden');
          setLiveDotState(false);

          const deepLink = target.kind === 'branded'
            ? `coffeelabs://livebrew/${target.cafe}/${target.seat}`
            : `coffeelabs://livebrew/${target.code}`;
          $('passport-deeplink').href = deepLink;

          if (pushUrl) {
            const newPath = target.kind === 'branded'
              ? `/livebrew/${target.cafe}/${target.seat}`
              : `/livebrew/${target.code}`;
            window.history.replaceState({}, '', newPath);
          }

          await calibrateNtp();

          const endpoint = target.kind === 'branded'
            ? `${apiBase}/api/v1/livebrew/resolve/cafe/${encodeURIComponent(target.cafe)}/${encodeURIComponent(target.seat)}`
            : `${apiBase}/api/v1/livebrew/resolve/code/${encodeURIComponent(target.code)}`;

          try {
            const res = await fetch(endpoint);
            if (!res.ok) throw new Error('Sesi atau meja Live Brew tidak ditemukan.');
            const body = await res.json();
            const data = body && body.data ? body.data : null;
            if (!data) throw new Error('Respon server kosong.');

            currentResolution = data;
            $('loading-card').classList.add('hidden');
            $('live-shell').classList.remove('hidden');

            applyBranding(data.branding, data.seat);
            renderPosProgress(data.pos_order_progress, data.active_brew_session, data.branding);
            renderSnapshot(data.active_brew_session, true);
            connectRealtimeStream(target);
          } catch (err) {
            $('loading-card').classList.add('hidden');
            $('lookup-card').classList.remove('hidden');
            $('lookup-error').textContent =
              (err && err.message) || 'Sesi Live Brew tidak ditemukan.';
            $('lookup-error').classList.remove('hidden');
            setLiveDotState(false);
          }
        }

        document.querySelectorAll('.react-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            if (!currentTarget) return;
            const kind = btn.getAttribute('data-react') || 'clap';
            spawnReactionParticle(kind);
            try {
              const targetKey = (currentSnap && currentSnap.share_code) || currentTarget.key;
              const res = await fetch(`${apiBase}/api/v1/livebrew/v2/${encodeURIComponent(targetKey)}/cheer`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cheer_kind: kind }),
              });
              if (res.ok) {
                const body = await res.json();
                const total = Number(body && body.data ? body.data : 0);
                if (currentSnap && total > 0) {
                  currentSnap.cheers_count = total;
                  $('viewers-cheers').textContent = `${Math.max(1, Number(currentSnap.active_viewers_count || 1))} menonton • ${total} reaksi`;
                }
              }
            } catch (_) {}
          });
        });

        $('change-target-btn').addEventListener('click', () => {
          closeStreams();
          $('live-shell').classList.add('hidden');
          $('reaction-dock').classList.add('hidden');
          $('lookup-card').classList.remove('hidden');
          setLiveDotState(false);
          $('target-input').focus();
        });

        $('jump-form').addEventListener('submit', (e) => {
          e.preventDefault();
          const parsed = parseRawInput($('target-input').value);
          if (!parsed) {
            $('lookup-error').textContent = 'Masukkan kode 13 digit atau slug kafe/meja.';
            $('lookup-error').classList.remove('hidden');
            return;
          }
          loadTarget(parsed, true);
        });

        const initial = parseFromPathname();
        if (initial) {
          $('target-input').value =
            initial.kind === 'branded' ? `${initial.cafe}/${initial.seat}` : initial.code;
          loadTarget(initial, false);
        }
      })();
    </script>
  </body>
</html>
