---
import '../styles/global.css';
import Icon from '../components/ui/Icon.astro';

// Trial Curated Recipes
const trialRecipes = [
  {
    id: 'recipe-rusdi',
    author: 'Rusdi',
    flag: '🇮🇩',
    title: 'Resep V60 Pour Over Saya',
    subtitle: 'Resep seduh V60 Pour...',
    category: 'V60',
    coffee: '15g',
    water: '225ml',
    temp: '92°C',
    ratio: '1:15',
    isIced: false,
    pours: '3x Pour',
    grind: 'Medium',
    grindDetail: 'Comandante: 22 klik • Timemore: 16 klik • Vesper: 65 klik',
    notes: ['Peach', 'Brown Sugar', 'Floral'],
    avatar: '/images/characters/char_avatar_1.jpg',
    dot1: { bg: 'bg-[#FED7AA]', icon: 'flame', color: '#EA580C' },
    dot2: { bg: 'bg-[#FFEDD5]', icon: 'disc', color: '#D97706' },
    totalSeconds: 135, // 02:15
    steps: [
      { name: '1. Blooming & Swirl', time: '00:00 - 00:35', start: 0, end: 35, waterAdded: 45, waterTarget: 45, desc: 'Tuang melingkar pelan, swirl 2x.' },
      { name: '2. Sweetness Center Pour', time: '00:35 - 01:15', start: 35, end: 75, waterAdded: 90, waterTarget: 135, desc: 'Tuang di tengah untuk ekstraksi gula alami.' },
      { name: '3. Final Clarity Pour', time: '01:15 - 02:15', start: 75, end: 135, waterAdded: 90, waterTarget: 225, desc: 'Tuang spiral melingkar sampai 225g. Tunggu air turun.' },
    ]
  },
  {
    id: 'recipe-tetsu',
    author: 'Tetsu Kasuya',
    flag: '🇯🇵',
    title: 'Metode Multi-Pour Neo Brew (4:6)',
    subtitle: "Tetsu Kasuya's 10th...",
    category: 'V60',
    coffee: '20g',
    water: '300ml',
    temp: '90°C',
    ratio: '1:15',
    isIced: false,
    pours: '5x Pour',
    grind: 'Super Coarse',
    grindDetail: 'Comandante: 28 klik • Timemore: 22 klik • Vesper: 85 klik',
    notes: ['Cherry', 'Black Tea', 'Clean Sweet'],
    avatar: '/images/avatars/portraits/tetsu_kasuya.jpg',
    dot1: { bg: 'bg-[#FCE7F3]', icon: 'heart', color: '#DB2777' },
    dot2: { bg: 'bg-[#E0F2FE]', icon: 'sparkles', color: '#0284C7' },
    totalSeconds: 210, // 03:30
    steps: [
      { name: '1. 40% Rasa (Bloom 1)', time: '00:00 - 00:45', start: 0, end: 45, waterAdded: 50, waterTarget: 50, desc: 'Menentukan balance acidity awal seduhan.' },
      { name: '2. 40% Rasa (Bloom 2)', time: '00:45 - 01:30', start: 45, end: 90, waterAdded: 70, waterTarget: 120, desc: 'Menentukan tingkat sweetness rasa manis.' },
      { name: '3. 60% Strength (Pour 3)', time: '01:30 - 02:10', start: 90, end: 130, waterAdded: 60, waterTarget: 180, desc: 'Tuang lembut di tengah untuk konsentrasi strength.' },
      { name: '4. 60% Strength (Pour 4)', time: '02:10 - 02:50', start: 130, end: 170, waterAdded: 60, waterTarget: 240, desc: 'Tuangan keempat menjaga ekstraksi seimbang.' },
      { name: '5. Drawdown Finish (Pour 5)', time: '02:50 - 03:30', start: 170, end: 210, waterAdded: 60, waterTarget: 300, desc: 'Tuangan akhir hingga 300g. Biarkan air turun sempurna.' },
    ]
  },
  {
    id: 'recipe-mikael-v60',
    author: 'Mikael Jasin',
    flag: '🇮🇩',
    title: 'V60 Signature Sensory Clarity',
    subtitle: '2024 World Barista Champion Profile',
    category: 'V60',
    coffee: '15g',
    water: '240ml',
    temp: '93°C',
    ratio: '1:16',
    isIced: false,
    pours: '3x Pour',
    grind: 'Medium-Fine',
    grindDetail: 'Comandante: 20 klik • Timemore: 15 klik • Vesper: 58 klik',
    notes: ['Jasmine', 'Meyer Lemon', 'Tropical Fruit'],
    avatar: '/images/avatars/portraits/mikael_jasin.jpg',
    dot1: { bg: 'bg-[#FED7AA]', icon: 'disc', color: '#EA580C' },
    dot2: { bg: 'bg-[#FCE7F3]', icon: 'sparkles', color: '#EC4899' },
    totalSeconds: 150, // 02:30
    steps: [
      { name: '1. Gentle Blooming', time: '00:00 - 00:40', start: 0, end: 40, waterAdded: 45, waterTarget: 45, desc: 'Aliran air lembut 4g/detik melingkar dari tengah ke luar.' },
      { name: '2. High Agitation Pulse', time: '00:40 - 01:25', start: 40, end: 85, waterAdded: 95, waterTarget: 140, desc: 'Tuang spiral agresif dari ketinggian sedang melarutkan asam buah.' },
      { name: '3. Melodrip / Low Agitation Finish', time: '01:25 - 02:30', start: 85, end: 150, waterAdded: 100, waterTarget: 240, desc: 'Tuangan sangat rendah di tengah hingga 240g. Drawdown tuntas.' },
    ]
  },
  {
    id: 'recipe-mikael-iced',
    author: 'Mikael Jasin',
    flag: '🇮🇩',
    title: 'Japanese Iced V60 Flash Aroma',
    subtitle: 'Resep Japanese Iced Segar & Manis',
    category: 'Japanese',
    coffee: '18g',
    water: '270g',
    temp: '94°C',
    ratio: '1:15',
    isIced: true,
    pours: '3x Pour',
    grind: 'Fine-Medium',
    grindDetail: 'Comandante: 18 klik • Timemore: 13 klik • Vesper: 52 klik',
    notes: ['Yellow Flower', 'Strawberry', 'Iced Crisp'],
    avatar: '/images/avatars/portraits/mikael_jasin.jpg',
    dot1: { bg: 'bg-[#FEF9C3]', icon: 'sparkles', color: '#CA8A04' },
    dot2: { bg: 'bg-[#FFE4E6]', icon: 'heart', color: '#E11D48' },
    totalSeconds: 140, // 02:20
    steps: [
      { name: '1. Siapkan Es Batu & Bloom', time: '00:00 - 00:40', start: 0, end: 40, waterAdded: 50, waterTarget: 50, desc: 'Taruh 100g es batu di server. Tuang 50g air panas ke bubuk kopi.' },
      { name: '2. Continuous Center Pulse', time: '00:40 - 01:20', start: 40, end: 80, waterAdded: 60, waterTarget: 110, desc: 'Tuang lurus di tengah untuk melarutkan komponen aroma segar.' },
      { name: '3. Final Fast Pour & Swirl', time: '01:20 - 02:20', start: 80, end: 140, waterAdded: 60, waterTarget: 170, desc: 'Tuang melingkar cepat. Angkat dripper lalu swirl server hingga dingin.' },
    ]
  },
];

const initialRecipe = trialRecipes[0];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Coffee Labs — Versi Web Uji Coba Gratis (Trial App)</title>
    <meta name="description" content="Uji coba gratis Coffee Labs via web browser. Panduan seduh presisi, timer interaktif dengan audio efek suara & musik kafe, dan resep barista dunia." />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body class="bg-[#181310] text-[#332B25] antialiased select-none font-sans min-h-screen flex flex-col items-center justify-center p-0 md:p-4 overflow-x-hidden">
    
    <!-- Top Desktop Quick Bar (Only visible on tablet & desktop) -->
    <header class="hidden md:flex items-center justify-between max-w-5xl w-full py-2.5 px-4 mb-2 text-white/80 text-xs">
      <div class="flex items-center gap-2">
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold transition-colors">
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          <span>Kembali ke Landing Page</span>
        </a>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#ECA400]/20 border border-[#ECA400]/40 text-[#ECA400] text-[11px] font-bold">
          <span class="w-2 h-2 rounded-full bg-[#ECA400] animate-pulse"></span>
          <span>MODE UJI COBA WEB (TRIAL 10 SESI)</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-white/60 text-[11px] hidden lg:inline">Unduh Versi Penuh:</span>
        <a
          href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439526766"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#ECA400] hover:bg-[#D4AF37] text-[#1E1612] font-bold text-xs shadow-sm transition-all"
          title="Unduh APK Android"
        >
          <span>Unduh Android (APK)</span>
        </a>
        <a
          href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439017056"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-black text-white border border-white/20 hover:bg-neutral-800 font-bold text-xs shadow-sm transition-all"
          title="Unduh iOS (App Store)"
        >
          <span>Unduh iOS</span>
        </a>
      </div>
    </header>

    <!-- Main Mobile Shell Container (Phone Mockup Frame on Desktop, Fullscreen on Mobile) -->
    <main class="w-full md:max-w-[420px] h-[100dvh] md:h-[860px] md:max-h-[92vh] bg-[#F9F6F0] md:rounded-[44px] shadow-2xl md:ring-1 md:ring-white/15 md:border-[7px] md:border-[#2A1F19] flex flex-col relative overflow-hidden">
      
      <!-- Top Speaker & Camera Notch (Desktop phone aesthetic) -->
      <div class="hidden md:flex justify-center pt-2 pb-0.5 shrink-0 bg-[#F9F6F0] z-30">
        <div class="w-24 h-4 bg-[#2A1F19] rounded-full flex items-center justify-center gap-2">
          <div class="w-2 h-2 rounded-full bg-[#1E1612]/80 border border-white/10"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-blue-900/60"></div>
        </div>
      </div>

      <!-- Native Mobile Status Bar -->
      <div class="flex items-center justify-between px-5 pt-2 pb-1 shrink-0 bg-[#F9F6F0] text-[11px] font-semibold text-[#332B25] z-30">
        <span id="live-clock">09:41</span>
        <div class="flex items-center gap-1.5 text-[#332B25]">
          <!-- Mobile Return Link (visible on small screens) -->
          <a href="/" class="md:hidden text-[10px] text-[#6B4423] font-bold bg-[#F1E8E0] px-2 py-0.5 rounded-md mr-1" title="Kembali ke Landing Page">
            ← Web
          </a>
          <!-- WiFi SVG -->
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98A16.88 16.88 0 0 0 12 4z"/></svg>
          <!-- Signal SVG -->
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M2 22h20V2L2 22z"/></svg>
          <!-- Battery SVG -->
          <div class="w-4 h-2.5 border border-[#332B25] rounded-[2px] p-0.5 flex items-center">
            <div class="w-2.5 h-full bg-[#332B25] rounded-[1px]"></div>
          </div>
        </div>
      </div>

      <!-- App Header Bar -->
      <div class="px-4 py-2 border-b border-[#E8DFD8] bg-[#F9F6F0] shrink-0 flex items-center justify-between z-20">
        <div class="flex items-center gap-2.5">
          <img src="/images/characters/char_avatar_1.jpg" alt="Avatar Barista" class="w-8 h-8 rounded-full object-cover border border-[#6B4423]/20 shadow-xs" />
          <div>
            <div class="flex items-center gap-1">
              <span class="text-xs font-bold text-[#332B25]">Barista Rusdi</span>
              <span class="px-1.5 py-0.2 rounded-full bg-[#ECA400]/20 text-[#6B4423] text-[9px] font-bold">Trial</span>
            </div>
            <span class="text-[10px] text-[#8F857D] block leading-none">Selamat Menyeduh ☕</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Audio Toggle Button (Mute / Sound with BGM equalizer) -->
          <button
            id="audio-toggle-btn"
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F1E8E0] hover:bg-[#E8DFD8] text-[#6B4423] text-[10.5px] font-bold border border-[#6B4423]/15 transition-all cursor-pointer"
            title="Nyalakan / Matikan Efek Suara & Musik Kafe"
          >
            <span id="audio-icon-wrap" class="w-3.5 h-3.5 flex items-center justify-center">
              <Icon name="volume-2" size={13} color="#6B4423" />
            </span>
            <span id="audio-label">BGM & SFX</span>
            <!-- Live soundwave indicator (animated when BGM playing) -->
            <span id="soundwave-bar" class="hidden items-center gap-0.5 h-2.5">
              <span class="w-0.5 h-2 bg-[#ECA400] rounded-full animate-bounce"></span>
              <span class="w-0.5 h-3 bg-[#6B4423] rounded-full animate-pulse"></span>
              <span class="w-0.5 h-1.5 bg-[#ECA400] rounded-full animate-bounce"></span>
            </span>
          </button>
        </div>
      </div>

      <!-- SCROLLABLE TAB CONTENT PAGES -->
      <div class="flex-1 overflow-y-auto no-scrollbar relative bg-[#F9F6F0]">
        
        <!-- ========================================== -->
        <!-- TAB 1: HOME / RECIPES CATALOG (ACTIVE)    -->
        <!-- ========================================== -->
        <section id="tab-content-recipes" class="p-3.5 space-y-3.5 block">
          
          <!-- Trial Notice Alert Banner -->
          <div class="p-3 rounded-2xl bg-gradient-to-r from-[#FFF4D6] to-[#FDF0D5] border border-[#ECA400]/30 shadow-xs flex items-start gap-2.5">
            <div class="w-7 h-7 rounded-xl bg-[#ECA400] text-[#1E1612] flex items-center justify-center shrink-0 shadow-xs mt-0.5">
              <Icon name="sparkles" size={14} color="#1E1612" />
            </div>
            <div class="flex-1 text-left">
              <div class="flex items-center justify-between">
                <span class="text-[11.5px] font-bold text-[#332B25]">Mode Uji Coba Gratis</span>
                <span class="text-[9.5px] font-extrabold px-1.5 py-0.5 rounded bg-[#6B4423] text-white">10 Sesi</span>
              </div>
              <p class="text-[10px] text-[#6F655D] mt-0.5 leading-snug">
                Pilih resep di bawah ini untuk memulai <strong>Guided Brew Stopwatch</strong> dengan audio efek suara & musik kafe asli.
              </p>
            </div>
          </div>

          <!-- Search & Filter Bar -->
          <div class="space-y-2">
            <div class="relative">
              <input
                id="recipe-search-input"
                type="text"
                placeholder="Cari resep (V60, Tetsu, Jasin)..."
                class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-white border border-[#E8DFD8] text-xs text-[#332B25] placeholder-[#8F857D] focus:outline-none focus:border-[#6B4423] shadow-xs"
              />
              <svg class="w-3.5 h-3.5 text-[#8F857D] absolute left-2.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>

            <!-- Category Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 text-[11px] font-bold">
              <button class="cat-pill px-3 py-1 rounded-full bg-[#6B4423] text-white shadow-xs cursor-pointer" data-category="ALL">Semua</button>
              <button class="cat-pill px-3 py-1 rounded-full bg-white text-[#6F655D] border border-[#E8DFD8] hover:bg-black/5 cursor-pointer" data-category="V60">V60 (3)</button>
              <button class="cat-pill px-3 py-1 rounded-full bg-white text-[#6F655D] border border-[#E8DFD8] hover:bg-black/5 cursor-pointer" data-category="Japanese">Japanese Iced (1)</button>
            </div>
          </div>

          <!-- Section Title -->
          <div class="flex items-center justify-between pt-1">
            <h3 class="text-xs font-black text-[#332B25] uppercase tracking-wider">Pustaka Resep Trial ({trialRecipes.length})</h3>
            <span class="text-[10px] text-[#8F857D]">Sentuh untuk seduh</span>
          </div>

          <!-- 2-COLUMN RECIPE GRID (Exact Mobile Layout) -->
          <div id="recipe-cards-grid" class="grid grid-cols-2 gap-2.5 pb-20">
            {trialRecipes.map((r) => (
              <div
                class="recipe-card p-2.5 rounded-2xl bg-white border border-[#E8DFD8] hover:border-[#6B4423] shadow-sm hover:shadow-md transition-all flex flex-col justify-between cursor-pointer group"
                data-recipe-id={r.id}
                data-category={r.category}
              >
                <!-- Card Header: Flag & Category Tag -->
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-[#8F857D] flex items-center gap-1 truncate max-w-[95px]">
                      <span>{r.flag}</span>
                      <span class="truncate">{r.author}</span>
                    </span>
                    <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded bg-[#F1E8E0] text-[#6B4423]">
                      {r.category}
                    </span>
                  </div>

                  <!-- Recipe Title -->
                  <h4 class="font-bold text-[11.5px] text-[#332B25] leading-tight group-hover:text-[#6B4423] transition-colors line-clamp-2 min-h-[28px]">
                    {r.title}
                  </h4>
                </div>

                <!-- Parameters Grid -->
                <div class="my-2 py-1.5 px-2 rounded-xl bg-[#F9F6F0] border border-[#E8DFD8]/60 grid grid-cols-2 gap-1 text-[10px]">
                  <div>
                    <span class="text-[#8F857D] block text-[8.5px]">Dosis</span>
                    <span class="font-bold text-[#332B25]">{r.coffee}</span>
                  </div>
                  <div>
                    <span class="text-[#8F857D] block text-[8.5px]">Air</span>
                    <span class="font-bold text-[#332B25]">{r.water}</span>
                  </div>
                  <div>
                    <span class="text-[#8F857D] block text-[8.5px]">Suhu</span>
                    <span class="font-bold text-[#332B25]">{r.temp}</span>
                  </div>
                  <div>
                    <span class="text-[#8F857D] block text-[8.5px]">Rasio</span>
                    <span class="font-bold text-[#332B25]">{r.ratio}</span>
                  </div>
                </div>

                <!-- Tasting Notes -->
                <div class="flex flex-wrap gap-1 mb-2">
                  {r.notes.slice(0, 2).map((note) => (
                    <span class="px-1.5 py-0.2 rounded-md bg-[#FFF4D6] text-[#6B4423] text-[8.5px] font-medium truncate max-w-[80px]">
                      {note}
                    </span>
                  ))}
                </div>

                <!-- CTA Button -->
                <button
                  type="button"
                  class="w-full py-1.5 rounded-xl bg-[#ECA400] hover:bg-[#D4AF37] text-[#332B25] font-bold text-[10.5px] flex items-center justify-center gap-1 shadow-xs transition-transform active:scale-95"
                >
                  <Icon name="timer" size={11} color="#332B25" />
                  <span>Mulai Seduh</span>
                </button>
              </div>
            ))}
          </div>

        </section>

        <!-- ========================================== -->
        <!-- TAB 2: GUIDED BREW TIMER SCREEN (ACTIVE)  -->
        <!-- ========================================== -->
        <section id="tab-content-brew" class="p-3.5 space-y-3 hidden pb-24">
          
          <!-- Top Brew Header Bar -->
          <div class="flex items-center justify-between pb-1 border-b border-[#E8DFD8]">
            <button id="brew-back-to-recipes" class="p-1 rounded-lg hover:bg-black/5 text-[#332B25] text-xs font-bold flex items-center gap-1 cursor-pointer">
              <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
              <span>Ganti Resep</span>
            </button>
            
            <div class="text-right">
              <span id="active-recipe-title" class="text-xs font-bold text-[#332B25] block truncate max-w-[170px]">
                {initialRecipe.title}
              </span>
              <span id="active-recipe-author" class="text-[9.5px] text-[#8F857D] block">
                {initialRecipe.author} · {initialRecipe.category}
              </span>
            </div>
          </div>

          <!-- Circular Segmented Timer Ring Mockup -->
          <div class="flex justify-center py-1">
            <div class="relative w-44 h-44 sm:w-48 sm:h-48 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                <!-- Background Ring Track -->
                <circle cx="50" cy="50" r="42" fill="none" stroke="#EFE5D8" stroke-width="7" />
                <!-- Dynamic Progress Ring -->
                <circle
                  id="timer-svg-circle"
                  cx="50"
                  cy="50"
                  r="42"
                  fill="none"
                  stroke="#ECA400"
                  stroke-width="7"
                  stroke-dasharray="264"
                  stroke-dashoffset="264"
                  stroke-linecap="round"
                  class="transition-all duration-300"
                />
              </svg>

              <!-- Central Timer Readout -->
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span id="timer-display" class="text-4xl font-black text-[#5D4037] font-mono tracking-tight leading-none">
                  00:00
                </span>
                <span id="timer-target-text" class="text-[10px] font-semibold text-[#8F857D] mt-1">
                  Target 02:15 · 225ml
                </span>
                <div id="timer-status-badge" class="mt-1.5 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[8.5px] font-bold border border-amber-200 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                  <span id="timer-status-text">SIAP SEDUH</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Control Action Buttons -->
          <div class="flex items-center justify-center gap-3 py-1">
            <!-- Reset Button -->
            <button
              id="btn-reset-timer"
              class="w-10 h-10 rounded-full bg-white border border-[#E8DFD8] text-[#6F655D] hover:text-[#332B25] flex items-center justify-center shadow-xs transition-transform active:scale-90 cursor-pointer"
              title="Reset Timer"
            >
              <Icon name="refresh-cw" size={15} color="currentColor" />
            </button>

            <!-- Play / Pause Main CTA Button -->
            <button
              id="btn-play-pause-timer"
              class="px-6 py-2.5 rounded-full bg-[#ECA400] hover:bg-[#D4AF37] text-[#332B25] font-black text-xs sm:text-sm flex items-center gap-2 shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <span id="play-pause-icon">
                <Icon name="play" size={14} color="#332B25" />
              </span>
              <span id="play-pause-label">Mulai Seduh</span>
            </button>

            <!-- Skip / Forward Step Button -->
            <button
              id="btn-skip-step"
              class="w-10 h-10 rounded-full bg-white border border-[#E8DFD8] text-[#6F655D] hover:text-[#332B25] flex items-center justify-center shadow-xs transition-transform active:scale-90 cursor-pointer"
