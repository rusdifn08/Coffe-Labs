            <button id="btn-close-brew-doctor" class="w-7 h-7 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center text-xs font-bold text-[#6F655D] cursor-pointer">
              ✕
            </button>
          </div>

          <div class="flex-1 overflow-y-auto no-scrollbar py-2.5 space-y-2.5 text-xs">
            
            <!-- Doctor Tip Card 1 -->
            <div class="p-3 rounded-2xl bg-white border border-orange-200 space-y-1">
              <div class="flex items-center gap-1.5 text-orange-600 font-bold">
                <span>⚡</span>
                <span>Terlalu Asam / Kecut / Tipis (Under-Extracted)</span>
              </div>
              <p class="text-[11px] text-[#6F655D] leading-relaxed">
                • Haluskan gilingan 1–2 klik lebih rapat.<br />
                • Naikkan suhu air +2°C (misal 92°C → 94°C).<br />
                • Tuang sedikit lebih lambat atau perpanjang waktu blooming.
              </p>
            </div>

            <!-- Doctor Tip Card 2 -->
            <div class="p-3 rounded-2xl bg-white border border-red-200 space-y-1">
              <div class="flex items-center gap-1.5 text-red-600 font-bold">
                <span>🔥</span>
                <span>Terlalu Pahit / Sepat / Kering (Over-Extracted)</span>
              </div>
              <p class="text-[11px] text-[#6F655D] leading-relaxed">
                • Kasarkan gilingan 1–2 klik lebih longgar.<br />
                • Turunkan suhu air -2°C (misal 94°C → 92°C).<br />
                • Kurangi goyangan (swirl) dan tuang lebih tenang di titik tengah.
              </p>
            </div>

            <!-- Doctor Tip Card 3 -->
            <div class="p-3 rounded-2xl bg-white border border-blue-200 space-y-1">
              <div class="flex items-center gap-1.5 text-blue-600 font-bold">
                <span>💧</span>
                <span>Kurang Body / Terlalu Encer (Weak Extraction)</span>
              </div>
              <p class="text-[11px] text-[#6F655D] leading-relaxed">
                • Gunakan rasio lebih pendek (misal 1:14 atau 1:15 alih-alih 1:17).<br />
                • Tambahkan dosis bubuk kopi +1g hingga +2g.
              </p>
            </div>

          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- MODAL 5: BREW COMPLETED CELEBRATION MODAL                    -->
      <!-- ============================================================ -->
      <div id="brew-completed-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="w-full max-w-xs bg-white rounded-3xl p-5 text-center space-y-4 shadow-2xl animate-in zoom-in-95 duration-200">
          <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-[#6B4423] to-[#ECA400] text-white flex items-center justify-center mx-auto shadow-md">
            <Icon name="coffee" size={32} color="#FFFFFF" />
          </div>
          <div>
            <span class="text-[10px] font-bold text-[#ECA400] uppercase tracking-wider">SEDURAN SELESAI</span>
            <h3 class="text-base font-black text-[#332B25] mt-0.5">Kopi Siap Dinikmati!</h3>
            <p class="text-xs text-[#6F655D] mt-1 leading-relaxed">
              Selamat! Ekstraksi kopi Anda telah selesai tepat waktu. Nikmati aroma dan cita rasa manisnya.
            </p>
          </div>
          
          <div class="p-2.5 rounded-xl bg-[#F9F6F0] border border-[#E8DFD8] text-[11px] grid grid-cols-2 gap-1 font-bold text-[#332B25]">
            <span id="finish-time-stat">Waktu: 02:15</span>
            <span id="finish-water-stat">Air: 225ml</span>
          </div>

          <div class="space-y-2">
            <button id="btn-modal-print-receipt" class="w-full py-2.5 rounded-xl bg-[#6B4423] hover:bg-[#563519] text-white text-xs font-bold shadow-sm transition-all cursor-pointer flex items-center justify-center gap-1.5">
              <Icon name="printer" size={14} color="#FFFFFF" />
              <span>Cetak Struk Seduhan</span>
            </button>
            <button id="btn-modal-brew-again" class="w-full py-2 rounded-xl bg-[#ECA400] hover:bg-[#D4AF37] text-[#1E1612] text-xs font-bold transition-all cursor-pointer">
              Seduh Lagi
            </button>
            <button id="btn-modal-back-recipes" class="w-full py-2 rounded-xl bg-black/5 hover:bg-black/10 text-[#332B25] text-xs font-semibold transition-all cursor-pointer">
              Kembali ke Pustaka
            </button>
          </div>
        </div>
      </div>

    </main>

    <!-- Embedded Application Client Logic -->
    <script define:vars={{ trialRecipes, baristasList }}>
      // 1. Audio Engine using Web Audio API + HTML5 Audio
      class AudioEngine {
        constructor() {
          this.muted = false;
          this.bgmAudio = null;
          this.audioContext = null;
          this.init();
        }

        init() {
          try {
            this.bgmAudio = new Audio('/audio/calm_music.m4a');
            this.bgmAudio.loop = true;
            this.bgmAudio.volume = 0.35;
          } catch (e) {
            console.warn('BGM Audio init error:', e);
          }
        }

        getAudioContext() {
          if (!this.audioContext) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) this.audioContext = new AudioCtx();
          }
          if (this.audioContext && this.audioContext.state === 'suspended') {
            this.audioContext.resume();
          }
          return this.audioContext;
        }

        playFile(url, volume = 0.7) {
          if (this.muted) return;
          try {
            const a = new Audio(url);
            a.volume = volume;
            a.play().catch(() => this.fallbackBeep());
          } catch (_) {
            this.fallbackBeep();
          }
        }

        playClick() { this.playFile('/audio/click.wav', 0.5); }
        playTick() { this.playFile('/audio/tick.wav', 0.6); }
        playTransition() { this.playFile('/audio/transition.wav', 0.85); }
        playEnjoy() { this.playFile('/audio/enjoy.wav', 1.0); }

        startBgm() {
          if (this.muted || !this.bgmAudio) return;
          try {
            this.bgmAudio.currentTime = 0;
            this.bgmAudio.play().then(() => {
              document.getElementById('soundwave-bar')?.classList.remove('hidden');
              document.getElementById('soundwave-bar')?.classList.add('flex');
            }).catch(() => {});
          } catch (_) {}
        }

        stopBgm() {
          if (!this.bgmAudio) return;
          try {
            this.bgmAudio.pause();
            this.bgmAudio.currentTime = 0;
            document.getElementById('soundwave-bar')?.classList.add('hidden');
            document.getElementById('soundwave-bar')?.classList.remove('flex');
          } catch (_) {}
        }

        toggleMute() {
          this.muted = !this.muted;
          if (this.muted) this.stopBgm();
          return this.muted;
        }

        fallbackBeep(freq = 600, duration = 0.08) {
          try {
            const ctx = this.getAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
          } catch (_) {}
        }
      }

      const audio = new AudioEngine();

      // Audio Toggle Button
      const audioToggleBtn = document.getElementById('audio-toggle-btn');
      const audioLabel = document.getElementById('audio-label');
      if (audioToggleBtn) {
        audioToggleBtn.addEventListener('click', () => {
          const isMuted = audio.toggleMute();
          if (isMuted) {
            audioLabel.textContent = 'Muted 🔇';
            audioToggleBtn.classList.add('opacity-60');
          } else {
            audioLabel.textContent = 'BGM & SFX';
            audioToggleBtn.classList.remove('opacity-60');
            audio.playClick();
          }
        });
      }

      // Live Clock
      function updateClock() {
        const now = new Date();
        const clockEl = document.getElementById('live-clock');
        if (clockEl) clockEl.textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
      }
      setInterval(updateClock, 1000);
      updateClock();

      // Tab Navigation System
      const tabButtons = document.querySelectorAll('.bottom-tab-btn');
      const tabContents = {
        recipes: document.getElementById('tab-content-recipes'),
        brew: document.getElementById('tab-content-brew'),
        radar: document.getElementById('tab-content-radar'),
        social: document.getElementById('tab-content-social'),
        toolkit: document.getElementById('tab-content-toolkit'),
      };

      function switchTab(targetTab) {
        audio.playClick();
        tabButtons.forEach((btn) => {
          const tab = btn.getAttribute('data-tab');
          if (tab === targetTab) {
            btn.classList.add('text-[#6B4423]', 'font-bold');
            btn.classList.remove('text-[#8F857D]', 'text-gray-400');
          } else {
            btn.classList.remove('text-[#6B4423]', 'font-bold');
            if (tab === 'radar' || tab === 'social' || tab === 'toolkit') {
              btn.classList.add('text-gray-400');
            } else {
              btn.classList.add('text-[#8F857D]');
            }
          }
        });

        Object.keys(tabContents).forEach((tab) => {
          const el = tabContents[tab];
          if (!el) return;
          if (tab === targetTab) {
            el.classList.remove('hidden');
            if (tab === 'brew') {
              el.classList.remove('block');
              el.classList.add('flex');
            } else {
              el.classList.remove('flex');
              el.classList.add('block');
            }
          } else {
            el.classList.add('hidden');
            el.classList.remove('block', 'flex');
          }
        });

        if (targetTab === 'brew' && typeof drawSegmentedTimer === 'function') {
          setTimeout(() => {
            drawSegmentedTimer();
            if (typeof scrollToStep === 'function') {
              const curIdx = currentRecipe.steps.findIndex((s) => elapsedSeconds >= s.start && elapsedSeconds < s.end);
              scrollToStep(curIdx >= 0 ? curIdx : 0);
            }
          }, 30);
        }
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');
          switchTab(tab);
        });
      });

      // Recipe Filters & Barista Spotlight
      const searchInput = document.getElementById('recipe-search-input');
      const clearSearchBtn = document.getElementById('search-clear-btn');
      const catPills = document.querySelectorAll('.cat-pill');
      const baristaBtns = document.querySelectorAll('.barista-avatar-btn');
      const resetBaristaFilter = document.getElementById('reset-barista-filter');
      const recipeCards = document.querySelectorAll('.recipe-card');
      const visibleCountEl = document.getElementById('visible-recipes-count');

      let currentCategory = 'ALL';
      let selectedBarista = '';
      let searchQuery = '';

      function filterRecipeList() {
        let count = 0;
        recipeCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category') || '';
          const cardAuthor = card.getAttribute('data-author') || '';
          const title = card.querySelector('h4')?.textContent.toLowerCase() || '';
          const author = card.querySelector('.truncate')?.textContent.toLowerCase() || '';

          const matchCat = currentCategory === 'ALL' || cardCat.includes(currentCategory);
          const matchBarista = !selectedBarista || cardAuthor.toLowerCase().includes(selectedBarista.toLowerCase());
          const matchQuery = !searchQuery || title.includes(searchQuery) || author.includes(searchQuery);

          if (matchCat && matchBarista && matchQuery) {
            card.classList.remove('hidden');
            count++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCountEl) visibleCountEl.textContent = String(count);
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.toLowerCase().trim();
          if (clearSearchBtn) {
            if (searchQuery) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          filterRecipeList();
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          clearSearchBtn.classList.add('hidden');
          filterRecipeList();
        });
      }

      catPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          audio.playClick();
          catPills.forEach((p) => {
            p.classList.remove('bg-[#6B4423]', 'text-white');
            p.classList.add('bg-white', 'text-[#6F655D]');
          });
          pill.classList.add('bg-[#6B4423]', 'text-white');
          pill.classList.remove('bg-white', 'text-[#6F655D]');
          currentCategory = pill.getAttribute('data-category') || 'ALL';
          filterRecipeList();
        });
      });

      baristaBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          audio.playClick();
          const name = btn.getAttribute('data-barista-name') || '';
          selectedBarista = name;
          if (resetBaristaFilter) resetBaristaFilter.classList.remove('hidden');
          filterRecipeList();
        });
      });

      if (resetBaristaFilter) {
        resetBaristaFilter.addEventListener('click', () => {
          selectedBarista = '';
          resetBaristaFilter.classList.add('hidden');
          filterRecipeList();
        });
      }

      // ============================================================
      // RECIPE DETAIL SHEET MODAL WITH AUTO-SCALE DOSING
      // ============================================================
      let activeDetailRecipe = trialRecipes[0];
      let scaledCoffee = activeDetailRecipe.coffee;
      const detailModal = document.getElementById('recipe-detail-modal');

      function openRecipeDetail(recipe) {
        activeDetailRecipe = JSON.parse(JSON.stringify(recipe)); // Clone
        scaledCoffee = activeDetailRecipe.coffee;

        const avatarEl = document.getElementById('detail-modal-avatar');
        const authorEl = document.getElementById('detail-modal-author');
        const flagEl = document.getElementById('detail-modal-flag');
        const titleEl = document.getElementById('detail-modal-title');
        const descEl = document.getElementById('detail-modal-desc');
        const grindEl = document.getElementById('detail-modal-grind');
        const tempEl = document.getElementById('detail-modal-temp');
        const ratioEl = document.getElementById('detail-scale-ratio');
        const notesContainer = document.getElementById('detail-modal-notes');

        // Detailed Coffee Profile Elements
        const beanEl = document.getElementById('detail-modal-bean');
        const varietyEl = document.getElementById('detail-modal-variety');
        const processEl = document.getElementById('detail-modal-process');
        const roastEl = document.getElementById('detail-modal-roast');
        const roasteryEl = document.getElementById('detail-modal-roastery');
        const filterEl = document.getElementById('detail-modal-filter');
        const waterSpecEl = document.getElementById('detail-modal-water-spec');
        const prepContainer = document.getElementById('detail-modal-prep-checklist');

        if (avatarEl) avatarEl.src = recipe.avatar;
        if (authorEl) authorEl.textContent = recipe.author;
        if (flagEl) flagEl.textContent = recipe.flag;
        if (titleEl) titleEl.textContent = recipe.title;
        if (descEl) descEl.textContent = recipe.description;
        if (grindEl) grindEl.textContent = recipe.grindSize;
        if (tempEl) tempEl.textContent = `${recipe.temp}°C`;
        if (ratioEl) ratioEl.textContent = `Rasio ${recipe.ratio}`;

        if (beanEl) beanEl.textContent = recipe.beanName || 'Single Origin Specialty';
        if (varietyEl) varietyEl.textContent = recipe.variety || '-';
        if (processEl) processEl.textContent = recipe.process || '-';
        if (roastEl) roastEl.textContent = recipe.roast || '-';
        if (roasteryEl) roasteryEl.textContent = recipe.roastery || '-';
        if (filterEl) filterEl.textContent = recipe.filterPaper || 'Hario V60 02 Filter';
        if (waterSpecEl) waterSpecEl.textContent = recipe.waterSpec || 'Lotus Water 85 PPM';

        // Render Prep Checklist
        if (prepContainer) {
          prepContainer.innerHTML = '';
          const checklist = recipe.prepChecklist || [
            'Bilas kertas filter (Paper Rinse) & panaskan server',
            `Timbang & giling ${recipe.coffee}g kopi (${recipe.grindSize})`,
            `Siapkan air bersuhu ${recipe.temp}°C`
          ];
          checklist.forEach((item) => {
            const row = document.createElement('div');
            row.className = 'flex items-start gap-2 p-1.5 rounded-lg bg-[#F9F6F0]';
            row.innerHTML = `
              <span class="w-4 h-4 rounded bg-[#6B4423]/10 text-[#6B4423] flex items-center justify-center text-[10px] font-black shrink-0 mt-0.5">✓</span>
              <span class="leading-snug">${item}</span>
            `;
            prepContainer.appendChild(row);
          });
        }

        if (notesContainer) {
          notesContainer.innerHTML = '';
          recipe.notes.forEach((n) => {
            const badge = document.createElement('span');
            badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold border flex items-center gap-1';
            badge.style.backgroundColor = `${n.color}15`;
            badge.style.borderColor = `${n.color}40`;
            badge.style.color = '#332B25';
            badge.innerHTML = `<span>${n.emoji}</span><span>${n.name}</span>`;
            notesContainer.appendChild(badge);
          });
        }

        renderDoseScale(activeDetailRecipe.coffee);
        if (detailModal) detailModal.classList.remove('hidden');
      }

      function renderDoseScale(newDose) {
        scaledCoffee = newDose;
        const factor = scaledCoffee / activeDetailRecipe.coffee;
        const scaledWater = Math.round(activeDetailRecipe.water * factor);

        // Update presets styling
        const presetBtns = document.querySelectorAll('.dose-preset-btn');
        presetBtns.forEach((btn) => {
          const d = parseInt(btn.getAttribute('data-dose') || '15', 10);
          if (d === scaledCoffee) {
            btn.className = 'dose-preset-btn py-1.5 rounded-lg border text-xs cursor-pointer transition-all bg-[#6B4423] text-white border-[#6B4423] shadow-xs';
          } else {
            btn.className = 'dose-preset-btn py-1.5 rounded-lg border text-xs cursor-pointer transition-all bg-[#F9F6F0] text-[#6F655D] border-[#E8DFD8] hover:bg-white';
          }
        });

        const waterEl = document.getElementById('detail-scaled-water');
        if (waterEl) waterEl.textContent = `${scaledWater}ml`;

        // Render steps breakdown
        const stepsContainer = document.getElementById('detail-modal-steps');
        if (stepsContainer) {
          stepsContainer.innerHTML = '';
          let cumWater = 0;
          activeDetailRecipe.steps.forEach((s, idx) => {
            const stepWater = Math.round(s.waterAdded * factor);
            cumWater += stepWater;
            const row = document.createElement('div');
            row.className = 'p-2 rounded-xl bg-[#F9F6F0] flex items-center justify-between text-[11px] font-semibold';
            row.innerHTML = `
              <div>
                <span class="font-bold text-[#332B25] block">${s.name}</span>
                <span class="text-[9.5px] text-[#8F857D]">${s.time}</span>
              </div>
              <div class="text-right">
                <span class="font-bold text-[#6B4423]">+${stepWater}g air</span>
                <span class="text-[9.5px] text-[#8F857D] block">Target: ${cumWater}g</span>
              </div>
            `;
            stepsContainer.appendChild(row);
          });
        }
      }

      // Dose presets click
      document.querySelectorAll('.dose-preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          audio.playClick();
          const dose = parseInt(btn.getAttribute('data-dose') || '15', 10);
          renderDoseScale(dose);
        });
      });

      // Close detail sheet
      document.getElementById('btn-close-recipe-detail')?.addEventListener('click', () => {
        audio.playClick();
        if (detailModal) detailModal.classList.add('hidden');
      });

      // Start brew from detail modal
      document.getElementById('btn-detail-start-brew')?.addEventListener('click', () => {
        audio.playClick();
        if (detailModal) detailModal.classList.add('hidden');
        // Build scaled recipe
        const factor = scaledCoffee / activeDetailRecipe.coffee;
        const scaledRecipe = JSON.parse(JSON.stringify(activeDetailRecipe));
        scaledRecipe.coffee = scaledCoffee;
        scaledRecipe.water = Math.round(activeDetailRecipe.water * factor);
        let cum = 0;
        scaledRecipe.steps.forEach((s) => {
          s.waterAdded = Math.round(s.waterAdded * factor);
          cum += s.waterAdded;
          s.waterTarget = cum;
        });

        loadRecipeToBrew(scaledRecipe);
      });

      // Card click opens detail sheet
      recipeCards.forEach((card) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('.btn-card-brew')) return; // handled separately
          audio.playClick();
          const id = card.getAttribute('data-recipe-id');
          const found = trialRecipes.find((r) => r.id === id);
          if (found) openRecipeDetail(found);
        });
      });

      // Direct brew button on card
      document.querySelectorAll('.btn-card-brew').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          audio.playClick();
          const id = btn.getAttribute('data-recipe-id');
          const found = trialRecipes.find((r) => r.id === id);
          if (found) loadRecipeToBrew(found);
        });
      });

      // ============================================================
      // GRINDER CONVERTER MODAL (BaristaUtils.grinderConversions)
      // ============================================================
      const grinderModal = document.getElementById('grinder-modal');
      const grinderList = document.getElementById('grinder-list-container');

      function calculateGrinderClicks(rawGrind) {
        const g = (rawGrind || 'Medium').toLowerCase();
        let c40 = 23;
        if (g.includes('super coarse')) c40 = 36;
        else if (g.includes('coarse')) c40 = 28;
        else if (g.includes('medium-fine')) c40 = 19;
        else if (g.includes('fine-medium')) c40 = 18;
        else if (g.includes('fine')) c40 = 15;

        return [
          { name: 'Comandante C40 MK3/MK4', val: `${c40} Klik`, note: 'Acuan Industri' },
          { name: 'Timemore C2 / C3 / Slim', val: `${Math.round(c40 * 0.72)} Klik`, note: 'Populer Indonesia' },
          { name: 'Timemore C3 ESP', val: `${Math.round(c40 * 2.5)} Klik`, note: 'Dial Luar Presisi' },
          { name: 'Vesper VS-3 Fold', val: `${Math.round(c40 * 2.8)} Setting`, note: 'Multi-Step Dial' },
          { name: 'MHW-3BOMBER Sonic / Race', val: `${Math.round(c40 * 0.82)} Klik`, note: 'CNC Burr' },
          { name: '1Zpresso K-Ultra / K-Max', val: `Angka ${(c40 * 0.32).toFixed(1)}`, note: 'External Ring' },
          { name: 'Fellow Ode Gen 2', val: `Dial ${(c40 * 0.22).toFixed(1)}`, note: 'Single Dose Flat' },
          { name: 'DF64 Gen 2', val: `${Math.round(c40 * 2.1)} Dial`, note: 'Flat Burr 64mm' },
          { name: 'Kingrinder K6', val: `${Math.round(c40 * 3.7)} Klik`, note: '16 Micron / Click' },
          { name: 'Baratza Encore', val: `Setting ${Math.round(c40 * 0.68)}`, note: 'Conical Electric' },
        ];
      }

      function openGrinderConverter(rawGrind) {
        const conversions = calculateGrinderClicks(rawGrind);
        if (grinderList) {
          grinderList.innerHTML = '';
          conversions.forEach((c) => {
            const row = document.createElement('div');
            row.className = 'p-2.5 rounded-xl bg-white border border-[#6B4423]/10 flex items-center justify-between shadow-2xs';
            row.innerHTML = `
              <div>
                <span class="font-bold text-xs text-[#332B25] block">${c.name}</span>
                <span class="text-[9.5px] text-[#8F857D]">${c.note}</span>
              </div>
              <span class="font-black text-xs text-[#6B4423] px-2 py-0.5 rounded-md bg-[#FFF4D6]">${c.val}</span>
            `;
            grinderList.appendChild(row);
          });
        }
        if (grinderModal) grinderModal.classList.remove('hidden');
      }

      document.getElementById('btn-open-grinder-sheet')?.addEventListener('click', () => {
        audio.playClick();
        openGrinderConverter(activeDetailRecipe.grindSize);
      });

      document.getElementById('btn-close-grinder')?.addEventListener('click', () => {
        audio.playClick();
        if (grinderModal) grinderModal.classList.add('hidden');
      });

      // ============================================================
      // BREW TIMER ENGINE & SIMULATION
      // ============================================================
      let currentRecipe = trialRecipes[0];
      let elapsedSeconds = 0;
      let timerInterval = null;
      let isRunning = false;
      let isPreparing = false;
      let prepSeconds = 3;
      let lastScrolledStepIndex = -1;

      // Multi-Color Step Palette matching Flutter brew_timer_screen.dart SegmentedTimerPainter
      const STEP_COLORS = [
        '#3B82F6', // Blue Accent (Flutter Colors.blueAccent)
        '#22C55E', // Green (Flutter Colors.green)
        '#F97316', // Orange Accent (Flutter Colors.orangeAccent)
        '#EC4899', // Pink Accent (Flutter Colors.pinkAccent)
        '#A855F7', // Purple Accent (Flutter Colors.purpleAccent)
        '#ECA400', // Amber (Flutter AppTheme.accentAmber)
        '#EF4444', // Red Accent (Flutter Colors.redAccent)
      ];

      function getStepColor(index) {
        return STEP_COLORS[index % STEP_COLORS.length];
      }

      function hexToRgba(hex, alpha) {
        const cleanHex = hex.replace('#', '');
        const r = parseInt(cleanHex.substring(0, 2), 16);
        const g = parseInt(cleanHex.substring(2, 4), 16);
        const b = parseInt(cleanHex.substring(4, 6), 16);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      }

      // Draw multi-color segmented circular timer matching Flutter CustomPainter
      function drawSegmentedTimer() {
        const canvas = document.getElementById('segmented-timer-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const dpr = window.devicePixelRatio || 2;
        const displaySize = canvas.clientWidth || 208;
        const targetPx = Math.round(displaySize * dpr);
        if (canvas.width !== targetPx || canvas.height !== targetPx) {
          canvas.width = targetPx;
          canvas.height = targetPx;
        }

        ctx.save();
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.scale(dpr, dpr);

        const cx = displaySize / 2;
        const cy = displaySize / 2;
        const strokeWidth = 14;
        const radius = cx - strokeWidth / 2 - 4;

        const steps = currentRecipe?.steps || [];
        const totalSeconds = currentRecipe?.totalSeconds || 1;

        // Base soft track background ring
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.strokeStyle = '#EFE5D8';
        ctx.lineWidth = strokeWidth;
        ctx.stroke();

        if (steps.length === 0 || totalSeconds <= 0) {
          ctx.restore();
          return;
        }

        let startAngle = -Math.PI / 2; // 12 o'clock (-90 deg)
        let currentElapsed = elapsedSeconds;

        for (let i = 0; i < steps.length; i++) {
          const step = steps[i];
          const stepSecs = (step.duration || (step.end - step.start) || 1);
          const sweepAngle = (stepSecs / totalSeconds) * 2 * Math.PI;
          const stepColor = getStepColor(i);

          // Small gap between step segments (matching Flutter sweepAngle - 0.05)
          const gap = steps.length > 1 ? 0.045 : 0;
          const segmentSweep = Math.max(0.01, sweepAngle - gap);

          // 1. Faint step track segment background
          ctx.beginPath();
          ctx.arc(cx, cy, radius, startAngle, startAngle + segmentSweep);
          ctx.strokeStyle = hexToRgba(stepColor, 0.22);
          ctx.lineWidth = strokeWidth;
          ctx.lineCap = 'butt';
          ctx.stroke();

          // 2. Filled progress arc for this step
          if (currentElapsed > 0) {
            const filledSecs = Math.min(currentElapsed, stepSecs);
            const filledSweepAngle = (filledSecs / totalSeconds) * 2 * Math.PI;

            if (filledSweepAngle > 0) {
              ctx.beginPath();
              const actualFilled = Math.min(filledSweepAngle, segmentSweep);
              ctx.arc(cx, cy, radius, startAngle, startAngle + actualFilled);
              ctx.strokeStyle = stepColor;
              ctx.lineWidth = strokeWidth + 2;
              ctx.lineCap = filledSecs >= stepSecs ? 'butt' : 'round';
              ctx.stroke();
            }
            currentElapsed -= filledSecs;
          }

          startAngle += sweepAngle;
        }

        ctx.restore();
      }

      window.addEventListener('resize', () => {
        drawSegmentedTimer();
      });

      function scrollToStep(index) {
        const container = document.getElementById('brew-steps-container');
        if (!container) return;
        const cards = container.querySelectorAll('.step-item');
        const targetCard = cards[index];
        if (!targetCard) return;

        if (index === 0) {
          container.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        // Auto-scroll so targetCard is positioned directly at the top of the step-by-step list
        const containerRect = container.getBoundingClientRect();
        const cardRect = targetCard.getBoundingClientRect();
        const relativeDistance = cardRect.top - containerRect.top;
        const targetScrollTop = container.scrollTop + relativeDistance;

        container.scrollTo({
          top: Math.max(0, targetScrollTop),
          behavior: 'smooth'
        });
      }

      function jumpToStep(targetIndex) {
        if (!currentRecipe || !currentRecipe.steps || currentRecipe.steps.length === 0) return;
        const clamped = Math.max(0, Math.min(targetIndex, currentRecipe.steps.length - 1));
        const startSec = currentRecipe.steps[clamped].start || 0;
        elapsedSeconds = startSec;
        updateTimerDisplay();
        lastScrolledStepIndex = clamped;
        scrollToStep(clamped);
      }

      function renderBrewSteps(recipe) {
        const container = document.getElementById('brew-steps-container');
        if (!container) return;
        container.innerHTML = '';

        recipe.steps.forEach((step, idx) => {
          const isActive = idx === 0;
          const stepColor = getStepColor(idx);
          const card = document.createElement('div');
          card.className = `step-item p-3 rounded-2xl border transition-all duration-300 cursor-pointer ${
            isActive
              ? 'bg-[#6B4423] text-white border-[#ECA400] shadow-md ring-2 ring-[#ECA400]/40'
              : 'bg-white text-[#332B25] border-[#E8DFD8] shadow-xs hover:border-[#6B4423]/30'
          }`;
          card.setAttribute('data-step-idx', idx);

          card.innerHTML = `
            <div class="flex items-start gap-3">
              <!-- Step Number Indicator matching Segment Color -->
              <div class="step-num-badge w-7 h-7 rounded-full flex items-center justify-center font-black text-xs shrink-0 transition-colors shadow-xs ${
                isActive ? 'bg-[#ECA400] text-[#1E1612]' : ''
              }" style="${!isActive ? `background-color: ${hexToRgba(stepColor, 0.15)}; color: ${stepColor};` : ''}">
                ${idx + 1}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-1">
                  <span class="step-title font-bold text-xs truncate ${isActive ? 'text-white' : 'text-[#332B25]'}">${step.name}</span>
                  <span class="step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md shrink-0 ${
                    isActive ? 'bg-white/20 text-white' : 'bg-[#F9F6F0] text-[#6F655D]'
                  }">${step.time}</span>
                </div>
                <p class="step-desc text-[11px] mt-1 leading-snug ${isActive ? 'text-amber-100/90' : 'text-[#6F655D]'}">${step.desc}</p>
                <div class="step-water-row flex items-center justify-between text-[11px] font-bold mt-2 pt-1.5 border-t ${
                  isActive ? 'border-white/20 text-amber-300' : 'border-[#E8DFD8] text-[#6B4423]'
                }">
                  <span>+${step.waterAdded}g air</span>
                  <span>Target: ${step.waterTarget}g</span>
                </div>
              </div>
            </div>
          `;

          // Tap card to jump to this step
          card.addEventListener('click', () => {
            audio.playClick();
            jumpToStep(idx);
          });

          container.appendChild(card);
        });

        // Extra bottom spacer so the last step can scroll completely to the top without being cut off
        const bottomSpacer = document.createElement('div');
        bottomSpacer.className = 'h-48 shrink-0 pointer-events-none';
        bottomSpacer.setAttribute('aria-hidden', 'true');
        container.appendChild(bottomSpacer);
      }

      function updateStepHighlights() {
        const container = document.getElementById('brew-steps-container');
        if (!container) return;
        const cards = container.querySelectorAll('.step-item');
        let activeIdx = 0;

        currentRecipe.steps.forEach((step, idx) => {
          if (elapsedSeconds >= step.start && elapsedSeconds < step.end) {
            activeIdx = idx;
          }
        });

        const isFinished = elapsedSeconds >= currentRecipe.totalSeconds && currentRecipe.totalSeconds > 0;

        cards.forEach((card, idx) => {
          const badge = card.querySelector('.step-num-badge');
          const title = card.querySelector('.step-title');
          const desc = card.querySelector('.step-desc');
          const timeBadge = card.querySelector('.step-time-badge');
          const waterRow = card.querySelector('.step-water-row');
          const stepColor = getStepColor(idx);

          if (!isFinished && idx === activeIdx) {
            card.className = 'step-item p-3 rounded-2xl border transition-all duration-300 cursor-pointer bg-[#6B4423] text-white border-[#ECA400] shadow-md ring-2 ring-[#ECA400]/40';
            if (badge) {
              badge.className = 'step-num-badge w-7 h-7 rounded-full flex items-center justify-center font-black text-xs shrink-0 transition-colors shadow-xs bg-[#ECA400] text-[#1E1612]';
              badge.textContent = String(idx + 1);
              badge.style.backgroundColor = '';
              badge.style.color = '';
            }
            if (title) title.className = 'step-title font-bold text-xs truncate text-white';
            if (desc) desc.className = 'step-desc text-[11px] mt-1 leading-snug text-amber-100/90';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md shrink-0 bg-white/20 text-white';
            if (waterRow) waterRow.className = 'step-water-row flex items-center justify-between text-[11px] font-bold mt-2 pt-1.5 border-t border-white/20 text-amber-300';
          } else if (isFinished || idx < activeIdx) {
            card.className = 'step-item p-3 rounded-2xl border transition-all duration-300 cursor-pointer bg-[#F1E8E0]/70 text-[#6F655D] border-[#E8DFD8] opacity-85';
            if (badge) {
              badge.className = 'step-num-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 transition-colors shadow-xs bg-[#16A34A] text-white';
              badge.innerHTML = '✓';
              badge.style.backgroundColor = '';
              badge.style.color = '';
            }
            if (title) title.className = 'step-title font-bold text-xs truncate text-[#332B25]';
            if (desc) desc.className = 'step-desc text-[11px] mt-1 leading-snug text-[#8F857D]';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md shrink-0 bg-white text-[#8F857D]';
            if (waterRow) waterRow.className = 'step-water-row flex items-center justify-between text-[11px] font-bold mt-2 pt-1.5 border-t border-[#E8DFD8] text-[#8F857D]';
          } else {
            card.className = 'step-item p-3 rounded-2xl border transition-all duration-300 cursor-pointer bg-white text-[#332B25] border-[#E8DFD8] shadow-xs hover:border-[#6B4423]/30';
            if (badge) {
              badge.className = 'step-num-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 transition-colors shadow-xs';
              badge.textContent = String(idx + 1);
              badge.style.backgroundColor = hexToRgba(stepColor, 0.15);
              badge.style.color = stepColor;
            }
            if (title) title.className = 'step-title font-bold text-xs truncate text-[#332B25]';
            if (desc) desc.className = 'step-desc text-[11px] mt-1 leading-snug text-[#6F655D]';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md shrink-0 bg-[#F9F6F0] text-[#6F655D]';
            if (waterRow) waterRow.className = 'step-water-row flex items-center justify-between text-[11px] font-bold mt-2 pt-1.5 border-t border-[#E8DFD8] text-[#6B4423]';
          }
        });

        const counter = document.getElementById('current-step-counter');
        if (counter) {
          counter.textContent = `Tahap ${activeIdx + 1} dari ${currentRecipe.steps.length}`;
        }

        // Auto-scroll when active step changes
        if (activeIdx !== lastScrolledStepIndex) {
          lastScrolledStepIndex = activeIdx;
          scrollToStep(activeIdx);
        }
      }

      function updateTimerDisplay() {
        const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
        const s = String(elapsedSeconds % 60).padStart(2, '0');
        const display = document.getElementById('timer-display');
        if (display) {
          display.textContent = `${m}:${s}`;
          // Check ending soon (red countdown like mobile)
          let endingSoon = false;
          currentRecipe.steps.forEach((step) => {
            const left = step.end - elapsedSeconds;
            if (left <= 3 && left > 0) endingSoon = true;
          });
          if (endingSoon) {
            display.classList.add('text-red-600');
            display.classList.remove('text-[#6B4423]');
          } else {
            display.classList.remove('text-red-600');
            display.classList.add('text-[#6B4423]');
          }
        }

        // Segmented multi-color circle drawing
        drawSegmentedTimer();

        updateStepHighlights();
      }

      function loadRecipeToBrew(recipe) {
        currentRecipe = recipe;
        resetTimer();

        const titleEl = document.getElementById('active-recipe-title');
        const authorEl = document.getElementById('active-recipe-author');
        const targetText = document.getElementById('timer-target-text');
        const icedBanner = document.getElementById('brew-iced-banner');

        if (titleEl) titleEl.textContent = recipe.title;
        if (authorEl) authorEl.textContent = `${recipe.author} · ${recipe.category}`;
        if (targetText) {
          const m = String(Math.floor(recipe.totalSeconds / 60)).padStart(2, '0');
          const s = String(recipe.totalSeconds % 60).padStart(2, '0');
          targetText.textContent = `Target ${m}:${s} · ${recipe.isIced ? `${recipe.water}ml air + ${recipe.ice}g es` : `${recipe.water}ml`}`;
        }

        if (icedBanner) {
          if (recipe.isIced) icedBanner.classList.remove('hidden');
          else icedBanner.classList.add('hidden');
        }

        // Update Coffee Bean & Brewing Parameters Bar (#brew-bean-bar)
        const barBean = document.getElementById('brew-bar-bean');
        const barRoast = document.getElementById('brew-bar-roast');
        const barVariety = document.getElementById('brew-bar-variety');
        const barProcess = document.getElementById('brew-bar-process');
        const barTemp = document.getElementById('brew-bar-temp');

        if (barBean) barBean.textContent = recipe.beanName || 'Biji Kopi Spesialti';
        if (barRoast) barRoast.textContent = recipe.roast || 'Medium Light';
        if (barVariety) barVariety.textContent = `🌱 ${recipe.variety || 'Arabica'}`;
        if (barProcess) barProcess.textContent = `☀️ ${recipe.process || 'Washed'}`;
        if (barTemp) barTemp.textContent = `🌡️ ${recipe.temp}°C (${recipe.ratio})`;

        renderBrewSteps(recipe);
        drawSegmentedTimer();
        switchTab('brew');
        scrollToStep(0);
      }

      function startPreparation() {
        isPreparing = true;
        prepSeconds = 3;

        document.getElementById('running-view')?.classList.add('hidden');
        document.getElementById('finished-view')?.classList.add('hidden');
        document.getElementById('prep-view')?.classList.remove('hidden');
        document.getElementById('prep-view')?.classList.add('flex');

        const prepNumEl = document.getElementById('prep-number');
        if (prepNumEl) prepNumEl.textContent = '3';
        audio.playTick();

        const prepInterval = setInterval(() => {
          prepSeconds--;
          if (prepSeconds > 0) {
            audio.playTick();
            if (prepNumEl) prepNumEl.textContent = String(prepSeconds);
          } else {
            clearInterval(prepInterval);
            isPreparing = false;
            document.getElementById('prep-view')?.classList.add('hidden');
            document.getElementById('prep-view')?.classList.remove('flex');
            document.getElementById('running-view')?.classList.remove('hidden');
            audio.playTransition();
            startMainBrew();
          }
        }, 1000);

        // Skip prep handler
        document.getElementById('btn-skip-prep')?.addEventListener('click', () => {
          clearInterval(prepInterval);
          isPreparing = false;
          document.getElementById('prep-view')?.classList.add('hidden');
          document.getElementById('prep-view')?.classList.remove('flex');
          document.getElementById('running-view')?.classList.remove('hidden');
          audio.playTransition();
          startMainBrew();
        }, { once: true });
      }

      function startMainBrew() {
        isRunning = true;
        audio.startBgm();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[9px] font-bold border border-emerald-300 flex items-center gap-1.5';
          statusText.textContent = 'LIVE SEDUH';
        }
        if (playLabel) playLabel.textContent = 'Jeda';

        timerInterval = setInterval(() => {
          if (elapsedSeconds < currentRecipe.totalSeconds) {
            elapsedSeconds++;
            updateTimerDisplay();

            // Sound cue triggers
            currentRecipe.steps.forEach((step) => {
              const remaining = step.end - elapsedSeconds;
              if (remaining <= 3 && remaining > 0) {
                audio.playTick();
              } else if (remaining === 0 && elapsedSeconds !== currentRecipe.totalSeconds) {
                audio.playTransition();
              }
            });
          } else {
            finishBrew();
          }
        }, 1000);
      }

      function pauseTimer() {
        isRunning = false;
        clearInterval(timerInterval);
        audio.stopBgm();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[9px] font-bold border border-amber-300 flex items-center gap-1.5';
          statusText.textContent = 'DIJEDA';
        }
        if (playLabel) playLabel.textContent = 'Lanjutkan';
      }

      function resetTimer() {
        isRunning = false;
        isPreparing = false;
        clearInterval(timerInterval);
        audio.stopBgm();
        elapsedSeconds = 0;
        lastScrolledStepIndex = 0;

        document.getElementById('prep-view')?.classList.add('hidden');
        document.getElementById('prep-view')?.classList.remove('flex');
        document.getElementById('finished-view')?.classList.add('hidden');
        document.getElementById('running-view')?.classList.remove('hidden');

        updateTimerDisplay();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[9px] font-bold border border-amber-200 flex items-center gap-1.5';
          statusText.textContent = 'SIAP SEDUH';
        }
        if (playLabel) playLabel.textContent = 'Mulai Seduh';

        scrollToStep(0);
      }

      function finishBrew() {
        isRunning = false;
        clearInterval(timerInterval);
        audio.stopBgm();
        audio.playEnjoy();

        document.getElementById('running-view')?.classList.add('hidden');
        document.getElementById('finished-view')?.classList.remove('hidden');
        document.getElementById('finished-view')?.classList.add('flex');

        const modal = document.getElementById('brew-completed-modal');
        const timeStat = document.getElementById('finish-time-stat');
        const waterStat = document.getElementById('finish-water-stat');

        const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
        const s = String(elapsedSeconds % 60).padStart(2, '0');

        if (timeStat) timeStat.textContent = `Waktu: ${m}:${s}`;
        if (waterStat) waterStat.textContent = `Air: ${currentRecipe.water}ml`;
        if (modal) modal.classList.remove('hidden');
      }

      // Play / Pause Button
      document.getElementById('btn-play-pause-timer')?.addEventListener('click', () => {
        audio.playClick();
        if (isRunning) {
          pauseTimer();
        } else {
          if (elapsedSeconds === 0) startPreparation();
          else startMainBrew();
        }
      });

      // Reset Button
      document.getElementById('btn-reset-timer')?.addEventListener('click', () => {
        audio.playClick();
        resetTimer();
      });

      // +10s Button
      document.getElementById('btn-add-10s')?.addEventListener('click', () => {
        audio.playClick();
        currentRecipe.totalSeconds += 10;
        // Extend last step by 10s
        if (currentRecipe.steps.length > 0) {
          currentRecipe.steps[currentRecipe.steps.length - 1].end += 10;
        }
        updateTimerDisplay();
      });

      // Skip step button (Advances directly to next step and auto-scrolls)
      document.getElementById('btn-skip-step')?.addEventListener('click', () => {
        audio.playClick();
        const curIdx = currentRecipe.steps.findIndex((s) => elapsedSeconds >= s.start && elapsedSeconds < s.end);
        if (curIdx >= 0 && curIdx < currentRecipe.steps.length - 1) {
          jumpToStep(curIdx + 1);
          audio.playTransition();
        } else if (curIdx === currentRecipe.steps.length - 1 || elapsedSeconds >= currentRecipe.totalSeconds) {
          finishBrew();
        }
      });

      // Back to recipes button
      document.getElementById('brew-back-to-recipes')?.addEventListener('click', () => {
        audio.playClick();
        switchTab('recipes');
      });

      // Tap bean bar to open full Recipe Details modal
      document.getElementById('brew-bean-bar')?.addEventListener('click', () => {
        audio.playClick();
        if (currentRecipe) openRecipeDetail(currentRecipe);
      });

      // ============================================================
      // THERMAL RECEIPT SHEET LOGIC
      // ============================================================
      const thermalModal = document.getElementById('thermal-receipt-modal');

      function openThermalReceipt(recipe) {
        const titleEl = document.getElementById('receipt-title');
        const ratioEl = document.getElementById('receipt-ratio');
        const dosesEl = document.getElementById('receipt-doses');
        const tempEl = document.getElementById('receipt-temp');
        const stagesContainer = document.getElementById('receipt-stages');

        if (titleEl) titleEl.textContent = recipe.title;
        if (ratioEl) ratioEl.textContent = `Rasio: ${recipe.ratio}`;
        if (dosesEl) dosesEl.textContent = `${recipe.coffee}g kopi / ${recipe.water}ml air`;
        if (tempEl) tempEl.textContent = `Suhu: ${recipe.temp}°C`;

        if (stagesContainer) {
          stagesContainer.innerHTML = '';
          recipe.steps.forEach((s) => {
            const row = document.createElement('div');
            row.className = 'flex justify-between';
            row.innerHTML = `
              <span class="truncate max-w-[140px]">${s.name}</span>
              <span>+${s.waterAdded}g (${s.time})</span>
            `;
            stagesContainer.appendChild(row);
          });
        }

        if (thermalModal) thermalModal.classList.remove('hidden');
      }

      document.getElementById('btn-open-thermal-sheet')?.addEventListener('click', () => {
        audio.playClick();
        openThermalReceipt(currentRecipe);
      });

      document.getElementById('btn-close-receipt')?.addEventListener('click', () => {
        audio.playClick();
        if (thermalModal) thermalModal.classList.add('hidden');
      });

      document.getElementById('btn-modal-print-receipt')?.addEventListener('click', () => {
        audio.playClick();
        document.getElementById('brew-completed-modal')?.classList.add('hidden');
        openThermalReceipt(currentRecipe);
      });

      // ============================================================
      // BREW DOCTOR SHEET LOGIC
      // ============================================================
      const doctorModal = document.getElementById('brew-doctor-modal');

      document.getElementById('btn-open-brew-doctor-sheet')?.addEventListener('click', () => {
        audio.playClick();
        if (doctorModal) doctorModal.classList.remove('hidden');
      });

      document.getElementById('btn-close-brew-doctor')?.addEventListener('click', () => {
        audio.playClick();
        if (doctorModal) doctorModal.classList.add('hidden');
      });

      // ============================================================
      // CELEBRATION FINISH MODAL BUTTONS
      // ============================================================
      document.getElementById('btn-modal-brew-again')?.addEventListener('click', () => {
        audio.playClick();
        document.getElementById('brew-completed-modal')?.classList.add('hidden');
        resetTimer();
        startPreparation();
      });

      document.getElementById('btn-modal-back-recipes')?.addEventListener('click', () => {
        audio.playClick();
        document.getElementById('brew-completed-modal')?.classList.add('hidden');
        resetTimer();
        switchTab('recipes');
      });

      // Initialize with first recipe
      renderBrewSteps(currentRecipe);
      drawSegmentedTimer();
      updateTimerDisplay();
    </script>

  </body>
</html>
