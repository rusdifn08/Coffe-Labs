    <!-- Embedded Client Application Logic (Audio Engine, Timer, Tabs, State) -->
    <script define:vars={{ trialRecipes }}>
      // 1. Audio Engine using Web Audio API + HTML5 Audio
      class AudioEngine {
        constructor() {
          this.muted = false;
          this.bgmAudio = null;
          this.sfxAudio = null;
          this.audioContext = null;
          this.init();
        }

        init() {
          try {
            this.bgmAudio = new Audio('/audio/calm_music.m4a');
            this.bgmAudio.loop = true;
            this.bgmAudio.volume = 0.35;
          } catch (e) {
            console.warn('BGM Audio init warning:', e);
          }
        }

        getAudioContext() {
          if (!this.audioContext) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) this.audioContext = new AudioCtx();
          }
          if (this.audioContext && this.audioContext.state === 'suspended') {
            this.audioContext.resume();
          }
          return this.audioContext;
        }

        playFile(url, volume = 0.7) {
          if (this.muted) return;
          try {
            const a = new Audio(url);
            a.volume = volume;
            a.play().catch(() => {
              // Fallback to web audio beep if browser blocks file
              this.fallbackBeep();
            });
          } catch (_) {
            this.fallbackBeep();
          }
        }

        playClick() {
          this.playFile('/audio/click.wav', 0.5);
        }

        playTick() {
          this.playFile('/audio/tick.wav', 0.6);
        }

        playTransition() {
          this.playFile('/audio/transition.wav', 0.85);
        }

        playEnjoy() {
          this.playFile('/audio/enjoy.wav', 1.0);
        }

        startBgm() {
          if (this.muted || !this.bgmAudio) return;
          try {
            this.bgmAudio.currentTime = 0;
            this.bgmAudio.play().then(() => {
              document.getElementById('soundwave-bar')?.classList.remove('hidden');
              document.getElementById('soundwave-bar')?.classList.add('flex');
            }).catch((err) => {
              console.warn('Autoplay blocked until user gesture:', err);
            });
          } catch (_) {}
        }

        stopBgm() {
          if (!this.bgmAudio) return;
          try {
            this.bgmAudio.pause();
            this.bgmAudio.currentTime = 0;
            document.getElementById('soundwave-bar')?.classList.add('hidden');
            document.getElementById('soundwave-bar')?.classList.remove('flex');
          } catch (_) {}
        }

        toggleMute() {
          this.muted = !this.muted;
          if (this.muted) {
            this.stopBgm();
          }
          return this.muted;
        }

        fallbackBeep(freq = 600, duration = 0.08) {
          try {
            const ctx = this.getAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
          } catch (_) {}
        }
      }

      const audio = new AudioEngine();

      // Audio Toggle Button
      const audioToggleBtn = document.getElementById('audio-toggle-btn');
      const audioLabel = document.getElementById('audio-label');
      if (audioToggleBtn) {
        audioToggleBtn.addEventListener('click', () => {
          const isMuted = audio.toggleMute();
          if (isMuted) {
            audioLabel.textContent = 'Muted 🔇';
            audioToggleBtn.classList.add('opacity-60');
          } else {
            audioLabel.textContent = 'BGM & SFX';
            audioToggleBtn.classList.remove('opacity-60');
            audio.playClick();
          }
        });
      }

      // Live Clock
      function updateClock() {
        const now = new Date();
        const clockEl = document.getElementById('live-clock');
        if (clockEl) {
          clockEl.textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      // Tab Switching
      const tabButtons = document.querySelectorAll('.bottom-tab-btn');
      const tabContents = {
        recipes: document.getElementById('tab-content-recipes'),
        brew: document.getElementById('tab-content-brew'),
        radar: document.getElementById('tab-content-radar'),
        social: document.getElementById('tab-content-social'),
        toolkit: document.getElementById('tab-content-toolkit'),
      };

      function switchTab(targetTab) {
        audio.playClick();
        tabButtons.forEach((btn) => {
          const tab = btn.getAttribute('data-tab');
          if (tab === targetTab) {
            btn.classList.add('text-[#6B4423]', 'font-bold');
            btn.classList.remove('text-[#8F857D]', 'text-gray-400');
          } else {
            btn.classList.remove('text-[#6B4423]', 'font-bold');
            if (tab === 'radar' || tab === 'social' || tab === 'toolkit') {
              btn.classList.add('text-gray-400');
            } else {
              btn.classList.add('text-[#8F857D]');
            }
          }
        });

        Object.keys(tabContents).forEach((tab) => {
          if (tab === targetTab) {
            tabContents[tab]?.classList.remove('hidden');
            tabContents[tab]?.classList.add('block');
          } else {
            tabContents[tab]?.classList.add('hidden');
            tabContents[tab]?.classList.remove('block');
          }
        });
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');
          switchTab(tab);
        });
      });

      // Recipe Search & Category Filters
      const searchInput = document.getElementById('recipe-search-input');
      const catPills = document.querySelectorAll('.cat-pill');
      const recipeCards = document.querySelectorAll('.recipe-card');

      let currentCategory = 'ALL';
      let searchQuery = '';

      function filterRecipeList() {
        recipeCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const title = card.querySelector('h4')?.textContent.toLowerCase() || '';
          const author = card.querySelector('.truncate')?.textContent.toLowerCase() || '';

          const matchCat = currentCategory === 'ALL' || cardCat === currentCategory;
          const matchQuery = !searchQuery || title.includes(searchQuery) || author.includes(searchQuery);

          if (matchCat && matchQuery) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.toLowerCase().trim();
          filterRecipeList();
        });
      }

      catPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          audio.playClick();
          catPills.forEach((p) => {
            p.classList.remove('bg-[#6B4423]', 'text-white');
            p.classList.add('bg-white', 'text-[#6F655D]');
          });
          pill.classList.add('bg-[#6B4423]', 'text-white');
          pill.classList.remove('bg-white', 'text-[#6F655D]');
          currentCategory = pill.getAttribute('data-category') || 'ALL';
          filterRecipeList();
        });
      });

      // ===============================================
      // BREW TIMER ENGINE & SIMULATION
      // ===============================================
      let currentRecipe = trialRecipes[0];
      let elapsedSeconds = 0;
      let timerInterval = null;
      let isRunning = false;
      let isPreparing = false;
      let prepSeconds = 3;

      function renderBrewSteps(recipe) {
        const container = document.getElementById('brew-steps-container');
        if (!container) return;
        container.innerHTML = '';

        recipe.steps.forEach((step, idx) => {
          const isActive = idx === 0;
          const card = document.createElement('div');
          card.className = `step-item p-2.5 rounded-xl border transition-all duration-300 ${
            isActive
              ? 'bg-[#6B4423] text-white border-[#6B4423] shadow-md ring-1 ring-[#6B4423]/40'
              : 'bg-white text-[#332B25] border-[#E8DFD8] shadow-xs'
          }`;
          card.setAttribute('data-step-idx', idx);

          card.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs truncate max-w-[170px]">${step.name}</span>
              <span class="step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md ${
                isActive ? 'bg-white/20 text-white' : 'bg-[#F9F6F0] text-[#6F655D]'
              }">${step.time}</span>
            </div>
            <p class="step-desc text-[10.5px] mt-1 ${isActive ? 'text-amber-100/90' : 'text-[#6F655D]'}">${step.desc}</p>
            <div class="flex items-center justify-between text-[10.5px] font-bold mt-1.5 pt-1.5 border-t ${
              isActive ? 'border-white/20 text-amber-200' : 'border-[#E8DFD8] text-[#6B4423]'
            }">
              <span>+${step.waterAdded}g air</span>
              <span>Target: ${step.waterTarget}g</span>
            </div>
          `;
          container.appendChild(card);
        });
      }

      function updateStepHighlights() {
        const container = document.getElementById('brew-steps-container');
        if (!container) return;
        const cards = container.querySelectorAll('.step-item');
        let activeIdx = 0;

        currentRecipe.steps.forEach((step, idx) => {
          if (elapsedSeconds >= step.start && elapsedSeconds < step.end) {
            activeIdx = idx;
          }
        });

        cards.forEach((card, idx) => {
          const desc = card.querySelector('.step-desc');
          const timeBadge = card.querySelector('.step-time-badge');
          const bottomRow = card.lastElementChild;

          if (idx === activeIdx) {
            card.className = 'step-item p-2.5 rounded-xl border transition-all duration-300 bg-[#6B4423] text-white border-[#6B4423] shadow-md ring-1 ring-[#6B4423]/40';
            if (desc) desc.className = 'step-desc text-[10.5px] mt-1 text-amber-100/90';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md bg-white/20 text-white';
            if (bottomRow) bottomRow.className = 'flex items-center justify-between text-[10.5px] font-bold mt-1.5 pt-1.5 border-t border-white/20 text-amber-200';
          } else if (idx < activeIdx) {
            card.className = 'step-item p-2.5 rounded-xl border transition-all duration-300 bg-[#F1E8E0]/70 text-[#6F655D] border-[#E8DFD8] opacity-80';
            if (desc) desc.className = 'step-desc text-[10.5px] mt-1 text-[#8F857D]';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md bg-white text-[#8F857D]';
            if (bottomRow) bottomRow.className = 'flex items-center justify-between text-[10.5px] font-bold mt-1.5 pt-1.5 border-t border-[#E8DFD8] text-[#8F857D]';
          } else {
            card.className = 'step-item p-2.5 rounded-xl border transition-all duration-300 bg-white text-[#332B25] border-[#E8DFD8] shadow-xs';
            if (desc) desc.className = 'step-desc text-[10.5px] mt-1 text-[#6F655D]';
            if (timeBadge) timeBadge.className = 'step-time-badge text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#F9F6F0] text-[#6F655D]';
            if (bottomRow) bottomRow.className = 'flex items-center justify-between text-[10.5px] font-bold mt-1.5 pt-1.5 border-t border-[#E8DFD8] text-[#6B4423]';
          }
        });

        const counter = document.getElementById('current-step-counter');
        if (counter) {
          counter.textContent = `Tahap ${activeIdx + 1} dari ${currentRecipe.steps.length}`;
        }
      }

      function updateTimerDisplay() {
        const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
        const s = String(elapsedSeconds % 60).padStart(2, '0');
        const display = document.getElementById('timer-display');
        if (display) display.textContent = `${m}:${s}`;

        // Ring progress
        const circle = document.getElementById('timer-svg-circle');
        if (circle && currentRecipe.totalSeconds > 0) {
          const totalLength = 264;
          const ratio = Math.min(1, elapsedSeconds / currentRecipe.totalSeconds);
          circle.style.strokeDashoffset = String(totalLength - (totalLength * ratio));
        }

        updateStepHighlights();
      }

      function loadRecipeToBrew(recipe) {
        currentRecipe = recipe;
        resetTimer();
        const titleEl = document.getElementById('active-recipe-title');
        const authorEl = document.getElementById('active-recipe-author');
        const targetText = document.getElementById('timer-target-text');

        if (titleEl) titleEl.textContent = recipe.title;
        if (authorEl) authorEl.textContent = `${recipe.author} · ${recipe.category}`;
        if (targetText) {
          const m = String(Math.floor(recipe.totalSeconds / 60)).padStart(2, '0');
          const s = String(recipe.totalSeconds % 60).padStart(2, '0');
          targetText.textContent = `Target ${m}:${s} · ${recipe.water}`;
        }

        renderBrewSteps(recipe);
        switchTab('brew');
      }

      function startPreparation() {
        isPreparing = true;
        prepSeconds = 3;
        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const display = document.getElementById('timer-display');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-[8.5px] font-bold border border-blue-300 flex items-center gap-1';
          statusText.textContent = 'SIAPKAN AIR...';
        }

        audio.playTick();
        if (display) display.textContent = `00:0${prepSeconds}`;

        const prepInterval = setInterval(() => {
          prepSeconds--;
          if (prepSeconds > 0) {
            audio.playTick();
            if (display) display.textContent = `00:0${prepSeconds}`;
          } else {
            clearInterval(prepInterval);
            isPreparing = false;
            audio.playTransition();
            startMainBrew();
          }
        }, 1000);
      }

      function startMainBrew() {
        isRunning = true;
        audio.startBgm();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[8.5px] font-bold border border-emerald-300 flex items-center gap-1';
          statusText.textContent = 'LIVE SEDUH';
        }
        if (playLabel) playLabel.textContent = 'Jeda';

        timerInterval = setInterval(() => {
          if (elapsedSeconds < currentRecipe.totalSeconds) {
            elapsedSeconds++;
            updateTimerDisplay();

            // Sound cues check
            currentRecipe.steps.forEach((step) => {
              const remaining = step.end - elapsedSeconds;
              if (remaining <= 3 && remaining > 0) {
                audio.playTick();
              } else if (remaining === 0 && elapsedSeconds !== currentRecipe.totalSeconds) {
                audio.playTransition();
              }
            });
          } else {
            finishBrew();
          }
        }, 1000);
      }

      function pauseTimer() {
        isRunning = false;
        clearInterval(timerInterval);
        audio.stopBgm();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[8.5px] font-bold border border-amber-300 flex items-center gap-1';
          statusText.textContent = 'DIJEDA';
        }
        if (playLabel) playLabel.textContent = 'Lanjutkan';
      }

      function resetTimer() {
        isRunning = false;
        isPreparing = false;
        clearInterval(timerInterval);
        audio.stopBgm();
        elapsedSeconds = 0;
        updateTimerDisplay();

        const statusBadge = document.getElementById('timer-status-badge');
        const statusText = document.getElementById('timer-status-text');
        const playLabel = document.getElementById('play-pause-label');

        if (statusBadge && statusText) {
          statusBadge.className = 'mt-1.5 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[8.5px] font-bold border border-amber-200 flex items-center gap-1';
          statusText.textContent = 'SIAP SEDUH';
        }
        if (playLabel) playLabel.textContent = 'Mulai Seduh';
      }

      function finishBrew() {
        isRunning = false;
        clearInterval(timerInterval);
        audio.stopBgm();
        audio.playEnjoy();

        const modal = document.getElementById('brew-completed-modal');
        const timeStat = document.getElementById('finish-time-stat');
        const waterStat = document.getElementById('finish-water-stat');

        const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
        const s = String(elapsedSeconds % 60).padStart(2, '0');

        if (timeStat) timeStat.textContent = `Waktu: ${m}:${s}`;
        if (waterStat) waterStat.textContent = `Air: ${currentRecipe.water}`;
        if (modal) modal.classList.remove('hidden');
      }

      // Play/Pause button event
      const playPauseBtn = document.getElementById('btn-play-pause-timer');
      if (playPauseBtn) {
        playPauseBtn.addEventListener('click', () => {
          audio.playClick();
          if (isRunning) {
            pauseTimer();
          } else {
            if (elapsedSeconds === 0) {
              startPreparation();
            } else {
              startMainBrew();
            }
          }
        });
      }

      // Reset button event
      const resetBtn = document.getElementById('btn-reset-timer');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          audio.playClick();
          resetTimer();
        });
      }

      // Skip step button event
      const skipBtn = document.getElementById('btn-skip-step');
      if (skipBtn) {
        skipBtn.addEventListener('click', () => {
          audio.playClick();
          let currentStep = currentRecipe.steps.find((s) => elapsedSeconds >= s.start && elapsedSeconds < s.end);
          if (currentStep) {
            elapsedSeconds = currentStep.end;
            updateTimerDisplay();
            audio.playTransition();
          }
        });
      }

      // Recipe card click handlers
      recipeCards.forEach((card) => {
        card.addEventListener('click', () => {
          audio.playClick();
          const recipeId = card.getAttribute('data-recipe-id');
          const found = trialRecipes.find((r) => r.id === recipeId);
          if (found) {
            loadRecipeToBrew(found);
          }
        });
      });

      // Back to recipes button in brew tab
      const backToRecipesBtn = document.getElementById('brew-back-to-recipes');
      if (backToRecipesBtn) {
        backToRecipesBtn.addEventListener('click', () => {
          audio.playClick();
          switchTab('recipes');
        });
      }

      // Modal buttons
      const modalBrewAgain = document.getElementById('btn-modal-brew-again');
      const modalBackRecipes = document.getElementById('btn-modal-back-recipes');
      const modal = document.getElementById('brew-completed-modal');

      if (modalBrewAgain) {
        modalBrewAgain.addEventListener('click', () => {
          audio.playClick();
          if (modal) modal.classList.add('hidden');
          resetTimer();
          startPreparation();
        });
      }

      if (modalBackRecipes) {
        modalBackRecipes.addEventListener('click', () => {
          audio.playClick();
          if (modal) modal.classList.add('hidden');
          resetTimer();
          switchTab('recipes');
        });
      }

      // Initial Steps Render
      renderBrewSteps(currentRecipe);
    </script>

  </body>
</html>
