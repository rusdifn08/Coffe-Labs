<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Coffee Labs — Web Trial App</title>
    <meta name="description" content="Aplikasi panduan seduh kopi presisi Coffee Labs versi Web Trial. Resep juara dunia, guided timer interaktif, audio sound effect & BGM kafe." />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body class="bg-[#181310] text-[#332B25] antialiased select-none font-sans min-h-screen flex flex-col items-center justify-center p-0 md:p-3 overflow-x-hidden">
    
    <!-- Top Desktop Quick Bar -->
    <header class="hidden md:flex items-center justify-between max-w-5xl w-full py-2 px-4 mb-2 text-white/80 text-xs">
      <div class="flex items-center gap-2">
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold transition-colors">
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          <span>Kembali ke Landing Page</span>
        </a>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#ECA400]/20 border border-[#ECA400]/40 text-[#ECA400] text-[11px] font-bold">
          <span class="w-2 h-2 rounded-full bg-[#ECA400] animate-pulse"></span>
          <span>MODE UJI COBA WEB (TRIAL 10 SESI)</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-white/60 text-[11px] hidden lg:inline">Aplikasi Versi Penuh:</span>
        <a
          href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439526766"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#ECA400] hover:bg-[#D4AF37] text-[#1E1612] font-bold text-xs shadow-sm transition-all"
          title="Unduh APK Android"
        >
          <span>Unduh Android (APK)</span>
        </a>
        <a
          href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439017056"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-black text-white border border-white/20 hover:bg-neutral-800 font-bold text-xs shadow-sm transition-all"
          title="Unduh iOS (App Store)"
        >
          <span>Unduh iOS</span>
        </a>
      </div>
    </header>

    <!-- Main Mobile Shell Container (Phone Mockup Frame on Desktop, Fullscreen on Mobile) -->
    <main class="w-full md:max-w-[420px] h-[100dvh] md:h-[860px] md:max-h-[92vh] bg-[#F9F6F0] md:rounded-[44px] shadow-2xl md:ring-1 md:ring-white/15 md:border-[7px] md:border-[#2A1F19] flex flex-col relative overflow-hidden">
      
      <!-- Top Speaker & Camera Notch (Desktop phone aesthetic) -->
      <div class="hidden md:flex justify-center pt-2 pb-0.5 shrink-0 bg-[#F9F6F0] z-30">
        <div class="w-24 h-4 bg-[#2A1F19] rounded-full flex items-center justify-center gap-2">
          <div class="w-2 h-2 rounded-full bg-[#1E1612]/80 border border-white/10"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-blue-900/60"></div>
        </div>
      </div>

      <!-- Native Mobile Status Bar -->
      <div class="flex items-center justify-between px-5 pt-2 pb-1 shrink-0 bg-[#F9F6F0] text-[11px] font-semibold text-[#332B25] z-30">
        <span id="live-clock">09:41</span>
        <div class="flex items-center gap-1.5 text-[#332B25]">
          <!-- Mobile Return Link (visible on small screens) -->
          <a href="/" class="md:hidden text-[10px] text-[#6B4423] font-bold bg-[#F1E8E0] px-2 py-0.5 rounded-md mr-1" title="Kembali ke Landing Page">
            ← Web
          </a>
