---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';

const navItems = [
  { id: 'fitur', label: 'Fitur', sub: 'Fitur Unggulan', key: 'nav.fitur', subKey: 'nav.fitur_sub' },
  { id: 'aplikasi', label: 'Aplikasi', sub: 'Simulasi Layar', key: 'nav.aplikasi', subKey: 'nav.aplikasi_sub' },
  { id: 'guided-brew', label: 'Guided Brew', sub: 'Timer Presisi', key: 'nav.guided_brew', subKey: 'nav.guided_brew_sub' },
  { id: 'brew-doctor', label: 'Brew Doctor', sub: 'Koreksi Sensori', key: 'nav.brew_doctor', subKey: 'nav.brew_doctor_sub' },
  { id: 'toolkit', label: 'Toolkit', sub: 'Alat Barista', key: 'nav.toolkit', subKey: 'nav.toolkit_sub' },
  { id: 'harga', label: 'Harga', sub: 'Paket & Akun', key: 'nav.harga', subKey: 'nav.harga_sub' },
  { id: 'faq', label: 'FAQ', sub: 'Tanya Jawab', key: 'nav.faq', subKey: 'nav.faq_sub' },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full glass-nav border-b border-[#E8DFD8] transition-all duration-300">
  <!-- Subtle Luminous Scroll Progress Bar -->
  <div
    id="scroll-progress-bar"
    class="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-[#6B4423] via-[#ECA400] to-[#6B4423] w-0 transition-all duration-75 ease-out z-20 pointer-events-none opacity-80"
    aria-hidden="true"
  ></div>

  <div id="header-container" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between transition-all duration-300">
    
    <!-- Logo & Brand -->
    <a
      href="#hero"
      id="brand-logo"
      class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-xl p-1 transition-transform active:scale-95 shrink-0"
      title="Kembali ke atas (Beranda)"
    >
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-[#6B4423] to-amber-600 p-0.5 shadow-sm group-hover:scale-105 transition-transform flex items-center justify-center shrink-0">
        <img src="/icon.png" alt="Coffee Labs Logo" class="w-full h-full object-cover rounded-[10px]" />
      </div>
      <div class="flex flex-col shrink-0">
        <span class="font-extrabold text-lg sm:text-xl text-[#332B25] tracking-tight group-hover:text-[#6B4423] transition-colors leading-tight whitespace-nowrap">
          Coffee <span class="text-[#ECA400]">Labs</span>
        </span>
        <span class="text-[9.5px] text-[#8F857D] font-semibold tracking-wider uppercase -mt-0.5 hidden sm:block whitespace-nowrap">
          Master Your Brew
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Clean, Unwrapped, Pure Typography with Smooth Hover & Active Animations) -->
    <nav
      id="desktop-nav"
      class="hidden md:flex items-center gap-0.5 lg:gap-1.5 text-sm font-semibold"
      aria-label="Menu Utama"
    >
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          class="nav-link-item group relative px-3 py-1.5 rounded-lg text-xs lg:text-sm font-medium text-[#6F655D] hover:text-[#1E1612] transition-colors duration-200 flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
          title={`Lihat bagian ${item.label}`}
        >
          <!-- Soft Wash on Hover / Active -->
          <span class="hover-wash absolute inset-0 rounded-lg bg-[#6B4423]/0 group-hover:bg-[#6B4423]/[0.05] transition-colors duration-200 pointer-events-none"></span>

          <!-- Nav Label Text -->
          <span class="nav-label relative z-10 transition-colors duration-200" data-i18n={item.key}>{item.label}</span>

          <!-- Animated Bottom Indicator Bar -->
          <span class="nav-indicator absolute -bottom-0.5 left-2.5 right-2.5 h-[2px] rounded-full bg-[#6B4423] pointer-events-none"></span>
        </a>
      ))}
    </nav>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      
      <!-- Language Pill Indicator (Desktop ID / EN Switcher) -->
      <div id="lang-switch-desktop" class="hidden sm:flex items-center text-xs font-bold bg-[#F1E8E0] p-0.5 rounded-lg border border-[#6B4423]/15">
        <button id="lang-btn-id" type="button" class="px-2.5 py-0.5 rounded-md bg-[#6B4423] text-white shadow-xs transition-colors cursor-pointer" aria-label="Ganti ke Bahasa Indonesia">ID</button>
        <button id="lang-btn-en" type="button" class="px-2.5 py-0.5 rounded-md text-[#8F857D] hover:text-[#332B25] transition-colors cursor-pointer" aria-label="Switch to English">EN</button>
      </div>

      <!-- CTA Button (Navigates to Web Trial App) -->
      <!-- Di smartphone / mobile, tombol ini disembunyikan agar tulisan Coffee Labs tetap 1 baris utuh -->
      <a
        id="nav-cta-btn"
        href="/trial"
        class="hidden sm:inline-flex group items-center gap-1.5 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-[#ECA400] hover:bg-[#D4AF37] text-[#332B25] font-bold text-xs sm:text-sm shadow-sm hover:shadow-md hover:shadow-[#ECA400]/30 transition-all duration-200 active:scale-95 cursor-pointer whitespace-nowrap"
        title="Uji coba aplikasi Coffee Labs gratis via browser"
      >
        <span class="font-bold" data-i18n="nav.coba_gratis">Coba Gratis</span>
        <Icon name="arrow-right" size={12} color="#332B25" class="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-xl text-[#332B25] hover:bg-black/5 focus:outline-none cursor-pointer transition-colors"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Menu Drawer (Dialog-style slide down) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#E8DFD8] bg-[#F9F6F0]/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3 shadow-xl transition-all duration-300"
  >
    <!-- Quick CTA inside mobile drawer -->
    <a
      href="/trial"
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#ECA400] hover:bg-[#D4AF37] text-[#332B25] font-bold text-sm shadow-sm active:scale-98 transition-all"
    >
      <span data-i18n="nav.coba_gratis_mobile">Coba Gratis Sekarang</span>
      <Icon name="arrow-right" size={14} color="#332B25" />
    </a>

    <div class="flex flex-col space-y-1">
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-mobile-link={item.id}
          class="mobile-nav-link py-2.5 px-3 rounded-xl transition-all duration-200 flex items-center justify-between text-[#6F655D] hover:bg-black/5 hover:text-[#332B25]"
        >
          <span class="font-medium text-sm leading-tight text-inherit" data-i18n={item.key}>{item.label}</span>
          <span class="mobile-sub text-[11px] text-[#8F857D]" data-i18n={item.subKey}>{item.sub}</span>
        </a>
      ))}
    </div>

    <!-- Mobile Drawer Footer Info -->
    <div class="pt-3 border-t border-[#E8DFD8] flex items-center justify-between">
      <span class="text-xs font-medium text-[#8F857D]" data-i18n="nav.app_lang">Bahasa Aplikasi:</span>
      <div id="lang-switch-mobile" class="flex text-xs font-bold bg-[#F1E8E0] p-1 rounded-full border border-[#6B4423]/15">
        <button id="mobile-lang-btn-id" type="button" class="px-3 py-1 rounded-full bg-[#6B4423] text-white transition-colors cursor-pointer">Indonesia</button>
        <button id="mobile-lang-btn-en" type="button" class="px-3 py-1 rounded-full text-[#8F857D] hover:text-[#332B25] transition-colors cursor-pointer">English</button>
      </div>
    </div>
  </div>
</header>

<script src="../../scripts/i18n.ts"></script>

<style>
  .nav-link-item {
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link-item .nav-indicator {
    transform: scaleX(0);
    opacity: 0;
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, background-color 0.2s ease;
  }

  .nav-link-item:hover .nav-indicator {
    transform: scaleX(0.7);
    opacity: 0.5;
    background-color: #ECA400;
  }

  .nav-link-item.is-active {
    color: #6B4423 !important;
    font-weight: 700;
  }

  .nav-link-item.is-active .hover-wash {
    background-color: rgba(107, 68, 35, 0.08) !important;
  }

  .nav-link-item.is-active .nav-indicator {
    transform: scaleX(1) !important;
    opacity: 1 !important;
    background-color: #6B4423 !important;
    box-shadow: 0 1px 3px rgba(107, 68, 35, 0.35);
  }

  .mobile-nav-link.is-active {
    background-color: #6B4423 !important;
    color: #FFFFFF !important;
    font-weight: 700;
  }

  .mobile-nav-link.is-active .mobile-sub {
    color: rgba(255, 244, 214, 0.8) !important;
  }
</style>

<script>
  const sectionIds = [
    'fitur',
    'aplikasi',
    'guided-brew',
    'brew-doctor',
    'toolkit',
    'harga',
    'faq',
    'download'
  ];

  const header = document.getElementById('site-header');
  const headerContainer = document.getElementById('header-container');
  const progressBar = document.getElementById('scroll-progress-bar');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileMenu.classList.toggle('hidden');
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Active section tracking
  let currentActiveId = '';

  function setActiveSection(id: string) {
    if (currentActiveId === id) return;
    currentActiveId = id;

    // 1. Update Desktop Links
    desktopLinks.forEach((link) => {
      const linkId = link.getAttribute('data-nav-link');
      if (linkId === id) {
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'page');
      } else {
        link.classList.remove('is-active');
        link.removeAttribute('aria-current');
      }
    });

    // 2. Update Mobile Menu Links
    mobileLinks.forEach((link) => {
      const linkId = link.getAttribute('data-mobile-link');
      if (linkId === id) {
        link.classList.add('is-active');
      } else {
        link.classList.remove('is-active');
      }
    });
  }

  // Smooth scroll click handler for immediate responsive feedback
  function setupSmoothScroll() {
    const allNavAnchors = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
    allNavAnchors.forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          e.preventDefault();
          if (sectionIds.includes(targetId)) {
            setActiveSection(targetId);
          } else if (targetId === 'hero') {
            setActiveSection('');
          }
          targetElement.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', href);
        }
      });
    });
  }

  // Optimized Scroll Handler with requestAnimationFrame
  let ticking = false;

  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const scrollY = window.scrollY;

        // Reading Progress Bar calculation
        if (progressBar) {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
          progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
        }

        // Header elevation on scroll
        if (headerContainer) {
          if (scrollY > 30) {
            headerContainer.classList.remove('h-16', 'sm:h-20');
            headerContainer.classList.add('h-14', 'sm:h-16');
            header?.classList.add('shadow-sm', 'shadow-[#332B25]/5');
          } else {
            headerContainer.classList.add('h-16', 'sm:h-20');
            headerContainer.classList.remove('h-14', 'sm:h-16');
            header?.classList.remove('shadow-sm', 'shadow-[#332B25]/5');
          }
        }

        // Scrollspy: Detect section currently in viewport
        if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 90) {
          setActiveSection('download');
          ticking = false;
          return;
        }

        if (scrollY < 200) {
          setActiveSection('');
          ticking = false;
          return;
        }

        const scrollPos = scrollY + 160;
        let foundSection = '';

        for (let i = sectionIds.length - 1; i >= 0; i--) {
          const id = sectionIds[i];
          const el = document.getElementById(id);
          if (el && el.offsetTop <= scrollPos) {
            foundSection = id;
            break;
          }
        }

        setActiveSection(foundSection);
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  setupSmoothScroll();
  onScroll();
</script>
