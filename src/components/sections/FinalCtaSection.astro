---
import Icon from '../ui/Icon.astro';
---

<section id="download" class="py-12 sm:py-16 bg-[#1E1612] text-white relative overflow-hidden">
  
  <!-- Subtle ambient amber glow -->
  <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[#ECA400]/20 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="rounded-2xl p-6 sm:p-10 bg-gradient-to-tr from-[#2A1F19] to-[#3A2B22] border border-white/10 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
      
      <!-- Left Copywriting -->
      <div class="space-y-3.5 max-w-xl text-center lg:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-[#ECA400]/20 text-[#ECA400] text-xs font-bold uppercase tracking-wider">
          <Icon name="sparkles" size={12} color="#ECA400" />
          <span>UNDUH SEKARANG</span>
        </span>

        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight">
          Siap menyeduh kopi terbaik Anda <br class="hidden sm:inline" />
          <span class="text-[#ECA400] font-serif italic">mulai hari ini?</span>
        </h2>

        <p class="text-xs sm:text-sm text-white/70 leading-relaxed">
          Dapatkan akses instan ke 10 resep gratis di Mode Trial. Tanpa kartu kredit, tanpa risiko. Rasakan perbedaannya sejak tetesan pertama.
        </p>

        <!-- Store Badges & Download APK (Multi-Platform: iOS, Android, APK) -->
        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-3">
          <!-- Apple App Store (iOS) -->
          <a
            href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439017056"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-black text-white rounded-lg shadow-lg hover:scale-105 transition-transform border border-white/15"
            title="Unduh Coffee Labs untuk iOS (iPhone & iPad)"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.86c.62-.77 1.05-1.84.93-2.92-.91.04-2.02.61-2.67 1.38-.57.66-.99 1.74-.86 2.8 1.02.08 2.05-.53 2.6-1.26z"/>
            </svg>
            <div class="text-left">
              <div class="text-[9px] uppercase tracking-wider text-zinc-400 leading-none">Unduh di</div>
              <div class="text-xs font-bold leading-tight">iOS (App Store)</div>
            </div>
          </a>

          <!-- Google Play (Android) -->
          <a
            href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439526766"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-black text-white rounded-lg shadow-lg hover:scale-105 transition-transform border border-white/15"
            title="Unduh Coffee Labs untuk Android"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M3.609 1.814L13.793 12 3.61 22.186A1.94 1.94 0 0 1 3 20.771V3.229c0-.55.228-1.047.609-1.415zm11.603 11.604l2.585 2.585-11.83 6.786 9.245-9.371zm0-2.836L5.967 1.21l11.83 6.786-2.585 2.586zm1.414 1.418l3.666 2.1a1.296 1.296 0 0 0 0-2.25l-3.666-2.1v2.25z" />
            </svg>
            <div class="text-left">
              <div class="text-[9px] uppercase tracking-wider text-zinc-400 leading-none">Tersedia di</div>
              <div class="text-xs font-bold leading-tight">Android (Google Play)</div>
            </div>
          </a>

          <!-- Direct APK Download -->
          <a
            href="https://github.com/rusdifn08/coffe-labs-mobile/actions/runs/39809056131/artifacts/12439526766"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-[#ECA400] hover:bg-[#C98C00] text-[#1E1612] font-extrabold text-xs rounded-lg shadow-lg hover:scale-105 transition-all"
            title="Download file instalasi APK Android"
          >
            <Icon name="package" size={17} color="#1E1612" />
            <div class="text-left">
              <div class="text-[9px] uppercase tracking-wider text-[#1E1612]/70 leading-none">Download Langsung</div>
              <div class="text-xs font-black leading-tight">Android APK v1.0</div>
            </div>
          </a>

          <!-- Web Trial Live Button -->
          <a
            href="/trial"
            class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white font-extrabold text-xs rounded-lg shadow-lg hover:scale-105 transition-all border border-white/20"
            title="Uji coba aplikasi via browser gratis tanpa install"
          >
            <Icon name="sparkles" size={16} color="#ECA400" />
            <div class="text-left">
              <div class="text-[9px] uppercase tracking-wider text-amber-300 leading-none">Buka di Browser</div>
              <div class="text-xs font-bold leading-tight">Uji Coba Web App</div>
            </div>
          </a>
        </div>

        <div class="text-[11px] text-emerald-400 font-semibold pt-0.5 flex items-center justify-center lg:justify-start gap-1.5">
          <Icon name="check" size={12} color="#34D399" />
          <span>Mendukung penuh iOS (iPhone/iPad), Android, dan Web Browser dengan sinkronisasi cloud real-time.</span>
        </div>
      </div>

      <!-- Right: Desktop QR Code Scan Box -->
      <div class="bg-white p-4 sm:p-5 rounded-xl text-zinc-900 text-center shadow-xl border border-white/20 shrink-0 max-w-xs w-full">
        <div class="font-bold text-xs sm:text-sm text-[#332B25] mb-2">Scan QR untuk Unduh di Ponsel</div>
        
        <!-- Generated SVG QR Code pattern -->
        <div class="w-36 h-36 mx-auto p-2 bg-[#F9F6F0] rounded-lg border border-zinc-200 flex items-center justify-center">
          <svg class="w-full h-full text-zinc-900" viewBox="0 0 100 100" fill="currentColor">
            <path d="M10 10h30v30h-30z M15 15h20v20h-20z M20 20h10v10h-10z" />
            <path d="M60 10h30v30h-30z M65 15h20v20h-20z M70 20h10v10h-10z" />
            <path d="M10 60h30v30h-30z M15 65h20v20h-20z M20 70h10v10h-10z" />
            <path d="M50 15h5v15h-5z M50 35h15v5h-15z M75 50h15v5h-15z M60 60h10v10h-10z M80 70h10v20h-10z M50 75h10v15h-10z M65 80h10v10h-10z" />
            <circle cx="50" cy="50" r="5" fill="#6B4423" />
          </svg>
        </div>

        <div class="text-[10px] text-[#8F857D] font-semibold mt-2.5">
          Arahkan kamera smartphone Anda
        </div>
      </div>

    </div>
  </div>
</section>
