---
import Icon from '../ui/Icon.astro';
import PhoneMockup from '../mockup/PhoneMockup.astro';
import BrewTimerScreenMockup from '../mockup/BrewTimerScreenMockup.astro';
---

<section id="guided-brew" class="py-10 sm:py-16 bg-white border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
      
      <!-- Left: Copywriting & App Showcase Pitch (6 cols) -->
      <div class="lg:col-span-6 space-y-4 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
          <Icon name="timer" size={13} color="#6B4423" />
          <span data-i18n="guided.badge">GUIDED BREWING EXPERIENCE</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight leading-tight" data-i18n="guided.title">
          Setiap tuangan, tepat waktu & tepat gramasi.
        </h2>

        <p class="hidden sm:block text-xs sm:text-base text-[#6F655D] leading-relaxed max-w-xl mx-auto lg:mx-0" data-i18n="guided.desc">
          Jangan biarkan air seduhan Anda mengalir sembarangan. Coffee Labs membagi setiap resep ke dalam tahapan presisi. Anda tahu persis kapan harus menuang, berapa gram air yang harus ditambahkan, dan kapan harus berhenti — langsung tersaji jernih di genggaman Anda.
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-3 text-xs font-bold text-[#6B4423]">
          <a
            href="/trial"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#ECA400] hover:bg-[#C98C00] text-[#1E1612] font-black shadow-sm transition-all"
          >
            <span>Coba Guided Timer</span>
            <Icon name="arrow-right" size={13} color="#1E1612" />
          </a>
          <span class="text-[#8F857D] text-xs">Simulasi langsung di browser</span>
        </div>

      </div>

      <!-- Right: Dedicated Guided Brew Smartphone Showcase (6 cols) -->
      <div class="lg:col-span-6 flex justify-center">
        <PhoneMockup size="md" tilt="none" glow={true}>
          <BrewTimerScreenMockup />
        </PhoneMockup>
      </div>

    </div>

  </div>
</section>
