---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-12 sm:py-16 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="message-square" size={13} color="#6B4423" />
        <span>TESTIMONI PENGGUNA</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight" data-i18n="testimonials.title">
        Cerita dari mereka yang telah menemukan seduhan terbaiknya.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D]">
        Mulai dari penikmat seduh di dapur rumah hingga barista di balik slow bar kafe ternama.
      </p>
    </div>

    <!-- Mobile: 1 Card Slider with Prev / Next Navigation (md:hidden) -->
    <div class="md:hidden relative">
      <div id="testimonial-slider" class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth gap-4 pb-1">
        {landingData.testimonials.map((t, idx) => (
          <div class="w-full shrink-0 snap-center p-4 rounded-xl bg-white border border-[#E8DFD8] shadow-xs flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex text-amber-500 gap-0.5">
                  {Array.from({ length: t.stars }).map(() => (
                    <Icon name="star" size={12} color="#F59E0B" />
                  ))}
                </div>
                <span class="text-[10px] font-bold text-[#8F857D]">{idx + 1} dari {landingData.testimonials.length}</span>
              </div>
              <p class="text-xs text-[#332B25] leading-relaxed italic">
                "{t.quote}"
              </p>
            </div>
            <div class="flex items-center gap-2.5 pt-3 mt-3 border-t border-[#E8DFD8]">
              <div class="w-8 h-8 rounded-full overflow-hidden border border-[#E8DFD8] shrink-0 bg-amber-50">
                <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" />
              </div>
              <div class="min-w-0">
                <div class="font-extrabold text-xs text-[#332B25] truncate">{t.name}</div>
                <div class="text-[10px] text-[#8F857D] truncate">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Controls: Prev / Next Buttons & Indicators -->
      <div class="flex items-center justify-center gap-3 mt-3">
        <button id="btn-prev-testi" class="w-7 h-7 rounded-full bg-white border border-[#E8DFD8] flex items-center justify-center text-[#6B4423] shadow-xs hover:bg-[#F9F6F0] active:scale-90 transition-all cursor-pointer" aria-label="Komentar Sebelumnya">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="flex items-center gap-1.5" id="testi-dots">
          {landingData.testimonials.map((_, idx) => (
            <span class={`h-1.5 rounded-full transition-all duration-300 testi-dot ${idx === 0 ? 'w-4 bg-[#6B4423]' : 'w-1.5 bg-[#E8DFD8]'}`}></span>
          ))}
        </div>
        <button id="btn-next-testi" class="w-7 h-7 rounded-full bg-white border border-[#E8DFD8] flex items-center justify-center text-[#6B4423] shadow-xs hover:bg-[#F9F6F0] active:scale-90 transition-all cursor-pointer" aria-label="Komentar Selanjutnya">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Desktop: Testimonials Cards Grid (hidden md:grid) -->
    <div class="hidden md:grid md:grid-cols-3 gap-5">
      {landingData.testimonials.map((t) => (
        <div class="p-5 sm:p-6 rounded-xl bg-white border border-[#E8DFD8] shadow-xs flex flex-col justify-between hover:shadow-warm-sm hover:-translate-y-0.5 transition-all duration-200">
          <div class="space-y-3">
            <!-- Stars SVG -->
            <div class="flex text-amber-500 gap-0.5">
              {Array.from({ length: t.stars }).map(() => (
                <Icon name="star" size={13} color="#F59E0B" />
              ))}
            </div>

            <!-- Quote -->
            <p class="text-xs sm:text-sm text-[#332B25] leading-relaxed italic">
              "{t.quote}"
            </p>
          </div>

          <!-- Author info -->
          <div class="flex items-center gap-3 pt-4 mt-4 border-t border-[#E8DFD8]">
            <div class="w-10 h-10 rounded-full overflow-hidden border border-[#E8DFD8] shrink-0 bg-amber-50">
              <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" />
            </div>
            <div>
              <div class="font-extrabold text-xs sm:text-sm text-[#332B25]">{t.name}</div>
              <div class="text-[11px] text-[#8F857D]">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const slider = document.getElementById('testimonial-slider');
  const prevBtn = document.getElementById('btn-prev-testi');
  const nextBtn = document.getElementById('btn-next-testi');
  const dots = document.querySelectorAll('.testi-dot');

  let curIdx = 0;
  const count = dots.length;

  function updateTesti(idx) {
    if (!slider) return;
    const cards = slider.children;
    if (cards[idx]) {
      (cards[idx] as HTMLElement).scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
    dots.forEach((dot, i) => {
      if (i === idx) {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 testi-dot w-4 bg-[#6B4423]';
      } else {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 testi-dot w-1.5 bg-[#E8DFD8]';
      }
    });
  }

  prevBtn?.addEventListener('click', () => {
    curIdx = (curIdx - 1 + count) % count;
    updateTesti(curIdx);
  });

  nextBtn?.addEventListener('click', () => {
    curIdx = (curIdx + 1) % count;
    updateTesti(curIdx);
  });

  // Also update dots on native touch scroll
  slider?.addEventListener('scroll', () => {
    const scrollLeft = slider.scrollLeft;
    const width = slider.clientWidth;
    const newIdx = Math.round(scrollLeft / width);
    if (newIdx !== curIdx && newIdx >= 0 && newIdx < count) {
      curIdx = newIdx;
      dots.forEach((dot, i) => {
        if (i === curIdx) {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 testi-dot w-4 bg-[#6B4423]';
        } else {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 testi-dot w-1.5 bg-[#E8DFD8]';
        }
      });
    }
  }, { passive: true });
</script>
