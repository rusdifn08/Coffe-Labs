---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-12 sm:py-16 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="message-square" size={13} color="#6B4423" />
        <span>TESTIMONI PENGGUNA</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight">
        Cerita dari mereka yang telah menemukan seduhan terbaiknya.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D]">
        Mulai dari penikmat seduh di dapur rumah hingga barista di balik slow bar kafe ternama.
      </p>
    </div>

    <!-- Testimonials Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {landingData.testimonials.map((t) => (
        <div class="p-5 sm:p-6 rounded-xl bg-white border border-[#E8DFD8] shadow-xs flex flex-col justify-between hover:shadow-warm-sm hover:-translate-y-0.5 transition-all duration-200">
          <div class="space-y-3">
            <!-- Stars SVG -->
            <div class="flex text-amber-500 gap-0.5">
              {Array.from({ length: t.stars }).map(() => (
                <Icon name="star" size={13} color="#F59E0B" />
              ))}
            </div>

            <!-- Quote -->
            <p class="text-xs sm:text-sm text-[#332B25] leading-relaxed italic">
              "{t.quote}"
            </p>
          </div>

          <!-- Author info -->
          <div class="flex items-center gap-3 pt-4 mt-4 border-t border-[#E8DFD8]">
            <div class="w-10 h-10 rounded-full overflow-hidden border border-[#E8DFD8] shrink-0 bg-amber-50">
              <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" />
            </div>
            <div>
              <div class="font-extrabold text-xs sm:text-sm text-[#332B25]">{t.name}</div>
              <div class="text-[11px] text-[#8F857D]">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
