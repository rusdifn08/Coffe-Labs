---
import Icon from '../ui/Icon.astro';
import PhoneMockup from '../mockup/PhoneMockup.astro';
import RecipeFeedScreenMockup from '../mockup/RecipeFeedScreenMockup.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-12 sm:py-16 bg-white border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="book" size={13} color="#6B4423" />
        <span>ARSIP RESEP JUARA DUNIA</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight">
        200+ Resep dari 100+ Barista Dunia, <br class="hidden sm:inline" />
        <span class="text-[#6B4423]">termasuk juara World Brewers Cup.</span>
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D] max-w-xl mx-auto">
        Tak perlu lagi mencatat acak dari video YouTube. Setiap resep telah diuji, memiliki dosis rasio baku, suhu air terukur, dan panduan klik grinder.
      </p>
    </div>

    <!-- Smartphone Mockup: Tampilan Pustaka Resep Asli di Mobile -->
    <div class="flex justify-center py-2">
      <PhoneMockup size="md" tilt="none" glow={true}>
        <RecipeFeedScreenMockup />
      </PhoneMockup>
    </div>

    <!-- Grinder Models Supported (50+ Model Grinder) -->
    <div class="space-y-3 pt-6 border-t border-[#E8DFD8]">
      <div class="text-center">
        <span class="text-[11px] font-bold text-[#8F857D] uppercase tracking-widest block">KONVERTER 50+ MODEL GRINDER</span>
        <h3 class="text-base sm:text-lg font-bold text-[#332B25] mt-0.5">Konversi Klik Presisi Antar Grinder</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
        {landingData.grinderModels.map((g) => (
          <div class="bg-[#F9F6F0] p-2.5 rounded-lg border border-[#E8DFD8] text-center flex flex-col items-center justify-between hover:border-[#6B4423]/40 transition-colors">
            <div class="w-16 h-16 flex items-center justify-center p-1.5 mb-1">
              <img src={g.image} alt={g.name} class="max-h-full max-w-full object-contain filter drop-shadow-sm" />
            </div>
            <div class="font-bold text-[11px] text-[#332B25] leading-tight">{g.name}</div>
            <div class="text-[9.5px] font-mono font-semibold text-[#6B4423] mt-1 bg-white px-2 py-0.5 rounded-md border border-[#E8DFD8]">
              {g.clicksRange}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
