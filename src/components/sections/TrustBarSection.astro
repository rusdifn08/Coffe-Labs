---
import { landingData } from '../../data/landingData';
---

<section class="border-y border-[#E8DFD8] bg-white py-8 sm:py-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 4 Key Numbers Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 text-center divide-y lg:divide-y-0 lg:divide-x divide-[#E8DFD8]">
      {landingData.stats.map((stat, i) => (
        <div class={`space-y-1 ${i > 1 ? 'pt-6 sm:pt-0' : ''}`}>
          <div class="text-3xl sm:text-5xl font-extrabold text-[#6B4423] tracking-tight font-mono">
            {stat.value}
          </div>
          <div
            class="text-sm sm:text-base font-bold text-[#332B25]"
            data-i18n={i === 0 ? 'trust.recipes_num' : i === 1 ? 'trust.baristas_num' : i === 2 ? 'trust.grinders_num' : 'trust.sensory_num'}
          >
            {stat.label}
          </div>
          <div
            class="text-xs text-[#8F857D] font-medium max-w-[200px] mx-auto"
            data-i18n={i === 0 ? 'trust.recipes_sub' : i === 1 ? 'trust.baristas_sub' : i === 2 ? 'trust.grinders_sub' : 'trust.sensory_sub'}
          >
            {stat.sub}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
