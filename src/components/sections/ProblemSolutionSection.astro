---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-10 sm:py-14 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Compact Header -->
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 space-y-1.5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-red-50 border border-red-200 text-red-700 text-[11px] font-bold uppercase tracking-wider">
        <Icon name="alert-circle" size={13} color="#B91C1C" />
        <span>Tantangan Home Brewer</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-[#332B25] tracking-tight">
        Kopi kafe selalu nikmat, di rumah sering gagal?
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D]">
        Menyeduh specialty coffee manual butuh parameter presisi. Coffee Labs mengubah tebakan menjadi kepastian.
      </p>
    </div>

    <!-- ============================================================ -->
    <!-- MOBILE VIEW (sm:hidden): Interactive Paired Cards with Topic Chips & Slider -->
    <!-- ============================================================ -->
    <div class="sm:hidden space-y-3">
      
      <!-- Topic Category Chips (Tap to switch) -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1" id="ps-chip-container">
        {landingData.problemSolution.map((item, idx) => (
          <button
            class={`ps-chip px-3 py-1 rounded-full text-[11px] font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer ${
              idx === 0
                ? 'bg-[#6B4423] text-white border-[#6B4423] shadow-xs active-chip'
                : 'bg-white text-[#6F655D] border-[#E8DFD8] hover:bg-[#F9F6F0]'
            }`}
            data-ps-idx={idx}
          >
            {item.tag}
          </button>
        ))}
      </div>

      <!-- Swipeable Paired Transformation Cards -->
      <div
        id="ps-slider"
        class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth gap-3"
      >
        {landingData.problemSolution.map((item, idx) => (
          <div
            class="ps-card w-full shrink-0 snap-center rounded-2xl bg-white border border-[#E8DFD8] shadow-xs p-4 flex flex-col justify-between space-y-3"
            data-ps-card-idx={idx}
          >
            <!-- Problem Box -->
            <div class="p-3 rounded-xl bg-red-50/60 border border-red-200/70 space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1 text-[10px] font-extrabold text-red-700 uppercase tracking-wider">
                  <Icon name="x" size={12} color="#DC2626" />
                  <span>Kendala Seduh Biasa</span>
                </span>
                <span class="text-[9.5px] font-mono text-[#8F857D] font-bold">{idx + 1} / 5</span>
              </div>
              <p class="text-xs font-semibold text-[#4A3B32] leading-snug">
                "{item.problem}"
              </p>
            </div>

            <!-- Transformation Arrow Divider -->
            <div class="flex items-center justify-center gap-2 py-0.5">
              <div class="flex-1 border-t border-[#E8DFD8]"></div>
              <span class="px-2.5 py-0.5 rounded-full bg-[#ECA400]/15 text-[#6B4423] text-[9.5px] font-black uppercase tracking-wider flex items-center gap-1">
                <span>Solusi Presisi</span>
                <Icon name="arrow-right" size={10} color="#6B4423" />
              </span>
              <div class="flex-1 border-t border-[#E8DFD8]"></div>
            </div>

            <!-- Solution Box -->
            <div class="p-3 rounded-xl bg-gradient-to-br from-emerald-50/90 to-[#FAFDFB] border border-emerald-400/50 shadow-2xs space-y-1.5">
              <div class="flex items-center gap-1 text-[10px] font-extrabold text-emerald-800 uppercase tracking-wider">
                <Icon name="check" size={12} color="#15803D" />
                <span>Dengan Coffee Labs</span>
              </div>
              <p class="text-xs font-bold text-[#1E1612] leading-snug">
                {item.solution}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Controls: Prev / Next & Dots -->
      <div class="flex items-center justify-between pt-1 px-1">
        <button
          id="btn-prev-ps"
          class="px-2.5 py-1 rounded-lg bg-white border border-[#E8DFD8] text-[11px] font-bold text-[#6F655D] flex items-center gap-1 shadow-2xs hover:bg-[#F9F6F0] active:scale-95 transition-all cursor-pointer"
          aria-label="Kendala Sebelumnya"
        >
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
          <span>Sebelumnya</span>
        </button>

        <div class="flex items-center gap-1.5" id="ps-dots">
          {landingData.problemSolution.map((_, i) => (
            <span
              class={`h-1.5 rounded-full transition-all duration-300 ps-dot ${i === 0 ? 'w-4 bg-[#6B4423]' : 'w-1.5 bg-[#E8DFD8]'}`}
              data-dot-idx={i}
            ></span>
          ))}
        </div>

        <button
          id="btn-next-ps"
          class="px-2.5 py-1 rounded-lg bg-white border border-[#E8DFD8] text-[11px] font-bold text-[#6B4423] flex items-center gap-1 shadow-2xs hover:bg-[#F9F6F0] active:scale-95 transition-all cursor-pointer"
          aria-label="Kendala Berikutnya"
        >
          <span>Berikutnya</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>

    </div>

    <!-- ============================================================ -->
    <!-- DESKTOP VIEW (hidden sm:block): Full Side-by-Side Matrix    -->
    <!-- ============================================================ -->
    <div class="hidden sm:block bg-white rounded-xl border border-[#E8DFD8] shadow-xs overflow-hidden">
      
      <!-- Table Header -->
      <div class="grid grid-cols-2 bg-[#F6F1EC] border-b border-[#E8DFD8] text-xs font-extrabold">
        <div class="p-3.5 pl-6 text-[#8F857D] uppercase tracking-wider flex items-center gap-2">
          <Icon name="x" size={14} color="#DC2626" />
          <span>Kendala Seduhan Manual Biasa</span>
        </div>
        <div class="p-3.5 pl-6 text-[#6B4423] uppercase tracking-wider border-l border-[#E8DFD8] flex items-center gap-2 bg-[#FAF5EE]">
          <Icon name="check" size={14} color="#15803D" />
          <span>Solusi Presisi Coffee Labs</span>
        </div>
      </div>

      <!-- Rows -->
      <div class="divide-y divide-[#E8DFD8]">
        {landingData.problemSolution.map((item) => (
          <div class="grid grid-cols-2 text-xs hover:bg-amber-50/15 transition-colors">
            <!-- Left Problem -->
            <div class="p-3.5 sm:px-6 flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-red-100/80 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="x" size={11} color="#DC2626" />
              </span>
              <p class="font-medium text-[#332B25] leading-snug">
                {item.problem}
              </p>
            </div>

            <!-- Right Solution -->
            <div class="p-3.5 sm:px-6 flex items-start gap-2.5 border-l border-[#E8DFD8] bg-[#F7FAF8] sm:bg-[#FAF5EE]/40">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size={11} color="#15803D" />
              </span>
              <p class="font-bold text-[#332B25] leading-snug">
                {item.solution}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  const psChips = document.querySelectorAll('.ps-chip');
  const psSlider = document.getElementById('ps-slider');
  const psDots = document.querySelectorAll('.ps-dot');
  const btnPrevPs = document.getElementById('btn-prev-ps');
  const btnNextPs = document.getElementById('btn-next-ps');

  let currentPsIdx = 0;
  const totalPs = psChips.length;

  function updatePsUI(index: number) {
    if (!psSlider) return;
    const cards = psSlider.children;
    if (cards[index]) {
      (cards[index] as HTMLElement).scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    // Update chips
    psChips.forEach((chip, i) => {
      if (i === index) {
        chip.className = 'ps-chip px-3 py-1 rounded-full text-[11px] font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer bg-[#6B4423] text-white border-[#6B4423] shadow-xs active-chip';
        (chip as HTMLElement).scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
      } else {
        chip.className = 'ps-chip px-3 py-1 rounded-full text-[11px] font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer bg-white text-[#6F655D] border-[#E8DFD8] hover:bg-[#F9F6F0]';
      }
    });

    // Update dots
    psDots.forEach((dot, i) => {
      if (i === index) {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 ps-dot w-4 bg-[#6B4423]';
      } else {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 ps-dot w-1.5 bg-[#E8DFD8]';
      }
    });

    currentPsIdx = index;
  }

  // Chips click
  psChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const idx = parseInt(chip.getAttribute('data-ps-idx') || '0', 10);
      updatePsUI(idx);
    });
  });

  // Prev / Next
  btnPrevPs?.addEventListener('click', () => {
    const next = (currentPsIdx - 1 + totalPs) % totalPs;
    updatePsUI(next);
  });

  btnNextPs?.addEventListener('click', () => {
    const next = (currentPsIdx + 1) % totalPs;
    updatePsUI(next);
  });

  // Swipe sync
  psSlider?.addEventListener('scroll', () => {
    const scrollLeft = psSlider.scrollLeft;
    const card = psSlider.children[0] as HTMLElement;
    if (!card) return;
    const width = card.offsetWidth + 12; // width + gap
    const activeIdx = Math.min(totalPs - 1, Math.max(0, Math.round(scrollLeft / width)));
    if (activeIdx !== currentPsIdx) {
      currentPsIdx = activeIdx;
      psChips.forEach((chip, i) => {
        if (i === activeIdx) {
          chip.className = 'ps-chip px-3 py-1 rounded-full text-[11px] font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer bg-[#6B4423] text-white border-[#6B4423] shadow-xs active-chip';
        } else {
          chip.className = 'ps-chip px-3 py-1 rounded-full text-[11px] font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer bg-white text-[#6F655D] border-[#E8DFD8] hover:bg-[#F9F6F0]';
        }
      });
      psDots.forEach((dot, i) => {
        if (i === activeIdx) {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 ps-dot w-4 bg-[#6B4423]';
        } else {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 ps-dot w-1.5 bg-[#E8DFD8]';
        }
      });
    }
  }, { passive: true });
</script>
