---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section id="harga" class="py-12 sm:py-16 bg-[#1E1612] text-[#F9F6F0] relative overflow-hidden">
  
  <!-- Ambient background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[450px] bg-amber-500/10 blur-[160px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8 sm:space-y-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2.5">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#D4AF37]/20 border border-[#D4AF37]/30 text-[#D4AF37] text-xs font-extrabold uppercase tracking-widest">
        <Icon name="tag" size={13} color="#D4AF37" />
        <span data-i18n="pricing.badge">INVESTASI RASA KOPI ANDA</span>
      </div>

      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#F9F6F0] tracking-tight" data-i18n="pricing.title">
        Pilihan paket fleksibel, mulai dari gratis selamanya.
      </h2>

      <p class="hidden sm:block text-xs sm:text-base text-white/70" data-i18n="pricing.desc">
        Nikmati seluruh 200+ resep juara dunia dan diagnosis Brew Doctor dengan lisensi seumur hidup (Lifetime).
      </p>
    </div>

    <!-- Pricing Cards Container: Swipeable on Mobile, 3-Cols Grid on Desktop -->
    <div class="relative">
      <div
        id="pricing-slider"
        class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth gap-4 pb-2 md:grid md:grid-cols-3 md:gap-5 items-stretch"
      >
        {landingData.pricing.plans.map((plan: any, idx: number) => (
          <div
            id={`pricing-card-${idx}`}
            data-plan-index={idx}
            data-plan-type={plan.id === 'cafe' ? 'business' : 'personal'}
            class={`w-[85vw] sm:w-[360px] md:w-auto shrink-0 snap-center rounded-xl p-5 sm:p-6 flex flex-col justify-between border relative transition-all duration-300 ${
              plan.popular
                ? 'bg-gradient-to-b from-[#2E2018] to-[#1E1612] border-[#ECA400] shadow-xl scale-100 md:scale-105 z-20 ring-1 ring-[#ECA400]/50'
                : 'bg-[#2A1F19]/60 border-[#3A2B22] hover:bg-[#2A1F19]'
            }`}
          >
            
            {plan.popular && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-md bg-[#ECA400] text-[#1E1612] text-[10px] font-extrabold tracking-wider uppercase shadow-md whitespace-nowrap">
                PALING POPULER
              </div>
            )}

            <div>
              <!-- Header Plan -->
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#D4AF37]" data-i18n={idx === 0 ? 'pricing.free_badge' : idx === 1 ? 'pricing.pro_badge' : 'pricing.cafe_badge'}>
                  {plan.badge}
                </span>
                <span class="text-[10px] font-mono text-white/40 md:hidden">
                  {idx + 1} / 3
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-extrabold text-white" data-i18n={idx === 0 ? 'pricing.free_name' : idx === 1 ? 'pricing.pro_name' : 'pricing.cafe_name'}>{plan.name}</h3>
              <p class="text-xs text-white/60 mt-1 leading-relaxed min-h-[32px]" data-i18n={idx === 0 ? 'pricing.free_desc' : idx === 1 ? 'pricing.pro_desc' : 'pricing.cafe_desc'}>
                {plan.desc}
              </p>

              <!-- Price Display with Strike-through & Discount badge -->
              <div class="my-5 pb-5 border-b border-white/10">
                {plan.originalPrice ? (
                  <div class="flex items-center gap-2 mb-1.5">
                    <span class="text-sm font-bold text-white/40 line-through font-mono">
                      {plan.originalPrice}
                    </span>
                    {plan.discountBadge && (
                      <span class="px-2 py-0.5 rounded text-[10px] font-black bg-[#ECA400]/20 text-[#ECA400] border border-[#ECA400]/40" data-i18n={idx === 1 ? 'pricing.pro_discount' : 'pricing.cafe_discount'}>
                        {plan.discountBadge}
                      </span>
                    )}
                  </div>
                ) : (
                  <div class="h-6 flex items-center">
                    <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider">
                      Tanpa Kartu Kredit
                    </span>
                  </div>
                )}
                
                <div class="flex items-baseline gap-1.5">
                  <span class="text-3xl sm:text-4xl font-extrabold text-white font-mono">
                    {plan.price}
                  </span>
                  <span class="text-xs text-white/60 font-semibold" data-i18n={idx === 0 ? 'pricing.free_period' : idx === 1 ? 'pricing.pro_period' : 'pricing.cafe_period'}>
                    {plan.period}
                  </span>
                </div>
              </div>

              <!-- Features Checklist with crisp SVGs -->
              <ul class="space-y-2.5 text-xs leading-relaxed">
                {plan.features.map((f: any) => (
                  <li class={`flex items-start gap-2.5 ${f.included ? (f.highlight ? 'text-[#ECA400] font-semibold' : 'text-white') : 'text-white/40 line-through'}`}>
                    <span class="mt-0.5 shrink-0">
                      {f.included ? (
                        <Icon name="check" size={12} color="#ECA400" />
                      ) : (
                        <Icon name="x" size={12} color="#71717A" />
                      )}
                    </span>
                    <span>{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- CTA Button -->
            <div class="mt-6 pt-3">
              <a
                href={plan.ctaHref}
                class={`w-full py-3 px-5 rounded-xl font-bold text-xs sm:text-sm text-center block transition-all active:scale-95 shadow-md ${
                  plan.popular
                    ? 'bg-[#ECA400] hover:bg-[#C98C00] text-[#1E1612]'
                    : 'bg-white/10 hover:bg-white/20 text-white border border-white/15'
                }`}
                data-i18n={idx === 0 ? 'pricing.free_cta' : idx === 1 ? 'pricing.pro_cta' : 'pricing.cafe_cta'}
              >
                {plan.ctaText}
              </a>
            </div>

          </div>
        ))}
      </div>

      <!-- Mobile Navigation Buttons & Dots Indicator (md:hidden) -->
      <div class="flex md:hidden items-center justify-between gap-3 mt-4 px-2">
        <button
          id="btn-prev-plan"
          class="px-3 py-1.5 rounded-lg bg-[#2A1F19] border border-white/15 text-xs font-bold text-white flex items-center gap-1 shadow-xs hover:bg-[#3A2B22] active:scale-95 transition-all cursor-pointer"
          aria-label="Paket Sebelumnya"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
          <span data-i18n="pricing.btn_prev">Sebelumnya</span>
        </button>

        <div class="flex items-center gap-1.5" id="pricing-dots">
          <span class="h-1.5 rounded-full transition-all duration-300 pricing-dot w-1.5 bg-white/30" data-idx="0"></span>
          <span class="h-1.5 rounded-full transition-all duration-300 pricing-dot w-4 bg-[#ECA400]" data-idx="1"></span>
          <span class="h-1.5 rounded-full transition-all duration-300 pricing-dot w-1.5 bg-white/30" data-idx="2"></span>
        </div>

        <button
          id="btn-next-plan"
          class="px-3 py-1.5 rounded-lg bg-[#2A1F19] border border-white/15 text-xs font-bold text-[#ECA400] flex items-center gap-1 shadow-xs hover:bg-[#3A2B22] active:scale-95 transition-all cursor-pointer"
          aria-label="Paket Berikutnya"
        >
          <span data-i18n="pricing.btn_next">Berikutnya</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Guarantee & Security strip with SVGs -->
    <div class="pt-2 border-t border-white/10 text-center flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold text-white/60">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lock" size={13} color="#D4AF37" />
        <span data-i18n="pricing.guarantee_lifetime">Sekali Bayar • Lisensi Lifetime</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="refresh" size={13} color="#D4AF37" />
        <span data-i18n="pricing.guarantee_updates">Update Resep Gratis Selamanya</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="message-square" size={13} color="#D4AF37" />
        <span data-i18n="pricing.guarantee_support">Bantuan WhatsApp Barista</span>
      </span>
    </div>

  </div>
</section>

<script>
  // Slider Navigation for mobile
  const slider = document.getElementById('pricing-slider');
  const dots = document.querySelectorAll('.pricing-dot');
  const btnPrevPlan = document.getElementById('btn-prev-plan');
  const btnNextPlan = document.getElementById('btn-next-plan');

  let currentCardIndex = 1; // Start on Barista Pro (popular)

  function scrollToCard(index: number) {
    if (!slider) return;
    const cards = slider.children;
    if (cards[index]) {
      (cards[index] as HTMLElement).scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
    updateDots(index);
    currentCardIndex = index;
  }

  function updateDots(activeIdx: number) {
    dots.forEach((dot, i) => {
      if (i === activeIdx) {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 pricing-dot w-4 bg-[#ECA400]';
      } else {
        dot.className = 'h-1.5 rounded-full transition-all duration-300 pricing-dot w-1.5 bg-white/30';
      }
    });
  }

  // Mobile Prev / Next Buttons
  btnPrevPlan?.addEventListener('click', () => {
    const nextIdx = Math.max(0, currentCardIndex - 1);
    scrollToCard(nextIdx);
  });

  btnNextPlan?.addEventListener('click', () => {
    const nextIdx = Math.min(2, currentCardIndex + 1);
    scrollToCard(nextIdx);
  });

  // Sync Dots on natural touch swipe scroll
  slider?.addEventListener('scroll', () => {
    const scrollLeft = slider.scrollLeft;
    const card = slider.children[0] as HTMLElement;
    if (!card) return;
    const cardWidth = card.offsetWidth + 16; // card width + gap
    const activeIdx = Math.min(2, Math.max(0, Math.round(scrollLeft / cardWidth)));
    if (activeIdx !== currentCardIndex) {
      currentCardIndex = activeIdx;
      updateDots(activeIdx);
    }
  }, { passive: true });
</script>
