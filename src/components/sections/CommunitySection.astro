---
import Icon from '../ui/Icon.astro';
import PhoneMockup from '../mockup/PhoneMockup.astro';
import SocialCoffeeScreenMockup from '../mockup/SocialCoffeeScreenMockup.astro';
---

<section class="py-12 sm:py-16 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Phone Mockup with Social Coffee (5 cols) -->
      <div class="lg:col-span-5 flex justify-center order-2 lg:order-1">
        <PhoneMockup size="md" tilt="left" glow={true}>
          <SocialCoffeeScreenMockup />
        </PhoneMockup>
      </div>

      <!-- Right: Copywriting & Feature points (7 cols) -->
      <div class="lg:col-span-7 space-y-5 order-1 lg:order-2">
        
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E91E63]/10 text-[#E91E63] text-xs font-bold uppercase tracking-wider">
          <Icon name="users" size={13} color="#E91E63" />
          <span>KOMUNITAS PENIKMAT SPESIALTI</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight leading-tight">
          Berbagi resep, diskusi beans, <br />
          <span class="text-[#E91E63] font-serif italic">dan seduh bersama.</span>
        </h2>

        <p class="hidden sm:block text-xs sm:text-base text-[#6F655D] leading-relaxed">
          Kopi terasa lebih berharga saat dinikmati bersama komunitas. Social Coffee adalah wadah bagi home brewer dan barista di seluruh Indonesia untuk membagikan catatan rasa, eksplorasi beans nusantara, dan saling menduplikasi resep seduhan terbaik.
        </p>

        <!-- Feature Points (Compact 3 cards side-by-side on mobile: Copy Resep, Basecamp, Topics) -->
        <div class="grid grid-cols-3 lg:grid-cols-1 gap-2 sm:gap-3 pt-1">
          
          <div class="flex flex-col lg:flex-row items-center lg:items-start text-center lg:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-3 rounded-xl bg-white border border-[#E8DFD8] shadow-xs">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-pink-100 text-[#E91E63] flex items-center justify-center shrink-0">
              <Icon name="copy" size={14} color="#E91E63" />
            </div>
            <div class="min-w-0">
              <h4 class="font-extrabold text-[11px] sm:text-sm text-[#332B25] truncate">Copy Resep</h4>
              <p class="hidden sm:block text-xs text-[#6F655D] mt-0.5 leading-snug">
                Satu ketuk tombol 'Copy Resep' untuk otomatis menyimpan parameter seduhan teman ke HP Anda.
              </p>
            </div>
          </div>

          <div class="flex flex-col lg:flex-row items-center lg:items-start text-center lg:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-3 rounded-xl bg-white border border-[#E8DFD8] shadow-xs">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-100 text-[#6B4423] flex items-center justify-center shrink-0">
              <Icon name="users" size={14} color="#6B4423" />
            </div>
            <div class="min-w-0">
              <h4 class="font-extrabold text-[11px] sm:text-sm text-[#332B25] truncate">Basecamp</h4>
              <p class="hidden sm:block text-xs text-[#6F655D] mt-0.5 leading-snug">
                Kelompok slow bar privat untuk menyatukan SOP seduh antar barista secara rahasia dan aman.
              </p>
            </div>
          </div>

          <div class="flex flex-col lg:flex-row items-center lg:items-start text-center lg:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-3 rounded-xl bg-white border border-[#E8DFD8] shadow-xs">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
              <Icon name="tag" size={14} color="#1D4ED8" />
            </div>
            <div class="min-w-0">
              <h4 class="font-extrabold text-[11px] sm:text-sm text-[#332B25] truncate">Topics</h4>
              <p class="hidden sm:block text-xs text-[#6F655D] mt-0.5 leading-snug">
                Diskusi spesifik dripper dan beans: #V60, #Origami, #Aeropress, Kamojang, Puntang, & Gayo.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
