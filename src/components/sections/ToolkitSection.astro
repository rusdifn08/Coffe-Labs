---
import Icon from '../ui/Icon.astro';
import PhoneMockup from '../mockup/PhoneMockup.astro';
import ToolkitScreenMockup from '../mockup/ToolkitScreenMockup.astro';
import { landingData } from '../../data/landingData';
---

<section id="toolkit" class="py-8 sm:py-12 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-1.5 mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-[#6B4423]/10 text-[#6B4423] text-[11px] font-bold uppercase tracking-wider">
        <Icon name="wrench" size={12} color="#6B4423" />
        <span data-i18n="toolkit.badge">PROFESSIONAL SUITE</span>
      </div>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#332B25] tracking-tight" data-i18n="toolkit.title">
        Peralatan presisi barista, selalu siap di saku Anda.
      </h2>
      <p class="hidden sm:block text-xs sm:text-sm text-[#6F655D]" data-i18n="toolkit.desc">
        Dirancang khusus untuk home brewer, barista slow bar, hingga profesional coffee evaluator.
      </p>
    </div>

    <!-- 2 Column Layout: Toolkit Cards (7 cols), Phone Mockup (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-center">
      
      <!-- Left: 6 Toolkit Items Grid (Compact 3x2 on mobile, 2-cols/3-cols on desktop) -->
      <div class="lg:col-span-7">
        <div class="grid grid-cols-3 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3">
          {landingData.toolkitItems.map((item, idx) => (
            <div class="p-2 sm:p-3.5 rounded-xl bg-white border border-[#E8DFD8] shadow-xs hover:shadow-warm-sm hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-center sm:text-left">
              <div>
                <div class={`w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-gradient-to-tr ${item.gradient} flex items-center justify-center mb-1.5 mx-auto sm:mx-0 shadow-xs`}>
                  <Icon name={idx === 0 ? 'heart' : idx === 1 ? 'disc' : idx === 2 ? 'store' : idx === 3 ? 'radar' : idx === 4 ? 'book' : 'users'} size={14} color={item.primaryColor} />
                </div>
                <h4 class="font-bold text-[10.5px] sm:text-sm text-[#332B25] truncate">{item.title}</h4>
                <div class="text-[8.5px] sm:text-[10px] font-semibold text-[#6B4423] mt-0.5 truncate">{item.subtitle}</div>
                <p class="hidden sm:block text-[11px] sm:text-xs text-[#6F655D] mt-1 leading-snug">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Phone Mockup showing Toolkit Screen (5 cols, Compact Size) -->
      <div class="lg:col-span-5 flex justify-center">
        <PhoneMockup size="sm" tilt="none" glow={true}>
          <ToolkitScreenMockup />
        </PhoneMockup>
      </div>

    </div>

  </div>
</section>
