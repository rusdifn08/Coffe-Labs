---

<section id="toolkit" class="py-10 sm:py-14 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2 mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#6B4423]/10 text-[#6B4423] text-[11px] font-extrabold uppercase tracking-wider">
        <Icon name="wrench" size={12} color="#6B4423" />
        <span data-i18n="toolkit.badge">PROFESSIONAL PRO SUITE • 4 KATEGORI & 21 FITUR</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#332B25] tracking-tight" data-i18n="toolkit.title">
        Peralatan presisi barista, selalu siap di saku Anda.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D] max-w-2xl mx-auto" data-i18n="toolkit.desc">
        Sama persis seperti di aplikasi mobile: 21 instrumen presisi terbagi dalam Learning Brew, Lab Ekstraksi & AI, Sains Kopi & Kesegaran, serta Ekosistem & Komunitas.
      </p>
    </div>

    <!-- 2 Column Layout: Left Categorized Toolkit Showcase (7 cols), Right Live Phone Mockup (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- Left: Category Filter Pills + Toolkit Cards Grid (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <!-- Interactive Category Tabs -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-1.5" role="tablist" aria-label="Kategori Barista Toolkit">
          {toolkitCategories.map((cat, idx) => (
            <button
              type="button"
              data-tk-cat={cat.id}
              data-tk-scroll={cat.mockupTarget}
              class={`tk-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer border ${
                idx === 0
                  ? 'bg-[#6B4423] text-white border-[#6B4423] shadow-xs'
                  : 'bg-white text-[#6F655D] border-[#E8DFD8] hover:border-[#6B4423]/40 hover:text-[#332B25]'
              }`}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Cards Grid (Matches Flutter ToolkitCard design: Icon top-left, category badge/chevron top-right, title & subtitle) -->
        <div id="tk-cards-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {allToolkitCards.map((item) => (
            <div
              data-card-cat={item.category}
              data-card-featured={item.featured ? 'true' : 'false'}
              class={`tk-feature-card p-3 rounded-2xl bg-white border border-[#ECE2D6] shadow-xs hover:shadow-warm-sm hover:-translate-y-0.5 hover:border-[#6B4423]/40 transition-all duration-200 flex flex-col justify-between ${
                item.featured ? '' : 'hidden'
              }`}
            >
              <div>
                <div class="flex items-center justify-between gap-1.5 mb-2">
                  <div class={`w-8 h-8 rounded-[10px] bg-gradient-to-br ${item.gradient} flex items-center justify-center shrink-0 shadow-2xs`}>
                    <Icon name={item.icon} size={15} color={item.primaryColor} />
                  </div>
                  <span class="px-1.5 py-0.5 rounded-md bg-[#F9F6F0] border border-[#E8DFD8] text-[9px] font-bold text-[#6B4423] truncate">
                    {item.catBadge}
                  </span>
                </div>
                <h4 class="font-extrabold text-xs sm:text-[13px] text-[#332B25] leading-snug truncate">{item.title}</h4>
                <div class="text-[10px] font-semibold text-[#6B4423] mt-0.5 truncate">{item.subtitle}</div>
                <p class="hidden sm:block text-[11px] text-[#6F655D] mt-1 leading-relaxed line-clamp-2">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right: Phone Mockup showing full scrollable 4-section Toolkit Screen (5 cols) -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <PhoneMockup size="md" tilt="none" glow={true}>
          <ToolkitScreenMockup />
        </PhoneMockup>
        <div class="mt-2.5 text-center">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-white border border-[#E8DFD8] text-[10px] font-semibold text-[#8F857D] shadow-xs">
            <Icon name="sparkles" size={10} color="#6B4423" />
            <span>Scroll layar HP atau klik tab kategori di kiri untuk menjelajahi 21 fitur</span>
          </span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const catButtons = document.querySelectorAll('.tk-cat-btn');
  const featureCards = document.querySelectorAll<HTMLElement>('.tk-feature-card');

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-tk-cat');
      const scrollTarget = btn.getAttribute('data-tk-scroll');

      // Update active button state
      catButtons.forEach((b) => {
        b.classList.remove('bg-[#6B4423]', 'text-white', 'border-[#6B4423]', 'shadow-xs');
        b.classList.add('bg-white', 'text-[#6F655D]', 'border-[#E8DFD8]');
      });
      btn.classList.remove('bg-white', 'text-[#6F655D]', 'border-[#E8DFD8]');
      btn.classList.add('bg-[#6B4423]', 'text-white', 'border-[#6B4423]', 'shadow-xs');

      // Filter cards
      featureCards.forEach((card) => {
        const cardCat = card.getAttribute('data-card-cat');
        const isFeatured = card.getAttribute('data-card-featured') === 'true';
        if (cat === 'featured') {
          card.classList.toggle('hidden', !isFeatured);
        } else {
          card.classList.toggle('hidden', cardCat !== cat);
        }
      });

      // Scroll inside toolkit phone mockup(s)
      if (scrollTarget) {
        document.querySelectorAll('.toolkit-mockup-scroll').forEach((scrollContainer) => {
          const secEl = scrollContainer.querySelector<HTMLElement>(`[data-mockup-section="${scrollTarget}"]`);
          if (secEl) {
            scrollContainer.scrollTo({
              top: Math.max(0, secEl.offsetTop - 12),
              behavior: 'smooth',
            });
          }
        });
      }
    });
  });
</script>
