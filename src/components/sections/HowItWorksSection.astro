---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-12 sm:py-16 bg-[#F9F6F0] border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="sparkles" size={13} color="#6B4423" />
        <span>LANGKAH MUDAH</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight">
        Cara memulai seduhan presisi hanya dalam 3 langkah.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D]">
        Tak perlu pengaturan rumit. Unduh aplikasinya dan langsung seduh kopi terbaik Anda hari ini.
      </p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      
      {landingData.howItWorks.map((step) => (
        <div class="p-5 sm:p-6 rounded-xl bg-white border border-[#E8DFD8] shadow-xs relative flex flex-col justify-between hover:shadow-warm-sm transition-shadow">
          
          <div>
            <!-- Big Step Number -->
            <div class="w-10 h-10 rounded-lg bg-[#F1E8E0] text-[#6B4423] font-black text-lg font-mono flex items-center justify-center mb-3 shadow-xs border border-[#6B4423]/15">
              {step.step}
            </div>

            <h3 class="text-base sm:text-lg font-extrabold text-[#332B25] tracking-tight mb-1.5">
              {step.title}
            </h3>

            <p class="text-xs sm:text-sm text-[#6F655D] leading-relaxed">
              {step.desc}
            </p>
          </div>

          <!-- Step label indicator -->
          <div class="mt-4 pt-3 border-t border-[#E8DFD8] text-[11px] font-bold text-[#8F857D] flex items-center gap-1.5">
            <Icon name="home" size={12} color="#8F857D" />
            <span>{step.mockupLabel}</span>
          </div>

        </div>
      ))}

    </div>

  </div>
</section>
