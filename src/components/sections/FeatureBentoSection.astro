---
import Icon from '../ui/Icon.astro';
import ThermalReceiptSheetMockup from '../mockup/ThermalReceiptSheetMockup.astro';
import PhoneMockup from '../mockup/PhoneMockup.astro';
import SocialCoffeeScreenMockup from '../mockup/SocialCoffeeScreenMockup.astro';
import { landingData } from '../../data/landingData';
---

<section id="fitur" class="py-8 sm:py-12 lg:py-14 bg-white border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Simplified & 1 line as requested) -->
    <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 space-y-1.5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="sparkles" size={13} color="#6B4423" />
        <span>Fitur Unggulan</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#332B25] tracking-tight">
        Semua yang Anda butuhkan untuk seduhan sempurna di setiap cangkir.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D] truncate max-w-2xl mx-auto">
        Studio seduhan presisi dengan algoritma kalkulasi rasio, 200+ resep juara, dan evaluasi sensori profesional.
      </p>
    </div>

    <!-- Bento Grid (Compact 2-grid on mobile, 1x4 12-cols row on desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-2.5 sm:gap-4 lg:gap-4">
      
      <!-- Tile 1: Guided Brew Timer (1x4 on desktop: lg:col-span-3) -->
      <div class="col-span-1 lg:col-span-3 bg-[#F9F6F0] rounded-xl p-3 sm:p-4 border border-[#E8DFD8] shadow-xs flex flex-col justify-between hover:shadow-warm-sm transition-shadow">
        <div class="space-y-1 sm:space-y-1.5">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#6B4423] text-white flex items-center justify-center shrink-0">
              <Icon name="timer" size={13} color="#FFFFFF" />
            </span>
            <span class="px-1.5 py-0.5 rounded bg-[#6B4423]/10 text-[#6B4423] text-[9px] sm:text-[10px] font-extrabold tracking-wider uppercase truncate">
              PANDUAN SEDUH
            </span>
          </div>
          <h3 class="text-xs sm:text-base font-extrabold text-[#332B25] tracking-tight leading-snug">
            Guided Brew Timer
          </h3>
          <p class="hidden sm:block text-xs text-[#6F655D] leading-relaxed">
            Mata tetap fokus pada timbangan. Layar memandu detik dan gramasi air target setiap tuangan secara otomatis.
          </p>
        </div>
        <div class="mt-2 pt-2 border-t border-[#E8DFD8] flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-[#6B4423]">
          <Icon name="check" size={11} color="#6B4423" />
          <span>Timer Presisi</span>
        </div>
      </div>

      <!-- Tile 2: Resep Barista Dunia (1x4 on desktop: lg:col-span-3) -->
      <div class="col-span-1 lg:col-span-3 bg-gradient-to-br from-[#6B4423] to-[#4A2D15] text-white rounded-xl p-3 sm:p-4 shadow-xs flex flex-col justify-between">
        <div class="space-y-1 sm:space-y-1.5">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#ECA400] text-[#332B25] flex items-center justify-center shrink-0">
              <Icon name="book" size={13} color="#332B25" />
            </span>
            <span class="px-1.5 py-0.5 rounded bg-[#ECA400] text-[#332B25] text-[9px] sm:text-[10px] font-extrabold tracking-wider uppercase truncate">
              200+ RESEP
            </span>
          </div>
          <h3 class="text-xs sm:text-base font-extrabold text-white tracking-tight leading-snug">
            Resep Barista Dunia
          </h3>
          <p class="hidden sm:block text-xs text-white/80 leading-relaxed">
            Metode 4:6 Tetsu Kasuya, Single-Pour Hoffmann, racikan Mikael Jasin, hingga Japanese Iced.
          </p>
        </div>
        <div class="mt-2 pt-2 border-t border-white/15 flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-amber-200">
          <Icon name="sparkles" size={11} color="#FDE68A" />
          <span>Juara Dunia</span>
        </div>
      </div>

      <!-- Tile 3: Brew Doctor (1x4 on desktop: lg:col-span-3) -->
      <div class="col-span-1 lg:col-span-3 bg-[#F9F6F0] rounded-xl p-3 sm:p-4 border border-[#E8DFD8] shadow-xs flex flex-col justify-between">
        <div class="space-y-1 sm:space-y-1.5">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-amber-100 text-[#ECA400] flex items-center justify-center shrink-0 font-bold">
              <Icon name="stethoscope" size={13} color="#ECA400" />
            </span>
            <span class="px-1.5 py-0.5 rounded bg-amber-500/10 text-[#ECA400] text-[9px] sm:text-[10px] font-extrabold tracking-wider uppercase truncate">
              KOREKSI RASA
            </span>
          </div>
          <h3 class="text-xs sm:text-base font-extrabold text-[#332B25] tracking-tight leading-snug">
            Brew Doctor
          </h3>
          <p class="hidden sm:block text-xs text-[#6F655D] leading-relaxed">
            Kopi terlalu asam atau pahit? Evaluasi rasa sensori di lidah, sistem mendiagnosis dan memberi saran klik grinder & suhu.
          </p>
        </div>
        <div class="mt-2 pt-2 border-t border-[#E8DFD8] flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-emerald-800">
          <Icon name="target" size={11} color="#15803D" />
          <span>Sweet Spot</span>
        </div>
      </div>

      <!-- Tile 4: Cupping SCA (1x4 on desktop: lg:col-span-3) -->
      <div class="col-span-1 lg:col-span-3 bg-[#F9F6F0] rounded-xl p-3 sm:p-4 border border-[#E8DFD8] shadow-xs flex flex-col justify-between">
        <div class="space-y-1 sm:space-y-1.5">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-orange-100 text-orange-700 flex items-center justify-center shrink-0 font-bold">
              <Icon name="disc" size={13} color="#E65100" />
            </span>
            <span class="px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-700 text-[9px] sm:text-[10px] font-extrabold tracking-wider uppercase truncate">
              EVALUASI SCA
            </span>
          </div>
          <h3 class="text-xs sm:text-base font-extrabold text-[#332B25] tracking-tight leading-snug">
            Cupping SCA
          </h3>
          <p class="hidden sm:block text-xs text-[#6F655D] leading-relaxed">
            Form cupping standar Specialty Coffee Association. Skoring Clean Cup, Acidity, Sweetness, dan 92 flavor notes.
          </p>
        </div>
        <div class="mt-2 pt-2 border-t border-[#E8DFD8] flex items-center gap-1 text-[10px] sm:text-[11px] font-bold text-orange-800">
          <Icon name="sparkles" size={11} color="#C2410C" />
          <span>Flavor Wheel</span>
        </div>
      </div>

      <!-- Tile 5: Social Coffee & Basecamp (WITH REAL PHONE MOCKUP PREVIEW) -->
      <div class="col-span-2 lg:col-span-7 bg-[#F9F6F0] rounded-xl p-4 sm:p-6 border border-[#E8DFD8] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 overflow-hidden">
        <div class="space-y-2 sm:max-w-xs text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <span class="w-7 h-7 rounded-lg bg-[#E91E63] text-white flex items-center justify-center">
              <Icon name="users" size={14} color="#FFFFFF" />
            </span>
            <span class="px-2 py-0.5 rounded bg-[#FCE4EC] text-[#E91E63] text-[10px] font-extrabold tracking-wider uppercase">
              KOMUNITAS BARISTA
            </span>
          </div>

          <h3 class="text-lg sm:text-xl font-extrabold text-[#332B25] tracking-tight">
            Social Coffee & Basecamp Grup
          </h3>

          <p class="text-xs text-[#6F655D] leading-relaxed">
            Unggah resep racikan Anda, beri ulasan beans roastery favorit, dan gunakan fitur satu-klik <strong>'Copy Resep'</strong> untuk langsung menyeduh resep teman Anda di rumah.
          </p>

          <div class="flex flex-wrap gap-1.5 justify-center sm:justify-start text-[10px] font-bold text-[#E91E63]">
            <span class="px-2 py-0.5 bg-[#FCE4EC] rounded">#V60</span>
            <span class="px-2 py-0.5 bg-[#FCE4EC] rounded">#Origami</span>
            <span class="px-2 py-0.5 bg-[#FCE4EC] rounded">#JapaneseIced</span>
            <span class="px-2 py-0.5 bg-[#FCE4EC] rounded">#Puntang</span>
          </div>
        </div>

        <!-- Phone Mockup Preview for Social Coffee inside this Tile -->
        <div class="shrink-0 w-full sm:w-auto flex justify-center">
          <PhoneMockup size="sm" tilt="none" glow={false} class="scale-90 sm:scale-95 origin-center">
            <SocialCoffeeScreenMockup />
          </PhoneMockup>
        </div>
      </div>

      <!-- Tile 6: Thermal Receipt Bluetooth (Full 2-cols on mobile, 5 cols on lg) -->
      <div class="col-span-2 lg:col-span-5 bg-zinc-900 text-white rounded-xl p-4 sm:p-6 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-5 overflow-hidden w-full">
        <div class="space-y-2 sm:max-w-[190px] text-center sm:text-left">
          <span class="px-2 py-0.5 rounded bg-amber-400 text-zinc-950 text-[9px] font-extrabold tracking-wider uppercase">
            BAR & CAFÉ
          </span>
          <h3 class="text-base sm:text-lg font-extrabold text-white tracking-tight">
            Cetak Struk Bluetooth
          </h3>
          <p class="text-xs text-zinc-300 leading-relaxed">
            Terhubung ke printer thermal kasir 58mm/80mm standar POS untuk slow bar.
          </p>
        </div>

        <div class="shrink-0 w-full sm:w-auto flex justify-center scale-90 sm:scale-95 origin-center">
          <ThermalReceiptSheetMockup />
        </div>
      </div>

    </div>

  </div>
</section>
