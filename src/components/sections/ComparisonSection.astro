---
import Icon from '../ui/Icon.astro';
import { landingData } from '../../data/landingData';
---

<section class="py-12 sm:py-16 bg-white border-t border-[#E8DFD8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-[#6B4423] text-xs font-bold uppercase tracking-wider">
        <Icon name="sliders" size={13} color="#6B4423" />
        <span>MENGAPA COFFEE LABS</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#332B25] tracking-tight" data-i18n="comparison.title">
        Perbandingan jelas untuk penyeduh kopi berstandar tinggi.
      </h2>
      <p class="text-xs sm:text-sm text-[#6F655D]">
        Lihat bagaimana Coffee Labs memberikan ekosistem seduh terlengkap dibandingkan stopwatch biasa atau aplikasi timer sederhana.
      </p>
    </div>

    <!-- Comparison Table (2 Perbandingan: Coffee Labs vs Aplikasi Lain) -->
    <div class="overflow-x-auto rounded-xl border border-[#E8DFD8] shadow-xs">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="bg-[#F9F6F0] text-[#332B25] border-b border-[#E8DFD8]">
            <th class="p-3.5 sm:p-4 font-extrabold w-1/2" data-i18n="comparison.col_feature">Fitur & Kemampuan</th>
            <th class="p-3.5 sm:p-4 font-extrabold text-center bg-amber-100/60 text-[#6B4423] border-x border-[#E8DFD8] w-1/4">
              <span class="inline-flex items-center gap-1.5">
                <Icon name="coffee" size={14} color="#6B4423" />
                <span>Coffee Labs</span>
              </span>
            </th>
            <th class="p-3.5 sm:p-4 font-bold text-center text-[#8F857D] w-1/4" data-i18n="comparison.col_other">
              Aplikasi Lain
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E8DFD8]">
          {landingData.comparisonTable.map((row) => (
            <tr class="hover:bg-amber-50/15 transition-colors">
              <td class="p-3 sm:p-4 font-bold text-[#332B25]">
                {row.feature}
              </td>
              <td class="p-3 sm:p-4 text-center font-extrabold text-[#6B4423] bg-amber-100/30 border-x border-[#E8DFD8]">
                <div class="inline-flex items-center justify-center gap-1 text-emerald-800 font-bold">
                  <Icon name="check" size={13} color="#15803D" />
                  <span>{row.coffeeLabs}</span>
                </div>
              </td>
              <td class="p-3 sm:p-4 text-center font-medium text-[#8F857D]">
                {row.otherApp === 'Tidak Ada' ? (
                  <span class="text-red-500 font-bold inline-flex items-center gap-1 justify-center">
                    <Icon name="x" size={12} color="#EF4444" />
                    <span>Tidak Ada</span>
                  </span>
                ) : (
                  row.otherApp
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </div>
</section>
