---
interface Props {
  tilt?: 'left' | 'right' | 'none';
  size?: 'sm' | 'md' | 'lg';
  glow?: boolean;
  class?: string;
  dynamicIsland?: boolean;
}

const {
  tilt = 'none',
  size = 'md',
  glow = true,
  class: className = '',
  dynamicIsland = true,
} = Astro.props;

const tiltClass = tilt === 'left' ? '-rotate-3 hover:rotate-0 transition-transform duration-500' : tilt === 'right' ? 'rotate-3 hover:rotate-0 transition-transform duration-500' : '';

const sizeClass = size === 'sm' ? 'w-[240px] h-[490px]' : size === 'lg' ? 'w-[310px] sm:w-[330px] h-[640px] sm:h-[680px]' : 'w-[280px] sm:w-[300px] h-[580px] sm:h-[620px]';
---

<div class={`relative inline-block select-none ${tiltClass} ${className}`}>
  <!-- Warm glow effect behind phone -->
  {glow && (
    <div class="absolute -inset-4 sm:-inset-6 bg-radial from-amber-500/25 via-espresso-600/10 to-transparent blur-2xl -z-10 rounded-[60px] pointer-events-none"></div>
  )}

  <!-- Phone outer chassis (metallic dark roast frame) -->
  <div class={`relative ${sizeClass} bg-[#1E1612] p-[10px] rounded-[48px] shadow-[0_30px_70px_-15px_rgba(30,22,18,0.5),0_0_0_1px_rgba(255,255,255,0.08)_inset]`}>
    
    <!-- Phone inner border (screen bezel) -->
    <div class="relative w-full h-full bg-[#F9F6F0] rounded-[38px] overflow-hidden flex flex-col border border-[#3A2B22]/40 text-[#332B25]">
      
      <!-- Top Status Bar & Dynamic Island -->
      <div class="relative z-30 pt-2 px-5 pb-1 flex items-center justify-between text-[11px] font-semibold text-[#332B25] select-none bg-transparent">
        <span class="tracking-tight">9:41</span>
        
        {dynamicIsland && (
          <div class="absolute left-1/2 -translate-x-1/2 top-2 h-[18px] w-[86px] bg-black rounded-full flex items-center justify-end px-2 gap-1.5 shadow-sm">
            <div class="w-2 h-2 rounded-full bg-[#1A1A1A] border border-white/10"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500/80 animate-pulse"></div>
          </div>
        )}

        <div class="flex items-center gap-1.5">
          <!-- Signal Icon -->
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 18.25A10.93 10.93 0 0 1 1 12C1 5.92 5.92 1 12 1s11 4.92 11 11c0 2.33-.73 4.49-1.97 6.27l-.62-.64C21.45 16.14 22 14.16 22 12c0-4.97-4.03-9-9-9z"/>
            <path d="M12 6c-3.31 0-6 2.69-6 6 0 1.48.54 2.83 1.44 3.88l.71-.71A4.95 4.95 0 0 1 7 12c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.19-.42 2.28-1.12 3.14l.71.71C17.47 14.82 18 13.48 18 12c0-3.31-2.69-6-6-6z"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
          <!-- Wifi Icon -->
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.78 0 7.21 1.45 9.77 3.84L12 19.34 2.23 11.34C4.79 8.95 8.22 7.5 12 7.5z"/>
          </svg>
          <!-- Battery Icon -->
          <div class="w-4 h-2 border border-current rounded-[3px] p-[1px] flex items-center">
            <div class="h-full w-full bg-current rounded-[1px]"></div>
          </div>
        </div>
      </div>

      <!-- Screen Slot (App Content) -->
      <div class="relative flex-1 overflow-y-auto overflow-x-hidden flex flex-col no-scrollbar">
        <slot />
      </div>

      <!-- Home bar indicator at bottom -->
      <div class="relative z-30 pb-2 pt-1 flex justify-center bg-transparent pointer-events-none">
        <div class="w-28 h-1 bg-[#332B25]/30 rounded-full"></div>
      </div>

    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
