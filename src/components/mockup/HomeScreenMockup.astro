---
// Exact 1:1 Flutter UI replication for HomeScreen (home_screen.dart)
import Icon from '../ui/Icon.astro';
import MobileBottomNav from './MobileBottomNav.astro';

const brewMethods = [
  { name: 'V60 Pour Over', img: '/images/methods/hario_v60.png', count: '12x' },
  { name: 'Japanese Iced', img: '/images/methods/japanese_drip.png', count: '8x' },
  { name: 'Origami Drip', img: '/images/methods/origami_dripper.png', count: '5x' },
  { name: 'AeroPress', img: '/images/methods/aeropress.png', count: '3x' },
];

const baristas = [
  { name: 'Tetsu K.', img: '/images/avatars/portraits/tetsu_kasuya.jpg', count: '8x' },
  { name: 'Mikael J.', img: '/images/avatars/portraits/mikael_jasin.jpg', count: '6x' },
  { name: 'Chad W.', img: '/images/avatars/portraits/chad_wang.jpg', count: '5x' },
  { name: 'Dody S.', img: '/images/avatars/portraits/dody_samsura.jpg', count: '4x' },
];
---

<div class="relative flex-1 flex flex-col justify-between bg-[#F9F6F0] text-[#332B25] select-none text-xs h-full overflow-hidden">
  
  <!-- Main Scrollable Home Content -->
  <div class="p-3 pb-14 space-y-2.5 overflow-y-auto no-scrollbar flex-1">
    
    <!-- 1. HomeHeaderProfileRow (Gamified Squircle Avatar + Rank Pill + EXP Progress Bar) -->
    <div class="flex items-center gap-2.5">
      <!-- Gamified Squircle Avatar with Level Badge -->
      <div class="relative shrink-0">
        <div class="w-11 h-11 rounded-[14px] p-[2px] bg-gradient-to-tr from-[#6B4423] via-[#D4AF37] to-[#8D4925] shadow-xs">
          <div class="w-full h-full rounded-[12px] overflow-hidden bg-[#EFE5DC]">
            <img src="/images/characters/char_avatar_1.jpg" alt="Rusdi Barista" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 px-1.5 py-[1px] rounded-full bg-[#5D6B7A] text-white text-[7px] font-extrabold tracking-tight border border-white shadow-2xs whitespace-nowrap">
          ⚙ LV.3
        </span>
      </div>

      <!-- Profile Info & EXP Bar -->
      <div class="flex-1 min-w-0">
        <!-- Row 1: Greeting + Rank Title Badge + Bell + Heart -->
        <div class="flex items-center justify-between gap-1">
          <div class="flex items-center gap-1 min-w-0">
            <span class="text-[9px] text-[#6F655D] font-medium shrink-0">Selamat pagi,</span>
            <span class="px-1.5 py-[1.5px] rounded bg-gradient-to-r from-[#5D6B7A] to-[#3E4C59] text-white text-[7.5px] font-extrabold truncate shadow-2xs">
              Extraction Craftsman
            </span>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <!-- Notification Bell -->
            <div class="relative w-5 h-5 rounded-full bg-[#6B4423]/8 flex items-center justify-center text-[#6B4423]">
              <svg class="w-3 h-3 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 0 0-5-5.9V4a1 1 0 1 0-2 0v1.1A6 6 0 0 0 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 1 1-6 0v-1m6 0H9" />
              </svg>
              <span class="absolute top-0.5 right-0.5 w-1.5 h-1.5 rounded-full bg-[#ECA400] border border-white"></span>
            </div>
            <!-- Favorite Heart -->
            <div class="w-5 h-5 rounded-full bg-[#6B4423]/8 flex items-center justify-center text-[#6B4423]">
              <Icon name="heart" size={10} color="#6B4423" />
            </div>
          </div>
        </div>

        <!-- Row 2: User Display Name -->
        <div class="text-[12.5px] font-extrabold text-[#332B25] leading-tight truncate mt-0.5">
          Rusdi Barista
        </div>

        <!-- Row 3: EXP Progress Bar -->
        <div class="flex items-center gap-1.5 mt-0.5">
          <div class="flex-1 h-1 bg-[#E5DDD5] rounded-full overflow-hidden">
            <div class="h-full w-[65%] bg-gradient-to-r from-[#6B4423] to-[#ECA400] rounded-full"></div>
          </div>
          <span class="text-[8px] font-extrabold text-[#6B4423] shrink-0">825 EXP ›</span>
        </div>
      </div>
    </div>

    <!-- 2. Main Headline -->
    <div class="pt-0.5">
      <h3 class="text-[16px] font-extrabold text-[#332B25] leading-[1.12] tracking-tight">
        Mau brew<br />apa hari ini?
      </h3>
      <p class="text-[9px] text-[#8F857D] mt-0.5">
        Eksplorasi resep presisi, inspirasi seduh, dan kreasi rasa terbaik.
      </p>
    </div>

    <!-- 3. HomeQuickAccessSection (Akses Cepat: Social, Marketplace, Beans Radar) -->
    <div>
      <div class="text-[9.5px] font-bold text-[#7D7268] mb-1">Akses Cepat</div>
      <div class="grid grid-cols-3 gap-1.5">
        <!-- Social -->
        <div class="bg-white py-1.5 px-1 rounded-xl border border-[#6B4423]/10 shadow-2xs flex flex-col items-center text-center">
          <div class="w-6 h-6 rounded-lg bg-[#FCE4EC] border border-[#F8BBD0] flex items-center justify-center text-[#E91E63]">
            <Icon name="users" size={11} color="#E91E63" />
          </div>
          <span class="text-[8.5px] font-bold text-[#332B25] mt-1">Social</span>
        </div>
        <!-- Marketplace -->
        <div class="bg-white py-1.5 px-1 rounded-xl border border-[#6B4423]/10 shadow-2xs flex flex-col items-center text-center">
          <div class="w-6 h-6 rounded-lg bg-[#FBE9E7] border border-[#FFCCBC] flex items-center justify-center text-[#8D4925]">
            <Icon name="store" size={11} color="#8D4925" />
          </div>
          <span class="text-[8.5px] font-bold text-[#332B25] mt-1">Marketplace</span>
        </div>
        <!-- Beans Radar -->
        <div class="bg-white py-1.5 px-1 rounded-xl border border-[#6B4423]/10 shadow-2xs flex flex-col items-center text-center">
          <div class="w-6 h-6 rounded-lg bg-[#E0F2F1] border border-[#B2DFDB] flex items-center justify-center text-[#00796B]">
            <Icon name="radar" size={11} color="#00796B" />
          </div>
          <span class="text-[8.5px] font-bold text-[#332B25] mt-1">Beans Radar</span>
        </div>
      </div>
    </div>

    <!-- 4. HomeBrewMethodsSection (Metode Seduh with Real 3D Assets & Usage Badge) -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-[10.5px] font-extrabold text-[#332B25]">Metode Seduh</span>
        <span class="text-[8.5px] font-semibold text-[#6B4423]">Lihat Semua ›</span>
      </div>
      <div class="grid grid-cols-4 gap-1.5">
        {brewMethods.map((m) => (
          <div class="flex flex-col items-center text-center">
            <div class="relative w-12 h-12 rounded-2xl bg-white border border-black/5 shadow-2xs p-1.5 flex items-center justify-center">
              <img src={m.img} alt={m.name} class="w-full h-full object-contain" />
              <span class="absolute -top-1 -right-1 px-1 py-[0.5px] rounded bg-[#ECA400] text-white text-[7px] font-extrabold border border-white shadow-2xs">
                {m.count}
              </span>
            </div>
            <span class="text-[8px] font-semibold text-[#2B2824] mt-1 truncate w-full">{m.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 5. HomeBeanRecommenderBanner (Smart Brew Presisi) -->
    <div class="p-2 rounded-xl bg-gradient-to-r from-[#2C221E] to-[#453427] text-white shadow-xs flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-[#D4AF37]/20 border border-[#D4AF37]/40 flex items-center justify-center shrink-0">
        <Icon name="sparkles" size={13} color="#D4AF37" />
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-[10px] font-bold text-white leading-tight truncate">Smart Brew Presisi</div>
        <div class="text-[8px] text-white/80 truncate">Pilih 230+ biji roastery & resep otomatis</div>
      </div>
      <span class="px-2 py-1 rounded-lg bg-white/12 border border-white/20 text-[8.5px] font-bold text-[#F3E7D8] shrink-0">
        Mulai ›
      </span>
    </div>

    <!-- 6. Barista Spotlight -->
    <div>
      <div class="text-[10.5px] font-extrabold text-[#332B25] mb-1">Barista Spotlight</div>
      <div class="grid grid-cols-4 gap-1.5">
        {baristas.map((b) => (
          <div class="flex flex-col items-center text-center">
            <div class="relative w-11 h-11 rounded-full border-2 border-white shadow-xs overflow-hidden bg-amber-50">
              <img src={b.img} alt={b.name} class="w-full h-full object-cover" />
              <span class="absolute bottom-0 right-0 px-1 py-[0.5px] rounded bg-[#ECA400] text-white text-[6.5px] font-extrabold border border-white">
                {b.count}
              </span>
            </div>
            <span class="text-[8px] font-semibold text-[#332B25] mt-0.5 truncate w-full">{b.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 7. Resep Pilihan Rekomendasi -->
    <div>
      <div class="text-[10.5px] font-extrabold text-[#332B25] mb-1">Resep Pilihan Rekomendasi</div>
      <div class="bg-white p-2 rounded-xl border border-[#E8DFD8] shadow-2xs flex gap-2 items-center">
        <div class="w-10 h-10 rounded-xl bg-[#FAF3EC] border border-[#E8DFD8] p-1 flex items-center justify-center shrink-0">
          <img src="/images/methods/hario_v60.png" alt="V60" class="w-full h-full object-contain" />
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1 text-[8px] text-[#D97706] font-extrabold">
            <span>★ WBrC Champion</span>
            <span>•</span>
            <span>1:15</span>
          </div>
          <div class="font-bold text-[10px] text-[#332B25] truncate">Metode 4:6 Multi-Pour Neo</div>
          <div class="text-[8px] text-[#8F857D] truncate">Tetsu Kasuya 🇯🇵 • 20g / 300ml • 92°C</div>
        </div>
        <div class="w-6 h-6 rounded-full bg-[#6B4423] text-white flex items-center justify-center shrink-0 shadow-2xs">
          <Icon name="play" size={8} color="#FFFFFF" />
        </div>
      </div>
    </div>

  </div>

  <!-- Floating AI Bean Scanner Camera FAB (HomeFloatingScannerFab) -->
  <div
    class="absolute bottom-[56px] right-3 z-20 w-9 h-9 rounded-full bg-gradient-to-br from-[#5C3A21] to-[#382315] border-[1.5px] border-[#D4AF37] shadow-[0_4px_12px_rgba(92,58,33,0.45)] flex items-center justify-center"
    title="Scan Kemasan Kopi (AI Vision)"
  >
    <!-- Viewfinder Icon -->
    <svg class="w-4 h-4 text-[#F9F5EE]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 7V5a2 2 0 0 1 2-2h2" />
      <path d="M17 3h2a2 2 0 0 1 2 2v2" />
      <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
      <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-[#D4AF37] border border-[#382315]"></span>
  </div>

  <!-- Custom Elevated Notched Bottom Navigation Bar -->
  <MobileBottomNav activeTab="home" />

</div>
