---
// Exact 1:1 Flutter UI replication for Profil Pengguna Screen (profile_screen.dart)
import Icon from '../ui/Icon.astro';
import MobileBottomNav from './MobileBottomNav.astro';
---

<div class="flex-1 flex flex-col justify-between bg-[#F9F6F0] text-[#332B25] select-none text-xs h-full overflow-hidden">
  
  <div class="p-3 space-y-2.5 overflow-y-auto no-scrollbar flex-1">
    
    <!-- Top AppBar (Profil Pengguna + Gear Icon) -->
    <div class="relative flex items-center justify-center pb-0.5">
      <h3 class="text-[13px] font-extrabold text-[#332B25] leading-tight">Profil Pengguna</h3>
      <div class="absolute right-0 w-6 h-6 rounded-full flex items-center justify-center text-[#332B25]">
        <Icon name="gear" size={14} color="#332B25" />
      </div>
    </div>

    <!-- 1. UserProfileHeaderCard (Squircle Avatar + Level Roadmap + 4 Gamification Stat Boxes) -->
    <div class="bg-white p-2.5 rounded-2xl border border-[#ECE2D6] shadow-2xs space-y-2">
      <!-- Avatar + Name + Badges -->
      <div class="flex items-center gap-2.5">
        <div class="relative shrink-0">
          <div class="w-12 h-12 rounded-2xl p-[2px] bg-gradient-to-tr from-[#7E57C2] via-[#9575CD] to-[#B39DDB] shadow-xs">
            <div class="w-full h-full rounded-[14px] overflow-hidden bg-[#EDE7F6]">
              <img src="/images/characters/char_avatar_1.jpg" alt="Profile Avatar" class="w-full h-full object-cover" />
            </div>
          </div>
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 px-1.5 py-[1px] rounded-full bg-[#607D8B] text-white text-[7px] font-extrabold border border-white shadow-2xs whitespace-nowrap">
            ⚙ LV.3
          </span>
        </div>

        <div class="min-w-0 flex-1">
          <div class="font-extrabold text-[12px] text-[#332B25] leading-tight truncate">Labs Business Demo</div>
          <div class="text-[9px] text-[#8F857D] font-medium">@bisnis123</div>
          <div class="flex flex-wrap items-center gap-1 mt-1">
            <span class="px-1.5 py-[1px] rounded-full bg-[#FFF8E1] border border-[#FFB74D] text-[#D97706] text-[7px] font-extrabold">
              💼 BUSINESS CAFE
            </span>
            <span class="px-1.5 py-[1px] rounded-full bg-[#ECEFF1] text-[#455A64] text-[7px] font-bold">
              Extraction Craftsman
            </span>
          </div>
        </div>
      </div>

      <div class="border-t border-[#F2ECE4] pt-2 space-y-1">
        <!-- Level & Roadmap Link -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="px-1.5 py-[1px] rounded bg-[#607D8B] text-white text-[7px] font-extrabold">⚙ LEVEL 3</span>
            <span class="text-[9px] font-bold text-[#332B25]">Extraction Craftsman</span>
          </div>
          <span class="text-[8.5px] font-bold text-[#546E7A]">Roadmap ›</span>
        </div>

        <!-- EXP Bar -->
        <div class="w-full h-1.5 bg-[#ECEFF1] rounded-full overflow-hidden">
          <div class="h-full w-[65%] bg-[#546E7A] rounded-full"></div>
        </div>
        <div class="flex items-center justify-between text-[7.5px]">
          <span class="font-bold text-[#332B25]">825 EXP • 65% Selesai</span>
          <span class="text-[#8F857D]">175 EXP ke Lv.4</span>
        </div>
      </div>

      <!-- 4 Gamification Stat Boxes -->
      <div class="grid grid-cols-4 gap-1.5 pt-0.5">
        <div class="bg-[#FFF8F3] rounded-xl p-1.5 text-center">
          <div class="text-[10px] font-extrabold text-[#E65100] leading-tight">8</div>
          <div class="text-[7px] text-[#8F857D] font-medium">Seduhan</div>
        </div>
        <div class="bg-[#F3F8FF] rounded-xl p-1.5 text-center">
          <div class="text-[10px] font-extrabold text-[#0288D1] leading-tight">5</div>
          <div class="text-[7px] text-[#8F857D] font-medium">Toolkit</div>
        </div>
        <div class="bg-[#F3FBF5] rounded-xl p-1.5 text-center">
          <div class="text-[10px] font-extrabold text-[#2E7D32] leading-tight">5</div>
          <div class="text-[7px] text-[#8F857D] font-medium">Evaluasi</div>
        </div>
        <div class="bg-[#FFF4F2] rounded-xl p-1.5 text-center">
          <div class="text-[10px] font-extrabold text-[#D84315] leading-tight">6d</div>
          <div class="text-[7px] text-[#8F857D] font-medium">Streak</div>
        </div>
      </div>
    </div>

    <!-- 2. Coffee Labs Business License Card -->
    <div class="bg-[#FFFDF5] p-2.5 rounded-2xl border border-[#F3D178] shadow-2xs space-y-1">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-[#FFF3CD] flex items-center justify-center text-[#D97706] text-[10px]">
            💼
          </div>
          <div>
            <div class="font-extrabold text-[10px] text-[#332B25] leading-tight">Coffee Labs Business</div>
            <div class="text-[7.5px] text-[#8F857D]">Lisensi Aktif • Bebas Iklan & Seduh Unlimited</div>
          </div>
        </div>
        <span class="px-1.5 py-0.5 rounded-md bg-[#F59E0B] text-white text-[7px] font-extrabold">AKTIF</span>
      </div>
      <p class="text-[7.5px] text-[#6F655D] leading-snug">
        Akun bisnis kafe aktif: Akses 5 barista, katalog roastery, dan struk bluetooth tanpa batas.
      </p>
    </div>

    <!-- 3. Mode Business (POS Kasir & Display AOD) Launcher Card -->
    <div class="bg-[#1C1613] p-2.5 rounded-2xl border border-[#D4AF37]/40 text-white flex items-center justify-between gap-2 shadow-sm">
      <div class="flex items-center gap-2 min-w-0">
        <div class="w-8 h-8 rounded-full bg-[#2C221B] border border-[#D4AF37]/60 flex items-center justify-center shrink-0">
          <Icon name="store" size={13} color="#D4AF37" />
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1">
            <span class="font-extrabold text-[10px] text-white truncate">Mode Business</span>
            <span class="px-1 py-[0.5px] rounded bg-[#ECA400] text-[#1E1612] text-[6.5px] font-black">BUSINESS</span>
          </div>
          <div class="text-[7.5px] text-white/75 truncate">Dashboard, Kasir POS, Display AOD & Stock</div>
        </div>
      </div>
      <span class="text-[#ECA400] font-bold text-sm shrink-0">›</span>
    </div>

    <!-- 4. Menu List -->
    <div class="bg-white rounded-2xl border border-[#ECE2D6] divide-y divide-[#F2ECE4] overflow-hidden">
      <div class="p-2 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-6 h-6 rounded-lg bg-[#F5EFEA] flex items-center justify-center text-[#6B4423] shrink-0">
            <Icon name="gear" size={12} color="#6B4423" />
          </div>
          <div class="min-w-0">
            <div class="font-bold text-[9.5px] text-[#332B25]">Pengaturan</div>
            <div class="text-[7.5px] text-[#8F857D] truncate">Ubah nama barista, avatar & preferensi</div>
          </div>
        </div>
        <span class="text-[#8F857D] text-xs">›</span>
      </div>
      <div class="p-2 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-6 h-6 rounded-lg bg-[#FFF3E0] flex items-center justify-center text-[#E65100] shrink-0">
            <Icon name="book" size={12} color="#E65100" />
          </div>
          <div class="min-w-0">
            <div class="font-bold text-[9.5px] text-[#332B25]">Catatan Seduh</div>
            <div class="text-[7.5px] text-[#8F857D] truncate">Lihat riwayat seduhan dan rating kopi</div>
          </div>
        </div>
        <span class="text-[#8F857D] text-xs">›</span>
      </div>
    </div>

  </div>

  <!-- Custom Elevated Notched Bottom Navigation Bar -->
  <MobileBottomNav activeTab="profile" />

</div>
