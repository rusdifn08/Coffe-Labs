      { name: '3. Final Clarity Pour', time: '01:15 - 02:15', water: '+90g (Target: 225g)', desc: 'Tuang spiral melingkar sampai 225g.' },
    ]
  },
  {
    id: 'recipe-tetsu',
    author: 'Tetsu Kasuya',
    flag: '🇯🇵',
    title: 'Metode Multi-Pour Neo Brew (...',
    subtitle: "Tetsu Kasuya's 10th...",
    coffee: '20g',
    water: '300ml',
    temp: '90°C',
    ratio: '1:15',
    isIced: false,
    pours: '10x Pour',
    category: 'V60',
    grind: 'Super Coarse',
    grindDetail: 'Comandante: 28 klik • Timemore: 22 klik • Vesper: 85 klik',
    notes: ['Cherry', 'Black Tea', 'Clean Sweet'],
    avatar: '/images/avatars/portraits/tetsu_kasuya.jpg',
    dot1: { bg: 'bg-[#FCE7F3]', icon: 'heart', color: '#DB2777' },
    dot2: { bg: 'bg-[#E0F2FE]', icon: 'sparkles', color: '#0284C7' },
    steps: [
      { name: '1. 40% Rasa (Bloom 1)', time: '00:00 - 00:45', water: '+50g (Target: 50g)', desc: 'Menentukan balance acidity.' },
      { name: '2. 40% Rasa (Bloom 2)', time: '00:45 - 01:30', water: '+70g (Target: 120g)', desc: 'Menentukan level sweetness.' },
      { name: '3. 60% Strength (3x Pour)', time: '01:30 - 03:00', water: '+180g (Target: 300g)', desc: 'Dibagi 3 tuangan sama rata 60g.' },
    ]
  },
  {
    id: 'recipe-mikael-v60',
    author: 'Mikael Jasin',
    flag: '🇮🇩',
    title: 'V60 Signature Sensory Clarity ...',
    subtitle: '2024 World Barista...',
    coffee: '15g',
    water: '240ml',
    temp: '93°C',
    ratio: '1:16',
    isIced: false,
    pours: '3x Pour',
    category: 'V60',
    grind: 'Medium-Fine',
    grindDetail: 'Comandante: 20 klik • Timemore: 15 klik • Vesper: 58 klik',
    notes: ['Jasmine', 'Meyer Lemon', 'Tropical Fruit'],
    avatar: '/images/avatars/portraits/mikael_jasin.jpg',
    dot1: { bg: 'bg-[#FED7AA]', icon: 'disc', color: '#EA580C' },
    dot2: { bg: 'bg-[#FCE7F3]', icon: 'sparkles', color: '#EC4899' },
    steps: [
      { name: '1. Gentle Blooming', time: '00:00 - 00:40', water: '+45g (Target: 45g)', desc: 'Aliran air lembut 4g/detik.' },
      { name: '2. High Agitation Pulse', time: '00:40 - 01:25', water: '+95g (Target: 140g)', desc: 'Spiral agresif melarutkan asam buah.' },
      { name: '3. Melodrip Finish', time: '01:25 - 02:30', water: '+100g (Target: 240g)', desc: 'Ketinggian rendah menjaga body lembut.' },
    ]
  },
  {
    id: 'recipe-mikael-iced',
    author: 'Mikael Jasin',
