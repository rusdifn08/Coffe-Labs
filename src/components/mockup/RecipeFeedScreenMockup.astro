      { name: '1. Prep Server', time: 'Sebelum Mulai', water: '100g Es Batu di Server', desc: 'Siapkan es batu di bawah dripper.' },
      { name: '2. Hot Bloom Flash', time: '00:00 - 00:40', water: '+50g Air Panas (94°C)', desc: 'Ekstraksi panas ke atas es batu.' },
