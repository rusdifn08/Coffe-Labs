---
// Realistic Bluetooth Thermal Paper Receipt Mockup (ESC/POS 58mm style)
---

<div class="relative bg-white text-zinc-800 p-4 rounded-xl shadow-lg border border-zinc-200 font-mono text-[10px] max-w-[260px] mx-auto select-none">
  <!-- Zigzag paper tear top -->
  <div class="text-center border-b-2 border-dashed border-zinc-300 pb-2 mb-2">
    <div class="font-bold text-[12px] tracking-wider text-black">COFFEE LABS</div>
    <div class="text-[8.5px] text-zinc-500 uppercase tracking-widest">Slow Bar Extraction Log</div>
  </div>

  <div class="space-y-1 text-[9px] border-b border-dashed border-zinc-300 pb-2 mb-2">
    <div class="flex justify-between">
      <span class="text-zinc-500">TANGGAL:</span>
      <span class="font-semibold">23 OKT 2026</span>
    </div>
    <div class="flex justify-between">
      <span class="text-zinc-500">BARISTA:</span>
      <span class="font-semibold">Rusdi Barista</span>
    </div>
    <div class="flex justify-between">
      <span class="text-zinc-500">METODE:</span>
      <span class="font-semibold">Hario V60 02</span>
    </div>
    <div class="flex justify-between">
      <span class="text-zinc-500">GRINDER:</span>
      <span class="font-semibold">C40 (24 Klik)</span>
    </div>
  </div>

  <!-- Extraction summary -->
  <div class="bg-zinc-50 p-2 rounded border border-zinc-200 mb-2 space-y-0.5 text-[9px]">
    <div class="flex justify-between font-bold text-black">
      <span>DOSIS KOPI:</span>
      <span>20.0 g</span>
    </div>
    <div class="flex justify-between font-bold text-black">
      <span>TOTAL AIR:</span>
      <span>300.0 g</span>
    </div>
    <div class="flex justify-between text-zinc-600">
      <span>RASIO SEDUH:</span>
      <span>1:15.0</span>
    </div>
    <div class="flex justify-between text-zinc-600">
      <span>SUHU AIR:</span>
      <span>92.0 °C</span>
    </div>
    <div class="flex justify-between text-zinc-600">
      <span>TOTAL WAKTU:</span>
      <span>02:30 MIN</span>
    </div>
  </div>

  <!-- Pouring Steps -->
  <div class="text-[8.5px] border-b border-dashed border-zinc-300 pb-2 mb-2 space-y-0.5 text-zinc-600">
    <div class="font-bold text-black text-[9px] mb-0.5">TAHAPAN TUANGAN:</div>
    <div class="flex justify-between"><span>#1 Bloom (00:30)</span><span class="font-bold text-black">30g</span></div>
    <div class="flex justify-between"><span>#2 Tuang 2 (01:15)</span><span class="font-bold text-black">+60g (90g)</span></div>
    <div class="flex justify-between"><span>#3 Tuang 3 (01:45)</span><span class="font-bold text-black">+60g (150g)</span></div>
    <div class="flex justify-between"><span>#4 Tuang 4 (02:15)</span><span class="font-bold text-black">+60g (210g)</span></div>
    <div class="flex justify-between"><span>#5 Final (02:30)</span><span class="font-bold text-black">+90g (300g)</span></div>
  </div>

  <!-- Tasting Notes -->
  <div class="text-[8.5px] text-center mb-2">
    <div class="text-zinc-500 text-[8px]">PROFIL RASA (TASTING NOTES):</div>
    <div class="font-bold text-black text-[9px] tracking-tight">Peach • Bergamot • Honey • Clean Sweet</div>
  </div>

  <!-- Mock Barcode -->
  <div class="text-center pt-1 border-t border-dashed border-zinc-300">
    <div class="inline-block tracking-widest font-black text-xs text-zinc-800 scale-y-125">
      ||| | |||| | ||||| | ||| ||
    </div>
    <div class="text-[7.5px] text-zinc-400 mt-1 uppercase tracking-wider">
      MASTER YOUR BREW • COFFEE LABS
    </div>
  </div>
</div>
