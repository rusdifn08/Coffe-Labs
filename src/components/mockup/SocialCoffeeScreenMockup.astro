---
// Exact 1:1 Flutter UI replication for Social Coffee Screen (social_coffee_screen.dart)
import Icon from '../ui/Icon.astro';
import MobileBottomNav from './MobileBottomNav.astro';
---

<div class="flex-1 flex flex-col justify-between bg-[#F9F6F0] text-[#332B25] select-none text-xs h-full overflow-hidden">
  
  <div class="p-3 space-y-2 overflow-y-auto no-scrollbar flex-1">
    
    <!-- Top Bar (Matches SocialThreadsHeaderWidgets: Emblem + Title + Chat Bolt Icon + Menu) -->
    <div class="flex items-center justify-between pb-1 border-b border-[#EDE5DE]">
      <div class="flex items-center gap-1.5">
        <img src="/images/coffee_labs_emblem.png" alt="Coffee Labs" class="w-5 h-5 object-contain" />
        <div>
          <div class="font-extrabold text-[12px] text-[#332B25] leading-none">Social Coffee</div>
          <div class="text-[7.5px] font-semibold text-[#8F857D] mt-0.5">@coffeelabs.app</div>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <!-- Direct Chat Messenger Icon -->
        <div class="relative w-6 h-6 rounded-full bg-white border border-[#E8DFD8] flex items-center justify-center text-[#332B25]">
          <Icon name="message-square" size={11} color="#332B25" />
          <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#ECA400] border border-white"></span>
        </div>
        <!-- Basecamp / Club Pill -->
        <span class="px-2 py-0.5 rounded-full bg-[#FCE4EC] text-[#E91E63] font-bold text-[8px] flex items-center gap-1">
          <Icon name="users" size={9} color="#E91E63" />
          <span>Clubs</span>
        </span>
      </div>
    </div>

    <!-- Threads-Style Inline Composer Header (SocialThreadsComposerHeader) -->
    <div class="bg-white p-2 rounded-xl border border-[#ECE2D6] shadow-2xs flex items-center gap-2">
      <div class="w-7 h-7 rounded-full overflow-hidden border border-[#E8DFD8] shrink-0">
        <img src="/images/characters/char_avatar_1.jpg" alt="User" class="w-full h-full object-cover" />
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-[8.5px] font-bold text-[#332B25] leading-none">rusdi.barista</div>
        <div class="text-[8px] text-[#8F857D] truncate mt-0.5">Apa seduhan barumu? Bagikan resep...</div>
      </div>
      <span class="px-2 py-0.5 rounded-full bg-[#6B4423]/10 text-[#6B4423] text-[7.5px] font-extrabold shrink-0">
        + Posting
      </span>
    </div>

    <!-- Feed Filters (For You, Following, Recipes) -->
    <div class="flex gap-1 text-[8px] font-bold">
      <span class="px-2 py-0.5 rounded-full bg-[#6B4423] text-white">Untuk Anda</span>
      <span class="px-2 py-0.5 rounded-full bg-white border border-[#E8DFD8] text-[#6F655D]">Mengikuti</span>
      <span class="px-2 py-0.5 rounded-full bg-white border border-[#E8DFD8] text-[#6F655D]">Resep Kopi</span>
      <span class="px-2 py-0.5 rounded-full bg-white border border-[#E8DFD8] text-[#6F655D]">Basecamp</span>
    </div>

    <!-- Social Post Card 1: Bayu Prawiro -->
    <div class="bg-white p-2.5 rounded-xl border border-[#E8DFD8] shadow-xs space-y-2">
      <!-- Author info -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-amber-100 overflow-hidden border border-amber-200 shrink-0">
            <img src="/images/avatars/portraits/bayu_prawiro.jpg" alt="Bayu" class="w-full h-full object-cover" />
          </div>
          <div>
            <div class="font-bold text-[10.5px] text-[#332B25] leading-tight">Bayu Prawiro</div>
            <div class="text-[8px] text-[#8F857D]">Barista • 2 jam lalu</div>
          </div>
        </div>
        <span class="text-[9px] text-[#E91E63] font-bold">#Origami</span>
      </div>

      <!-- Post content -->
      <p class="text-[9.5px] text-[#332B25] leading-snug">
        Eksplorasi beans Puntang Natural dengan resep ini di Origami Air S. Rasa peach manis dan aroma floral-nya keluar maksimal!
      </p>

      <!-- Attached Recipe Card with Quick Copy -->
      <div class="p-2 bg-[#F9F6F0] rounded-lg border border-[#E8DFD8] flex items-center justify-between gap-1.5">
        <div class="min-w-0 pr-1">
          <div class="font-bold text-[9.5px] text-[#6B4423] truncate">Puntang Sweet Floral 4:6</div>
          <div class="text-[8px] text-[#8F857D]">Origami • 15g / 225g • 92°C</div>
        </div>
        <button class="px-2 py-1 bg-[#6B4423] text-white rounded-lg text-[8.5px] font-bold shrink-0 shadow-xs flex items-center gap-1 active:scale-95 transition-transform">
          <Icon name="copy" size={9} color="#FFFFFF" />
          <span>Copy Resep</span>
        </button>
      </div>

      <!-- Interaction stats -->
      <div class="flex items-center justify-between pt-1 border-t border-[#E8DFD8]/60 text-[8.5px] text-[#8F857D] font-medium">
        <span class="flex items-center gap-1">
          <Icon name="heart" size={10} color="#E11D48" />
          <span>48 Suka</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="message-square" size={10} color="#8F857D" />
          <span>12 Diskusi</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="coffee" size={10} color="#6B4423" />
          <span>19 Seduhan</span>
        </span>
      </div>
    </div>

    <!-- Social Post Card 2: Dody Samsura -->
    <div class="bg-white p-2.5 rounded-xl border border-[#E8DFD8] shadow-xs space-y-2">
      <!-- Author info -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-amber-100 overflow-hidden border border-amber-200 shrink-0">
            <img src="/images/avatars/portraits/dody_samsura.jpg" alt="Dody" class="w-full h-full object-cover" />
          </div>
          <div>
            <div class="font-bold text-[10.5px] text-[#332B25] leading-tight">Dody Samsura</div>
            <div class="text-[8px] text-[#8F857D]">Head Barista • 4 jam lalu</div>
          </div>
        </div>
        <span class="text-[9px] text-[#1D4ED8] font-bold">#HarioV60</span>
      </div>

      <!-- Post content -->
      <p class="text-[9.5px] text-[#332B25] leading-snug">
        Seduh Kamojang Anaerobic Slow Drip. Rasio 1:15, acidity strawberry winey dan aftertaste brown sugar linger panjang!
      </p>

      <!-- Attached Recipe Card with Quick Copy -->
      <div class="p-2 bg-[#F9F6F0] rounded-lg border border-[#E8DFD8] flex items-center justify-between gap-1.5">
        <div class="min-w-0 pr-1">
          <div class="font-bold text-[9.5px] text-[#6B4423] truncate">Wanoja Kamojang Drip</div>
          <div class="text-[8px] text-[#8F857D]">Hario V60 • 16g / 240g • 91°C</div>
        </div>
        <button class="px-2 py-1 bg-[#6B4423] text-white rounded-lg text-[8.5px] font-bold shrink-0 shadow-xs flex items-center gap-1 active:scale-95 transition-transform">
          <Icon name="copy" size={9} color="#FFFFFF" />
          <span>Copy Resep</span>
        </button>
      </div>

      <!-- Interaction stats -->
      <div class="flex items-center justify-between pt-1 border-t border-[#E8DFD8]/60 text-[8.5px] text-[#8F857D] font-medium">
        <span class="flex items-center gap-1">
          <Icon name="heart" size={10} color="#E11D48" />
          <span>64 Suka</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="message-square" size={10} color="#8F857D" />
          <span>19 Diskusi</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="coffee" size={10} color="#6B4423" />
          <span>31 Seduhan</span>
        </span>
      </div>
    </div>

    <!-- Social Post Card 3: Elysia Tan -->
    <div class="bg-white p-2.5 rounded-xl border border-[#E8DFD8] shadow-xs space-y-2">
      <!-- Author info -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-amber-100 overflow-hidden border border-amber-200 shrink-0">
            <img src="/images/avatars/portraits/elysia_tan.jpg" alt="Elysia" class="w-full h-full object-cover" />
          </div>
          <div>
            <div class="font-bold text-[10.5px] text-[#332B25] leading-tight">Elysia Tan</div>
            <div class="text-[8px] text-[#8F857D]">WBC Finalist • 6 jam lalu</div>
          </div>
        </div>
        <span class="text-[9px] text-[#059669] font-bold">#JapaneseIced</span>
      </div>

      <!-- Post content -->
      <p class="text-[9.5px] text-[#332B25] leading-snug">
        Siang terik paling pas Japanese Flash Brew pakai beans Yirgacheffe Washed. Floral melati dan aroma citrus menyegarkan!
      </p>

      <!-- Attached Recipe Card with Quick Copy -->
      <div class="p-2 bg-[#F9F6F0] rounded-lg border border-[#E8DFD8] flex items-center justify-between gap-1.5">
        <div class="min-w-0 pr-1">
          <div class="font-bold text-[9.5px] text-[#6B4423] truncate">Crisp Summer Flash Brew</div>
          <div class="text-[8px] text-[#8F857D]">Kalita 155 • 18g / 130g + 110g Es</div>
        </div>
        <button class="px-2 py-1 bg-[#6B4423] text-white rounded-lg text-[8.5px] font-bold shrink-0 shadow-xs flex items-center gap-1 active:scale-95 transition-transform">
          <Icon name="copy" size={9} color="#FFFFFF" />
          <span>Copy Resep</span>
        </button>
      </div>

      <!-- Interaction stats -->
      <div class="flex items-center justify-between pt-1 border-t border-[#E8DFD8]/60 text-[8.5px] text-[#8F857D] font-medium">
        <span class="flex items-center gap-1">
          <Icon name="heart" size={10} color="#E11D48" />
          <span>89 Suka</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="message-square" size={10} color="#8F857D" />
          <span>27 Diskusi</span>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="coffee" size={10} color="#6B4423" />
          <span>45 Seduhan</span>
        </span>
      </div>
    </div>

  </div>

  <!-- Custom Elevated Notched Bottom Navigation Bar -->
  <MobileBottomNav activeTab="toolkit" />

</div>
