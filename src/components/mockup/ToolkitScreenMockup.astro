---

<div class="toolkit-mockup-root flex-1 flex flex-col justify-between bg-[#F9F6F0] text-[#332B25] select-none text-xs h-full overflow-hidden">
  
  <div class="toolkit-mockup-scroll p-3 space-y-3 overflow-y-auto no-scrollbar flex-1 scroll-smooth">
    
    <!-- AppBar Title -->
    <div class="text-center font-extrabold text-[13px] text-[#332B25] pb-0.5">
      Barista Toolkit
    </div>

    <!-- Header Card (Exact match with toolkit_screen.dart Lines 347-413) -->
    <div class="px-3 py-2.5 rounded-2xl bg-gradient-to-br from-[#6B4423] to-[#563519] text-white shadow-sm flex items-center justify-between gap-2">
      <div>
        <span class="inline-block px-1.5 py-0.5 bg-[#D4AF37]/22 text-[#D4AF37] text-[7.5px] font-extrabold tracking-wider rounded">
          PROFESSIONAL PRO SUITE
        </span>
        <div class="font-extrabold text-[12.5px] mt-1 text-white leading-tight">
          Peralatan Presisi Barista
        </div>
      </div>
      <div class="w-8 h-8 rounded-full bg-white/12 flex items-center justify-center shrink-0">
        <Icon name="sparkles" size={14} color="#D4AF37" />
      </div>
    </div>

    <!-- 4 Categorized Toolkit Sections (21 Tools Total) -->
    {sections.map((sec) => (
      <div class="space-y-1.5 pt-0.5" data-mockup-section={sec.id}>
        <!-- ToolkitSectionHeader -->
        <div class="flex items-center gap-2">
          <div class={`w-6 h-6 rounded-[8px] border flex items-center justify-center shrink-0 ${sec.headerBoxClass}`}>
            <Icon name={sec.headerIcon} size={12} color="currentColor" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-extrabold text-[10.5px] text-[#332B25] leading-tight truncate">{sec.title}</div>
            <div class="text-[8px] text-[#8F857D] truncate">{sec.subtitle}</div>
          </div>
          <span class={`px-1.5 py-0.5 rounded-[6px] border text-[7px] font-extrabold tracking-wide shrink-0 ${sec.badgeClass}`}>
            {sec.badgeText}
          </span>
        </div>

        <!-- 2-Column Grid of ToolkitCards -->
        <div class="grid grid-cols-2 gap-1.5">
          {sec.items.map((item) => (
            <div class="bg-white p-2 rounded-[13px] border border-[#ECE2D6] shadow-2xs flex flex-col justify-between min-h-[74px] hover:border-[#6B4423]/40 transition-colors">
              <div class="flex items-center justify-between">
                <div class={`w-6 h-6 rounded-[7px] bg-gradient-to-br ${item.grad} flex items-center justify-center`}>
                  <Icon name={item.icon} size={12} color={item.color} />
                </div>
                <span class="text-[10px] text-[#8F857D]/60 font-bold leading-none">›</span>
              </div>
              <div class="mt-1.5">
                <div class="font-bold text-[9.5px] text-[#332B25] leading-tight truncate">{item.title}</div>
                <div class="text-[7.5px] text-[#8F857D] leading-tight mt-0.5 line-clamp-2">{item.subtitle}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

  </div>

  <!-- Custom Elevated Notched Bottom Navigation Bar -->
  <MobileBottomNav activeTab="toolkit" />

</div>
